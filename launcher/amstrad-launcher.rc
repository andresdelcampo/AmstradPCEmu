#include <winver.h>

1 ICON "../assets/front/pc1512-front.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Amstrad PC1512 launcher"
            VALUE "ProductName", "Amstrad PC1512"
            VALUE "FileVersion", "1.0"
            VALUE "OriginalFilename", "Amstrad PC1512.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
