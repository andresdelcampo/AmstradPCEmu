+            scaleFrame(QRegion(), true);
+            zoom_frame_queued = false;
+            /* A tick can arrive while this frame paints. Queue its successor
+               behind the worker's other events, including guest blits. */
+            const Layout latest = currentLayout();
+            if (cur_image != -1 && !latest.size.isEmpty() && latest.gen != w_layout_gen)
+                queueZoomFrame();
+        }, Qt::QueuedConnection);
+}
