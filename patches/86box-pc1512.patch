+// The drive itself, heading its panel: the bay as it is now, what is in it,
+// and the disk on the right with its tab. Clicking the card ejects.
+class DriveCard : public DiskButton {
+public:
+    static constexpr int Width = DiskTile::Width*DiskTile::Columns+6*(DiskTile::Columns-1), Height = 124, Disk = 104;
+    DriveCard(QPixmap closed,QPixmap open,QString title,QString name,QString note,std::function<void()> eject)
+        : DiskButton(std::move(closed),std::move(title),std::move(name),false,std::move(eject)), open(std::move(open)), note(std::move(note))
+    { setFixedHeight(Height); setMinimumWidth(Width); if (callback) setAccessibleName(text()+tr(": eject disk")); }
+    QSize sizeHint() const override { return QSize(std::max(int(Width),minimumWidth()),Height); }
+protected:
+    QRectF diskRect() const override { return QRectF(width()-Disk-14,(Height-Disk*895/924.0)/2,Disk,Disk*895/924.0); }
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this); p.setRenderHint(QPainter::Antialiasing); p.setRenderHint(QPainter::SmoothPixmapTransform);
+        const bool lit = callback && (underMouse() || hasFocus()) && !face.notchLit;
+        drawChoiceBox(p,QRectF(rect()).adjusted(1,1,-1,-1),false,lit,hasFocus());
+        // Under the pointer the bay shows what a click does: lever up, disk out.
+        const QPixmap &bay = lit && !open.isNull() ? open : picture;
+        const QRectF well(12,10,MenuCard::PictureBox,height()-20);
+        if (!bay.isNull()) {
+            QSizeF sz = QSizeF(bay.size())/bay.devicePixelRatio(); sz.scale(well.size(),Qt::KeepAspectRatio);
+            p.drawPixmap(QRectF(well.center()-QPointF(sz.width()/2,sz.height()/2),sz),bay,QRectF(bay.rect()));
+        }
+        paintDisk(p,diskRect(),face);
+        const int x = int(well.right())+18, tw = int(face.picture.isNull() ? width()-14 : diskRect().left())-x-12;
+        QFont f = font(); f.setBold(true); f.setPointSizeF(f.pointSizeF()*1.1); p.setFont(f);
+        const QFontMetrics bold(f), plain(font());
+        const QString state = tabChanged ? (face.tab ? tr("Write-protected") : tr("Writable")) : note;
+        const int th = bold.height()+4, lh = plain.lineSpacing()+2, pill = callback ? 24 : 0;
+        int y = (height()-(th+lh+(state.isEmpty() ? 0 : lh)+(pill ? pill+8 : 0)))/2;
+        drawPopupText(p,QRect(x,y,tw,th),Qt::AlignLeft|Qt::AlignVCenter,bold.elidedText(title,Qt::ElideRight,tw)); y += th;
+        p.setFont(font());
+        drawPopupText(p,QRect(x,y,tw,lh),Qt::AlignLeft|Qt::AlignVCenter,plain.elidedText(body,Qt::ElideMiddle,tw)); y += lh;
+        if (!state.isEmpty()) {
+            drawPopupText(p,QRect(x,y,tw,lh),Qt::AlignLeft|Qt::AlignVCenter,plain.elidedText(state,Qt::ElideRight,tw),PopupTheme::secondaryText());
+            y += lh;
+        }
+        if (!pill) return;
+        // Eject: the familiar triangle over a bar, in a pill that lights with the card.
+        const QString word = tr("Eject disk");
+        const QRectF button(x,y+8,plain.horizontalAdvance(word)+46,pill);
+        p.setPen(QPen(lit ? PopupTheme::text() : PopupTheme::border(),1)); p.setBrush(lit ? PopupTheme::hover() : QColor(255,255,255,14));
+        p.drawRoundedRect(button,pill/2.0,pill/2.0);
+        const QPointF g(button.left()+18,button.center().y());
+        for (const bool shadow : { true, false }) {
+            const QPointF o = shadow ? QPointF(1,1) : QPointF();
+            p.setPen(Qt::NoPen); p.setBrush(shadow ? PopupTheme::shadow() : PopupTheme::text());
+            p.drawPolygon(QPolygonF({ g+o+QPointF(-5,1), g+o+QPointF(5,1), g+o+QPointF(0,-5) }));
+            p.drawRect(QRectF(g.x()-5,g.y()+3,10,2).translated(o));
+        }
+        drawPopupText(p,button.adjusted(32,0,-10,0),Qt::AlignLeft|Qt::AlignVCenter,word);
+    }
+private:
+    QPixmap open;
+    QString note;
+};
