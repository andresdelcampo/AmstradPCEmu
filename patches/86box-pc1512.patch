+            }
+        }
+    };
+    auto *w=new Caption; w->title=title; w->subtitle=subtitle;
+    auto *a=new QWidgetAction(menu); a->setDefaultWidget(w); a->setEnabled(false); menu->addAction(a);
+}
+// A 5.25-inch disk drawn as UI, with a readable paper label at any DPI.
