+    if (image.isNull()) return {};
+    QPixmap p = QPixmap::fromImage(image.scaled(box * ratio, Qt::KeepAspectRatio, Qt::SmoothTransformation));
+    p.setDevicePixelRatio(ratio); return p;
+}
+
+class CabinetMenu : public QMenu {
+public:
+    explicit CabinetMenu(QWidget *parent) : QMenu(parent)
+    {
+        stylePopupMenu(this);
+        tracker.setInterval(50);
+        connect(&tracker, &QTimer::timeout, this, [this] {
+            const QPoint pos = QCursor::pos();
+            bool inside = geometry().adjusted(-16,-16,16,16).contains(pos) || bridge.contains(pos);
+            for (auto *popup = qobject_cast<QMenu *>(QApplication::activePopupWidget()); popup && popup != this;
+                 popup = qobject_cast<QMenu *>(popup->parentWidget()))
+                inside |= popup->isVisible() && popup->frameGeometry().adjusted(-16,-16,16,16).contains(pos);
+            if (inside) away.invalidate();
+            else if (!away.isValid()) away.start();
+            else if (away.elapsed() > 400) close();
+        });
+        connect(this, &QMenu::aboutToHide, &tracker, &QTimer::stop);
+    }
+    void openAt(const QPoint &anchor)
+    {
+        ensurePolished();
+        const QSize sz = sizeHint();
+        auto *screen = QGuiApplication::screenAt(anchor);
+        const QRect a = (screen ? screen : QGuiApplication::primaryScreen())->availableGeometry();
+        QPoint pt(anchor.x() - sz.width()/2, anchor.y() - sz.height() - 12);
+        if (pt.y() < a.top()) pt.setY(anchor.y() + 16);
+        pt.setX(std::clamp(pt.x(), a.left(), std::max(a.left(), a.right()-sz.width()+1)));
+        pt.setY(std::clamp(pt.y(), a.top(), std::max(a.top(), a.bottom()-sz.height()+1)));
+        // A corridor connects the opening hotspot to the panel, so moving into
+        // it never dismisses it. Keyboard navigation keeps it open as well.
+        bridge = QRect(anchor-QPoint(24,24), QSize(48,48)).united(QRect(pt,sz));
+        bridge = bridge.intersected(QRect(anchor.x()-24,bridge.top(),48,bridge.height()));
+        away.invalidate(); tracker.start(); exec(pt);
+    }
+    void keepOpenForKeyboard() { tracker.stop(); }
+protected:
+    void keyPressEvent(QKeyEvent *e) override { tracker.stop(); QMenu::keyPressEvent(e); }
+private:
+    QTimer tracker;
+    QElapsedTimer away;
+    QRect bridge;
+};
+
+class MenuCard : public QAbstractButton {
+public:
+    static constexpr int Width = 584, PictureBox = 244;
+    MenuCard(QPixmap picture, QString title, QString body, bool selected,
+             std::function<void()> callback, bool tile = false)
+        : picture(std::move(picture)), title(std::move(title)), body(std::move(body)),
+          selected(selected), callback(std::move(callback)), tile(tile)
+    {
+        setText(this->title); setAccessibleName(this->title);
+        setAccessibleDescription(this->body + (selected ? tr(". Currently selected") : QString()));
+        setToolTip(this->body);
+        setFocusPolicy(this->callback ? Qt::StrongFocus : Qt::NoFocus);
+        setCursor(this->callback ? Qt::PointingHandCursor : Qt::ArrowCursor);
+        connect(this, &QAbstractButton::clicked, this, [this] {
+            if (!this->callback) return;
+            const auto run = this->callback;
+            while (QWidget *popup = QApplication::activePopupWidget()) popup->close();
+            QTimer::singleShot(0, qApp, run);
+        });
+    }
+    QSize sizeHint() const override { return tile ? QSize(288,190) : QSize(Width,112); }
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this); p.setRenderHint(QPainter::Antialiasing); p.setRenderHint(QPainter::SmoothPixmapTransform);
+        const bool lit = callback && (underMouse() || hasFocus());
+        const QColor accent = PopupTheme::text(); p.setOpacity(isEnabled() ? 1 : .4);
+        p.setPen(QPen(selected || lit ? accent : PopupTheme::border(), selected || hasFocus() ? 2 : 1));
+        p.setBrush(lit ? PopupTheme::hover() : selected ? QColor(255,255,255,16) : QColor(Qt::transparent));
+        p.drawRoundedRect(QRectF(rect()).adjusted(3,3,-3,-3),10,10);
+        const QRect well = tile ? QRect(13,13,width()-26,103) : QRect(13,13,244,height()-26);
+        p.setPen(Qt::NoPen); p.setBrush(QColor("#24252b")); p.drawRoundedRect(well,6,6);
+        if (!picture.isNull()) {
+            QSizeF sz = QSizeF(picture.size())/picture.devicePixelRatio();
+            sz.scale(well.size()-QSize(10,10), Qt::KeepAspectRatio);
+            p.drawPixmap(QRectF(QPointF(well.center())-QPointF(sz.width()/2,sz.height()/2),sz),picture,picture.rect());
+        }
+        const int x = tile ? 16 : 274, y = tile ? 125 : 24, tw = width()-x-20;
+        QFont f = font(); f.setBold(true); f.setPointSizeF(f.pointSizeF()*1.1); p.setFont(f);
+        drawPopupText(p,QRect(x,y,tw-(selected?20:0),23), Qt::AlignLeft|Qt::AlignVCenter,
+                   QFontMetrics(f).elidedText(title,Qt::ElideRight,tw-(selected?20:0)));
+        f = font(); p.setFont(f);
+        drawPopupText(p,QRect(x,y+26,tw,tile?34:52),Qt::AlignLeft|Qt::AlignTop|Qt::TextWordWrap,
+                   QFontMetrics(f).elidedText(body,Qt::ElideMiddle,tw*(tile?2:3)),PopupTheme::secondaryText());
+        if (selected) {
+            p.setPen(QPen(accent,2.5)); const QPoint c(width()-25,y+11);
+            p.drawLine(c+QPoint(-5,0),c+QPoint(-1,4)); p.drawLine(c+QPoint(-1,4),c+QPoint(7,-5));
+        }
+    }
+    void enterEvent(QEvent *) override { update(); }
+    void leaveEvent(QEvent *) override { update(); }
+    void focusInEvent(QFocusEvent *) override { update(); }
+    void focusOutEvent(QFocusEvent *) override { update(); }
+    void keyPressEvent(QKeyEvent *e) override
+    {
+        for (QWidget *w=parentWidget(); w; w=w->parentWidget())
+            if (auto *m=dynamic_cast<CabinetMenu *>(w)) m->keepOpenForKeyboard();
+        if (e->key()==Qt::Key_Return || e->key()==Qt::Key_Enter) { click(); e->accept(); }
+        else if (auto *g = qobject_cast<QGridLayout *>(parentWidget()->layout()); g &&
+                 (e->key()==Qt::Key_Left || e->key()==Qt::Key_Right || e->key()==Qt::Key_Up || e->key()==Qt::Key_Down)) {
+            int r,c,rs,cs; g->getItemPosition(g->indexOf(this),&r,&c,&rs,&cs);
+            r += e->key()==Qt::Key_Down ? 1 : e->key()==Qt::Key_Up ? -1 : 0;
+            c += e->key()==Qt::Key_Right ? 1 : e->key()==Qt::Key_Left ? -1 : 0;
+            if (auto *item = g->itemAtPosition(r,c); item && item->widget()->isEnabled()) item->widget()->setFocus();
+            e->accept();
+        } else QAbstractButton::keyPressEvent(e);
+    }
+private:
+    QPixmap picture;
+    QString title,body;
+    bool selected;
+    std::function<void()> callback;
+    bool tile;
+};
+inline void addCard(QMenu *menu,const QPixmap &picture,const QString &title,const QString &text,
+                    bool checked=false,std::function<void()> handler={})
+{
+    auto *a=new QWidgetAction(menu); a->setDefaultWidget(new MenuCard(picture,title,text,checked,std::move(handler))); menu->addAction(a);
+}
+inline QGridLayout *addGrid(QMenu *menu)
+{
+    auto *w=new QWidget; auto *g=new QGridLayout(w); g->setContentsMargins(0,0,0,0); g->setSpacing(8);
+    auto *a=new QWidgetAction(menu); a->setDefaultWidget(w); menu->addAction(a); return g;
+}
+inline MenuCard *addTile(QGridLayout *g,const QPixmap &picture,const QString &title,const QString &text,
+                        bool checked,std::function<void()> handler)
+{
+    auto *card=new MenuCard(picture,title,text,checked,std::move(handler),true);
+    const int i=g->count(); g->addWidget(card,i/2,i%2); return card;
+}
+inline void addCaption(QMenu *menu,const QString &title,const QString &subtitle={})
+{
+    struct Caption : QWidget {
+        QString title,subtitle;
+        QSize sizeHint() const override { return QSize(MenuCard::Width,QFontMetrics(font()).height()*(subtitle.isEmpty()?1:2)+20); }
+        void paintEvent(QPaintEvent *) override {
+            QPainter p(this); QFont f=font(); f.setBold(true); p.setFont(f);
+            const int line=QFontMetrics(f).height();
+            drawPopupText(p,QRect(8,8,width()-16,line),Qt::AlignLeft|Qt::AlignVCenter,title);
+            if (!subtitle.isEmpty()) {
+                p.setFont(font());
