+void
+SoftwareRenderer::animateUnpoweredDisk(int drive, bool hadDisk, bool hasDisk)
+{
+    if (drive < 0 || drive >= 2 || power_led.load() || cabinet.isNull())
+        return;
+    unpowered_disk_started[drive] = QDateTime::currentMSecsSinceEpoch();
+    unpowered_disk_had[drive] = hadDisk;
+    unpowered_disk_has[drive] = hasDisk;
+    update();
+}
+
+void
+SoftwareRenderer::paintUnpowered(QPainter &painter)
+{
+    refreshFront(false);
+    const auto scene = amstrad::sceneLayout(size());
+    const Layout l = currentLayout();
+    unpowered_shown  = unpoweredState();
+    const QImage &art = l.art.isNull() ? cabinet : l.art;
+    painter.fillRect(rect(), amstrad::backgroundColor());
+    amstrad::paintCabinet(painter, art, scene);
+    amstrad::paintPanel(painter, art, leds_valid ? &leds : nullptr,
+                        drive_faces_valid ? &drive_faces : nullptr, fittings_valid ? &fittings : nullptr,
+                        l.front, scene, unpowered_shown);
