-static void
-pc_cas_read_bit(pc_cassette_t *cas)
-{
-    int val;
-
-    if (cas->cas_inp_cnt == 0) {
-        if (cas->fp == NULL) {
-            return;
-        }
-
-        if (feof(cas->fp)) {
-            return;
-        }
-
-        val = fgetc(cas->fp);
-
-        if (val == EOF) {
-            cassette_log("cassette EOF at %lu\n", cas->position);
-            return;
-        }
-
-        cas->position += 1;
-
-        cas->cas_inp_cnt = 8;
-        cas->cas_inp_buf = val;
-    }
-
-    cas->cas_inp_bit = ((cas->cas_inp_buf & 0x80) != 0);
-
-    cas->cas_inp_buf = (cas->cas_inp_buf << 1) & 0xff;
-    cas->cas_inp_cnt -= 1;
-}
-
-static int
-pc_cas_read_smp(pc_cassette_t *cas)
-{
-    int  smp;
-    int *fir;
-
-    if (feof(cas->fp)) {
-        return 0;
-    }
-
-    smp = fgetc(cas->fp);
-
-    if (smp == EOF) {
-        cassette_log("cassette EOF at %lu\n", cas->position);
-        return 0;
-    }
-
-    cas->position += 1;
-
-    fir = cas->pcm_inp_fir;
-
-    fir[0] = fir[1];
-    fir[1] = fir[2];
-    fir[2] = (smp & 0x80) ? (smp - 256) : smp;
-
-    smp = (fir[0] + 2 * fir[1] + fir[2]) / 4;
-
-    return smp;
-}
