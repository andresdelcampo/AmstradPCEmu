+unsigned
+SoftwareRenderer::ledState()
+{
+    /* A PC drive's LED is lit while its motor runs. The guest BIOS keeps the
+       motor on after the last access for its motor-off delay (INT 1Eh table,
+       normally 37 ticks, ~2 s), so read the emulated motor rather than timing
+       it here. 86Box's per-command activity flag is ORed in, held briefly, in
+       case a command runs without the motor. */
+    /* Bays show logical drives: DD has A: left and B: right; SD and HD20 have
+       their single floppy, A:, on the right. The left bay of a hard disk model
+       has its own LED, lit while the MFM controller is busy (held, as its
+       activity flag only pulses per command). */
+    constexpr qint64 hold_ms = 120;
+    const qint64     now     = QDateTime::currentMSecsSinceEpoch();
+    const bool       dd      = w_front.left == amstrad::BayFloppy;
+    const int        right   = w_front.rightDrive();
+    unsigned         lit     = 0;
+    for (int i = 0; i < 2; ++i) {
+        if (drives[i].motoron || machine_status.fdd[i].active || machine_status.fdd[i].write_active)
+            led_last_active[i] = now;
+        if (now - led_last_active[i] < hold_ms)
+            lit |= 1u << i;
+    }
+    unsigned state = 0;
+    if (leds_valid) {
+        state |= power_led.load() ? 1u << amstrad::PowerLed : 0;
+        state |= (dd && (lit & 1)) ? 1u << amstrad::DriveALed : 0;
+        state |= ((lit >> right) & 1) ? 1u << amstrad::DriveBLed : 0;
+    }
+    if (fittings_valid && w_front.left == amstrad::BayHdd) {
+        if (machine_status.hdd[HDD_BUS_MFM].active || machine_status.hdd[HDD_BUS_MFM].write_active)
+            hdd_last_active = now;
+        if (now - hdd_last_active < hold_ms)
+            state |= 1u << amstrad::HddLed;
+    }
+    if (!drive_faces_valid)
+        return state;
+    /* Drive faces follow 86Box's inserted-media state: open and empty, or
+       closed on a disk coloured after its image name. The name is re-read only
+       when it changes; the GUI thread may be writing it, and a torn read only
+       costs one frame of a wrong colour before the next compare. */
+    auto faceOf = [this](int i) {
+        /* Early in the eject sound the latch has not moved yet: keep showing
+           the disk that was in (still cached here), even across a swap. */
+        if (drive_path[i][0] && fdd_audio_media_ejecting(i))
+            return drive_colour[i];
+        /* The status flag is only initialised at startup; a drive fitted
+           later (DD from SD/HD20) starts with no image but a stale flag. */
+        if (machine_status.fdd[i].empty || !drives[i].image_path[0])
+            return amstrad::DriveOpen;
+        /* While the insert sound plays the disk is still going in: keep the
+           latch open and close it on the disk two thirds into the sound. */
+        if (fdd_audio_media_inserting(i))
+            return amstrad::DriveOpen;
+        if (std::strncmp(drive_path[i], drives[i].image_path, sizeof(drive_path[i])) != 0) {
+            std::strncpy(drive_path[i], drives[i].image_path, sizeof(drive_path[i]) - 1);
+            drive_path[i][sizeof(drive_path[i]) - 1] = '\0';
+            drive_colour[i] = amstrad::diskColour(QString::fromUtf8(drive_path[i]), machineFront().left == amstrad::BayHdd);
+        }
+        return drive_colour[i];
+    };
+    return amstrad::panelState(state, dd ? faceOf(0) : amstrad::DriveOpen, faceOf(right));
+}
