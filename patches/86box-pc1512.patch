+
+/* GUI thread: the front-panel state of a switched-off machine. The media
+   action starts this visual sequence directly; audio playback is on another
+   thread and may start late or stop while the machine is paused. */
+unsigned
+SoftwareRenderer::unpoweredState()
+{
+    auto face = [this](int i) {
+        amstrad::DriveFace &shown = unpowered_face[i];
+        const qint64 elapsed = QDateTime::currentMSecsSinceEpoch() - unpowered_disk_started[i];
+        if (unpowered_disk_started[i] && elapsed >= 0) {
+            // The recordings are 1.60 s (eject) and 2.09 s (insert). The
+            // latch opens one quarter into eject and closes two thirds into
+            // insert, matching the powered-on front.
+            if (unpowered_disk_had[i] && elapsed < 400)
+                return shown;
+            const qint64 closeAt = (unpowered_disk_had[i] ? 1600 : 0) + 1390;
+            if (unpowered_disk_has[i] && elapsed < closeAt)
+                return shown = amstrad::DriveOpen;
+        }
+        if (!drives[i].image_path[0])
+            shown = amstrad::DriveOpen;
+        else
+            shown = amstrad::diskColour(QString::fromUtf8(drives[i].image_path), machineFront().left == amstrad::BayHdd);
+        return shown;
+    };
+    /* As machineFront(): with a drive B: fitted it is the right bay, else A: is. */
+    return amstrad::panelState(0, face(0), face(fdd_get_type(&drives[1]) != 0 ? 1 : 0));
+}
