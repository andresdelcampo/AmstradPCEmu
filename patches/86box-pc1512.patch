+class PopupMenuData : public QObject {
+public:
+    explicit PopupMenuData(QMenu *menu) : QObject(menu) { setObjectName("amstradPopupSurface"); }
+    PopupBackdrop backdrop;
+    bool capturing = false;
+};
+
+inline PopupMenuData *popupData(QMenu *menu)
+{
+    auto *data = dynamic_cast<PopupMenuData *>(menu->findChild<QObject *>("amstradPopupSurface",Qt::FindDirectChildrenOnly));
+    return data ? data : new PopupMenuData(menu);
+}
