+// One disk in the box. Sleeved system discs carry a caption; black disks say
+// what they are on their own label.
+class DiskTile : public DiskButton {
+public:
+    static constexpr int Width = 160, Disk = 142, Columns = 4;
+    DiskTile(const QImage &art,QString label,QString caption,QString tip,std::function<void()> insert,qreal ratio,bool action = false)
+        : DiskButton({},caption.isEmpty() ? label : caption,std::move(tip),false,std::move(insert),true), caption(std::move(caption))
+    {
+        face.picture = DiskFace::scaled(art,Disk,ratio); face.label = std::move(label); face.action = action;
+        setFixedSize(sizeHint());
+    }
+    // Shown pale: not in the box (in a drive, or its image is yet to be found).
+    void setFaded(bool on) { faded = on; update(); }
+    QSize sizeHint() const override { return QSize(Width,qRound(Disk*895/924.0)+(caption.isEmpty() ? 14 : 36)); }
+protected:
+    QRectF diskRect() const override { return QRectF((Width-Disk)/2.0,7,Disk,Disk*895/924.0); }
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this); p.setRenderHint(QPainter::Antialiasing); p.setRenderHint(QPainter::SmoothPixmapTransform);
+        const bool lit = callback && isEnabled() && (underMouse() || hasFocus());
+        drawChoiceBox(p,QRectF(rect()).adjusted(1,1,-1,-1),false,lit,hasFocus());
+        p.setOpacity(faded || !isEnabled() ? .35 : 1);
+        paintDisk(p,diskRect(),face);
+        p.setOpacity(isEnabled() ? 1 : .6);
+        if (!caption.isEmpty())
+            drawPopupText(p,QRectF(4,diskRect().bottom()+3,width()-8,24),Qt::AlignCenter,
+                          QFontMetrics(font()).elidedText(caption,Qt::ElideRight,width()-10));
+    }
+private:
+    QString caption;
+    bool faded = false;
+};
