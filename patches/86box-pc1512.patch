+void
+MainWindow::setAmstradMonochrome(bool mono)
+{
+    /* The PC-MM shows the same video as shades on a paper-white tube:
+       86Box's white monitor conversion, applied like the Display setting. */
+    if ((video_grayscale != 0) == mono)
+        return;
+    startblit();
+    video_grayscale = mono ? 4 : 0;
+    video_copy      = (video_grayscale || invert_display) ? video_transform_copy : memcpy;
+    endblit();
+    config_save();
+    device_force_redraw();
+    refreshAmstradFront();
+}
+
+void
+MainWindow::setAmstradLeftBay(int bayIndex)
+{
+    const auto bay   = static_cast<amstrad::LeftBay>(bayIndex);
+    const auto front = SoftwareRenderer::machineFront();
+    auto blank = [](amstrad::LeftBay b) { return b == amstrad::BayBlank || b == amstrad::BayBlankSticker; };
+    if (blank(bay))
+        SoftwareRenderer::setBlankSticker(bay == amstrad::BayBlankSticker);
+    if (bay == front.left)
+        return;
+    /* A sticker is only artwork: no hardware change. */
+    if (blank(bay) && blank(front.left)) {
+        refreshAmstradFront();
+        return;
+    }
+
+    QString hd20Image;
+    int     hdcId = 0;
+    if (bay == amstrad::BayHdd) {
+        hdcId = hdc_get_from_internal_name(hd20_controller);
+        if (hdcId <= 0 || !hdc_available(hdcId)) {
+            QMessageBox::warning(this, tr("Hard disk"),
+                tr("The Western Digital WD1002A-WX1 controller ROM is missing.\n"
+                   "Place wd1002a_wx1-62-000094-032.bin under roms/hdd/st506 and try again."));
+            return;
+        }
+        hd20Image = QSettings(amstradSettingsFile(), QSettings::IniFormat)
+                        .value("front/hdd_image", QDir(QString::fromUtf8(usr_path)).filePath("hd20.img"))
+                        .toString();
+    }
+
+    static const char *const fitted[amstrad::LeftBayCount] = {
+        QT_TR_NOOP("a second floppy drive"), QT_TR_NOOP("a blank plate"),
+        QT_TR_NOOP("a blank plate"), QT_TR_NOOP("a 20 MB hard disk")
+    };
+    QString question = tr("Fitting %1 in the left bay restarts the PC. Unsaved work in it is lost.").arg(tr(fitted[bay]));
+    if (front.left == amstrad::BayFloppy && drives[1].image_path[0])
+        question += tr("\nThe disk in drive B: is ejected; drive A: moves to the right bay.");
+    else if (front.left == amstrad::BayFloppy)
+        question += tr("\nDrive A: moves to the right bay.");
+    if (bay == amstrad::BayHdd && !QFileInfo::exists(hd20Image))
+        question += tr("\nA new, empty 20 MB disk is created: partition it with FDISK and FORMAT it from DOS.");
+    if (QMessageBox::question(this, tr("Change drive bay"), question + tr("\n\nContinue?")) != QMessageBox::Yes)
+        return;
+
+    if (bay == amstrad::BayHdd && !QFileInfo::exists(hd20Image)) {
+        QFile image(hd20Image);
+        if (!image.open(QIODevice::WriteOnly | QIODevice::NewOnly) ||
+            !image.resize(qint64(hd20_tracks) * hd20_heads * hd20_sectors * 512)) {
+            QMessageBox::warning(this, tr("Hard disk"), tr("Cannot create %1: %2").arg(hd20Image, image.errorString()));
+            return;
+        }
+    }
+
+    if (front.left == amstrad::BayFloppy && drives[1].image_path[0])
+        mm->floppyEject(1);
+
+    runctl_pause_wait(RUN_PAUSE_SYNC);
+    /* The second floppy exists only in the DD; its sound profile is kept. */
+    fdd_set_type(&drives[1], bay == amstrad::BayFloppy ? fdd_get_from_internal_name(const_cast<char *>("525_2dd")) : 0);
+    if (front.left == amstrad::BayHdd) {
+        /* Remember the disk for a later HD20, then remove it and its controller. */
+        for (int i = 0; i < HDD_NUM; ++i)
+            if (hdd_is_valid(i) && hdd[i].bus_type == HDD_BUS_MFM) {
+                QSettings(amstradSettingsFile(), QSettings::IniFormat).setValue("front/hdd_image", QString::fromUtf8(hdd[i].fn));
+                memset(&hdd[i], 0, sizeof(hdd[i]));
+            }
+        for (int c = 0; c < HDC_MAX; ++c) {
+            const device_t *dev = hdc_get_device(hdc_current[c]);
+            if (dev && dev->internal_name && QByteArray(dev->internal_name).startsWith("st506_xt"))
+                hdc_current[c] = 0;
+        }
+    }
+    if (bay == amstrad::BayHdd) {
+        int slot = 0;
+        while (slot < HDD_NUM - 1 && hdd_is_valid(slot))
+            ++slot;
+        memset(&hdd[slot], 0, sizeof(hdd[slot]));
+        hdd[slot].bus_type     = HDD_BUS_MFM;
+        hdd[slot].mfm_channel  = 0;
+        hdd[slot].tracks       = hd20_tracks;
+        hdd[slot].hpc          = hd20_heads;
+        hdd[slot].spt          = hd20_sectors;
+        hdd[slot].speed_preset = hdd_preset_get_from_internal_name(const_cast<char *>("mfm_3600rpm"));
+        hdd[slot].audio_profile = hdd_audio_get_profile_by_internal_name(hd20_audio);
+        strncpy(hdd[slot].fn, hd20Image.toUtf8().constData(), sizeof(hdd[slot].fn) - 1);
+        hdc_current[0] = hdcId;
+    }
+    config_changed = 2;
+    pc_reset_hard();
+    config_save();
+    device_force_redraw();
+    runctl_resume(RUN_PAUSE_SYNC);
+    refreshMediaMenu();
+    refreshAmstradFront();
+}
