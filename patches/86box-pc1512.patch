+amstrad::Front
+SoftwareRenderer::machineFront()
+{
+    amstrad::Front front;
+    front.mono = video_grayscale != 0;
+    if (fdd_get_type(&drives[1]) != 0) {
+        front.left = amstrad::BayFloppy;
+        return front;
+    }
+    for (int i = 0; i < HDD_NUM; ++i)
+        if (hdd_is_valid(i) && hdd[i].bus_type == HDD_BUS_MFM) {
+            front.left = amstrad::BayHdd;
+            return front;
+        }
+    front.left = blankSticker() ? amstrad::BayBlankSticker : amstrad::BayBlank;
+    return front;
+}
+
+void
+SoftwareRenderer::refreshFront(bool repaint)
+{
+    if (cabinet.isNull())
+        return;
+    const amstrad::Front front = machineFront();
+    if (front_published && front == front_applied)
+        return;
+    front_applied   = front;
+    front_published = true;
+    const QImage art = fittings_valid ? amstrad::composeCabinet(cabinet, fittings, front) : QImage();
+    {
+        std::scoped_lock lk(layout_mutex);
+        layout.art   = art;
+        layout.front = front;
+        layout.gen++; /* a new layout generation repaints the whole cabinet */
+    }
+    if (repaint && worker.context())
+        QMetaObject::invokeMethod(worker.context(), [this] { scaleFrame(QRegion(), true); }, Qt::QueuedConnection);
+}
+
+QImage
+SoftwareRenderer::frontPreview(const amstrad::Front &front, const QRectF &master, int leftFace, int rightFace) const
+{
+    if (cabinet.isNull())
+        return {};
+    QImage art = fittings_valid ? amstrad::composeCabinet(cabinet, fittings, front) : cabinet.copy();
+    if (drive_faces_valid) {
+        QPainter p(&art);
+        p.setRenderHint(QPainter::SmoothPixmapTransform, true);
+        const auto l = amstrad::layout(art.size());
+        if (front.left == amstrad::BayFloppy && leftFace >= 0 && leftFace < amstrad::DriveFaceCount)
+            p.drawImage(amstrad::driveRect(l, 0), drive_faces.face[0][leftFace]);
+        if (rightFace >= 0 && rightFace < amstrad::DriveFaceCount)
+            p.drawImage(amstrad::driveRect(l, 1), drive_faces.face[1][rightFace]);
+    }
+    const qreal sx = art.width() / 1254.0, sy = art.height() / 1254.0;
+    const QRect crop = QRectF(master.x() * sx, master.y() * sy, master.width() * sx, master.height() * sy)
+                           .toAlignedRect()
+                           .intersected(art.rect());
+    return art.copy(crop);
+}
