+// Rear monitor power-button close-up. GPL-2.0-or-later, like 86Box.
+#ifndef QT_AMSTRADPOWER_HPP
+#define QT_AMSTRADPOWER_HPP
+
+#include "qt_amstradscene.hpp"
+#include "qt_amstradpopup.hpp"
+#include <QWidget>
+#include <QMouseEvent>
+#include <QKeyEvent>
+#include <QTimer>
+#include <QVariantAnimation>
+#include <QMenu>
+#include <QToolButton>
+#include <QContextMenuEvent>
+#include <QSettings>
+#include <QFontMetricsF>
+#include <QLineF>
+#include <QDir>
+#include <functional>
+
+namespace amstrad {
+// Warm annotation ink, distinct from the photographed hardware.
+inline QColor calloutInk() { return QColor(240, 234, 222); }
+inline QColor calloutEdge() { return QColor(185, 179, 167, 105); }
+inline QPen calloutDash(qreal width)
+{
+    // The line lies entirely on charcoal; a little more opacity gives it the
+    // same apparent strength as the outline beside pale plastic.
+    QPen pen(QColor(185, 179, 167, 160), width, Qt::CustomDashLine, Qt::FlatCap, Qt::RoundJoin);
+    pen.setDashPattern({ 5, 4 });
+    return pen;
+}
+}
+
+// Dashed leader lines from the close-up's edges back to the spot on the
+// monitor's rear edge where the button sits. Never takes mouse input.
+class AmstradPowerLeads : public QWidget {
+public:
+    explicit AmstradPowerLeads(QWidget *parent) : QWidget(parent)
+    {
+        setAttribute(Qt::WA_TranslucentBackground);
+        setAttribute(Qt::WA_TransparentForMouseEvents);
+        setFocusPolicy(Qt::NoFocus);
+        hide();
+    }
+    // Parent coordinates. When the close-up overlaps the spot, nothing is drawn.
+    void span(const QPointF &rearTop, const QPointF &rearBottom,
+              const QPointF &top, const QPointF &bottom, qreal scale)
+    {
+        s = scale;
+        drawn = top.x() - rearTop.x() > 14 * s;
+        topLine = QPainterPath(rearTop);
+        topLine.lineTo(top);
+        bottomLine = QPainterPath(rearBottom);
+        bottomLine.lineTo(bottom);
+        const QRectF box = topLine.boundingRect().united(bottomLine.boundingRect())
+                               .adjusted(-8 * s, -8 * s, 8 * s, 8 * s);
+        const QRect g = box.toAlignedRect();
+        topLine.translate(-g.topLeft()); bottomLine.translate(-g.topLeft());
+        setGeometry(g);
+        update();
+    }
+    qreal opacity = 1;
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        if (!drawn) return;
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing);
+        p.setOpacity(opacity);
+        for (const QPainterPath &line : { topLine, bottomLine }) {
+            QPen dash = amstrad::calloutDash(1.0 * s);
+            // Finish in the middle of a dash, so the edge never looks detached.
+            dash.setDashOffset(2.5 - line.length() / dash.widthF());
+            p.setPen(dash);
+            p.drawPath(line);
+        }
+    }
+
+private:
+    QPainterPath topLine, bottomLine;
+    qreal s = 1;
+    bool drawn = false;
+};
+
+class AmstradPowerPeek : public QWidget {
+public:
+    explicit AmstradPowerPeek(QWidget *parent, const QString &path, const QString &settingsPath)
+        : QWidget(parent), atlas(path), bayAtlas(QFileInfo(path).dir().filePath("rear-bay-atlas.png")), settingsFile(settingsPath)
+    {
+        for (int frame = 0; frame < 2; ++frame) {
+            if (!atlas.isNull()) {
+                const int side = atlas.width() / 2;
+                closePhoto[frame] = softenedPhoto(atlas.copy(frame * side, 0, side,
+                    qRound(atlas.height() * 204.0 / PhotoW)), 31, 10);
+            }
+            if (!bayAtlas.isNull()) {
+                const int half = bayAtlas.height() / 2;
+                bayPhoto[frame] = softenedPhoto(bayAtlas.copy(0, frame * half,
+                    bayAtlas.width(), half), 7, 8);
+            }
+        }
+        cableView = QSettings(settingsFile, QSettings::IniFormat).value("power/view", "close").toString() == "bay";
+        setObjectName("amstradRearPower");
+        setAttribute(Qt::WA_TranslucentBackground);
+        setMouseTracking(true);
+        setFocusPolicy(Qt::StrongFocus);
+        setAccessibleName(tr("Rear monitor power button"));
+        setAccessibleDescription(tr("Round pushbutton. Press to switch the PC on or off."));
+        setToolTip(tr("Right-click to compare the button close-up and rear cable bay."));
+        viewButton = new QToolButton(this);
+        viewButton->setText(QString::fromUtf8("\u22ef"));
+        viewButton->setToolTip(tr("Change power view"));
+        viewButton->setAccessibleName(tr("Change power view"));
+        viewButton->setCursor(Qt::PointingHandCursor);
+        viewButton->setFocusPolicy(Qt::NoFocus);
+        viewButton->setStyleSheet("QToolButton { color: rgba(240,234,222,125); background: transparent; border: none; border-radius: 5px; font: bold 18px 'Segoe UI'; padding: 0; } QToolButton:hover { color: rgba(240,234,222,210); background: rgba(240,234,222,25); }");
+        viewButton->hide();
+        connect(viewButton, &QToolButton::clicked, this, [this] {
+            showViewMenu(viewButton->mapToGlobal(QPoint(0, viewButton->height())));
+        });
+        leads = new AmstradPowerLeads(parent);
+        hideTimer.setSingleShot(true);
+        backdropTimer.setSingleShot(true);
+        connect(&backdropTimer, &QTimer::timeout, this, [this] {
+            if (!isVisible()) return;
+            backdrop.capture(parentWidget(),mapToGlobal(QPoint()),size(),false);
+            update();
+        });
+        connect(&hideTimer, &QTimer::timeout, this, [this] { if (powered) hide(); });
+        animation.setDuration(160);
+        connect(&animation, &QVariantAnimation::valueChanged, this, [this](const QVariant &v) {
+            opacity = v.toReal(); leads->opacity = opacity; leads->update(); update();
+        });
+        hide();
+    }
+
+    std::function<void()> toggle;
+    bool powered = true;
+
+    // Its on-screen footprint remains a reveal target while hidden. Keep this
+    // outside the monitor, clear of the colour/monochrome badge's menu target.
+    QRectF revealArea() const { return QRectF(geometry()); }
+    // The part of it that brings the hidden close-up out under the pointer.
+    // In the monitor close-up it may have to lie over the monitor for want
+    // of room beside it: the glass then stays the guest's.
+    QRectF hoverArea() const
+    {
+        QRectF area = revealArea();
+        if (amstrad::viewZoom().load() > 0) {
+            const auto l = amstrad::sceneLayout(parentWidget()->size());
+            area.setLeft(std::max(area.left(), l.aperture.right() + 8 * l.scale));
+        }
+        return area;
+    }
+
+    // Where the button sits, seen from the front: low on the monitor's right edge.
+    QPointF spot() const
+    {
+        const auto l = amstrad::sceneLayout(parentWidget()->size());
+        return QPointF(l.cabinet.left() + 1117 * l.scale, l.cabinet.top() + 735 * l.scale);
+    }
+
+    // Beside the cabinet, clear of the monitor, wherever the window leaves room.
+    void place()
+    {
+        const auto l = amstrad::sceneLayout(parentWidget()->size());
+        const qreal s = l.scale;
+        const int leftLimit = qCeil(spot().x() + 24 * s);
+        const qreal available = parentWidget()->width() - leftLimit - 8 * s;
+        const qreal factor = cableView ? std::clamp((available / s - 12) / PhotoW, qreal(1), qreal(2)) : 1;
+        const QSize sz(qRound((PhotoW * factor + 12) * s), qRound((photoHeight() * factor + 50) * s));
+        const int x = qRound(l.cabinet.left() + 1190 * s);
+        // Preserve the picture's position while giving its caption more air.
+        const int y = qRound(l.cabinet.top() + 650 * s) - qRound((photoHeight() * factor + 44) * s) / 2;
+        const int fitRight   = parentWidget()->width() - sz.width() - qRound(8 * s);
+        const int rightLimit = std::max(leftLimit, fitRight);
+        // The monitor close-up can leave no room beside the monitor. Rather
+        // than hang off the window, the switch then lies over the housing.
+        const bool over = amstrad::viewZoom().load() > 0 && fitRight < leftLimit;
+        setGeometry(over ? std::max(0, fitRight) : std::clamp(x, leftLimit, rightLimit),
+                    std::clamp(y, 0, std::max(0, parentWidget()->height() - sz.height())), sz.width(), sz.height());
+        const int menuSize = std::max(20, qRound(26*s));
+        viewButton->setGeometry(qRound((PhotoX + PhotoW*factor)*s) - menuSize - qRound(8*s),
+                                qRound((photoHeight()*factor + 33)*s) - menuSize/2, menuSize, menuSize);
+        const QRectF frame(pos().x() + s, pos().y() + s,
+                           (PhotoW * factor + 10)*s, (photoHeight() * factor + 10)*s);
+        // A straight upper leader meets the rounded corner where it remains
+        // visible, instead of disappearing behind the opaque photograph.
+        const QPointF upper = frame.topLeft() + QPointF(.0603073792, .6579798567) * (frameRadius()*s);
+        // Mark the approximate rear casing section being enlarged: two
+        // endpoints 64 master pixels apart, following the monitor's edge.
+        const QPointF lower = frame.bottomLeft() + QPointF(frameRadius()*s, 0);
+        leads->span(rearTop(), rearBottom(), upper, lower, s);
+        // Keep the pointer's route between the actual leaders usable, without
+        // retaining a large invisible rectangle above/left of that route.
+        QPainterPath passage(rearTop());
+        passage.lineTo(upper); passage.lineTo(lower); passage.lineTo(rearBottom());
+        passage.closeSubpath();
+        QPainterPathStroker tolerance;
+        tolerance.setWidth(12*s);
+        travelArea = passage.united(tolerance.createStroke(passage));
+        if (!backdrop.matches(mapToGlobal(QPoint()),size(),parentWidget()->size()) && !backdropTimer.isActive())
+            backdropTimer.start(0);
+    }
+
+    void reveal()
+    {
+        hideTimer.stop();
+        place();
+        if (isHidden()) {
+            opacity = 0;
+            leads->opacity = 0;
+            show(); raise();
+            animation.stop(); animation.setStartValue(0.0); animation.setEndValue(1.0); animation.start();
+        }
+    }
+
+    void track(const QPoint &point, bool captured)
+    {
+        if (!powered) { reveal(); return; }
+        if (captured) { hide(); return; }
+        if (hoverArea().contains(point) || (isVisible() && (travelArea.contains(point) || revealArea().contains(point))))
+            reveal();
+        else
+            dismissLater();
+    }
+
+    void dismissLater() { if (powered && !menuOpen && !hideTimer.isActive()) hideTimer.start(500); }
+    void changed(bool on) {
+        powered = on;
+        switchPending = false;
+        pressed = false;
+        update();
+        // Retain the last neutral frost until its replacement is captured;
+        // invalidating here briefly exposed PopupBackdrop's blue fallback.
+        if (isVisible() && !backdropTimer.isActive()) backdropTimer.start(0);
+        if (on) hideTimer.start(1100);
+        else reveal();
+    }
+
+    // Shared with the authenticated headless UI test: actual circular target.
+    QPoint buttonCenter() const {
+        const auto r = photoRect();
+        // The recessed bay switch shifts slightly in the pressed photograph.
+        // Centre the focus ring and hit target on that state.
+        return cableView ? QPointF(r.left() + .367 * r.width(), r.top() + .626 * r.height()).toPoint()
+                         : QPointF(r.center().x(), r.top() + r.width()/2).toPoint();
+    }
+    bool isCableView() const { return cableView; }
+    QRectF photoRect() const {
+        const qreal s = paintScale(), factor = photoFactor(s);
+        return QRectF(PhotoX*s, PhotoY*s, PhotoW*factor*s, photoHeight()*factor*s);
+    }
+    void setCableView(bool bay) {
+        cableView = bay;
+        QSettings(settingsFile, QSettings::IniFormat).setValue("power/view", bay ? "bay" : "close");
+        place(); update();
+    }
+
+protected:
+    void showEvent(QShowEvent *) override { leads->show(); leads->stackUnder(this); backdropTimer.start(0); }
+    void hideEvent(QHideEvent *) override { viewButton->hide(); leads->hide(); backdropTimer.stop(); backdrop.invalidate(); }
+    void enterEvent(QEvent *) override { hideTimer.stop(); viewButton->show(); }
+
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing);
+        p.setRenderHint(QPainter::SmoothPixmapTransform);
+        p.setOpacity(opacity);
+        const qreal s = paintScale();
+        const qreal factor = photoFactor(s);
+        const qreal ph = photoHeight();
+        p.scale(s, s);
+        const QRectF card(1, 1, PhotoW*factor + 10, ph*factor + 10);
+        const QColor rim = pressed ? QColor(208, 187, 146) :
+                           hovered ? amstrad::calloutInk() : QColor(185, 179, 167, 180);
+        if (cableView) {
+            // The cable-bay photograph retains its frame and clear boundary.
+            p.setPen(Qt::NoPen);
+            p.setBrush(QColor(0, 0, 0, 55));
+            p.drawRoundedRect(card.translated(0, 2), frameRadius(), frameRadius());
+            QPainterPath frostedFrame; frostedFrame.addRoundedRect(card,frameRadius(),frameRadius());
+            p.save(); p.setClipPath(frostedFrame);
+            backdrop.paint(p,QRectF(0,0,width()/s,height()/s));
+            p.restore();
+            p.setBrush(Qt::NoBrush);
+            p.setPen(QPen(rim, hovered || pressed ? 1.6 : 1.0));
+            p.drawRoundedRect(card, frameRadius(), frameRadius());
+        }
+        const QRectF photo(PhotoX, PhotoY, PhotoW*factor, ph*factor);
+        const int frame = (switchPending ? requestedPower : (powered || pressed)) ? 1 : 0;
+        const QImage &art = cableView ? bayPhoto[frame] : closePhoto[frame];
+        if (!art.isNull()) {
+            p.drawImage(photo, art);
+        } else {
+            // Keep the control usable if optional artwork is missing.
+            p.fillRect(photo, QColor(218, 210, 195));
+            p.setBrush(QColor(222, 215, 201)); p.setPen(QPen(QColor(135, 126, 112), 2));
+            const QPointF center = QPointF(buttonCenter()) / s;
+            p.drawEllipse(center, 28*factor, 28*factor);
+        }
+        if (!cableView) {
+            // Give the dashed leaders a definite landing point without boxing
+            // in the plastic as strongly as the cable-bay overlay.
+            QColor edge = hovered || pressed ? QColor(185, 179, 167, 160) : amstrad::calloutEdge();
+            p.setBrush(Qt::NoBrush);
+            p.setPen(QPen(edge, hovered || pressed ? 1.2 : .8));
+            p.drawRoundedRect(card, frameRadius(), frameRadius());
+        }
+        // Preserve the original POWER pill and icon below the photograph.
+        QFont font = p.font(); font.setPixelSize(11); font.setBold(true);
+        font.setLetterSpacing(QFont::AbsoluteSpacing, 1.6); p.setFont(font);
+        const QString word = tr("POWER");
+        const qreal textW = QFontMetricsF(font).horizontalAdvance(word);
+        const QRectF tag(((PhotoW*factor + 12) - (textW + 38)) / 2,
+                         ph*factor + 22, textW + 38, 22);
+        QPainterPath frostedTag; frostedTag.addRoundedRect(tag,11,11);
+        p.save(); p.setClipPath(frostedTag);
+        backdrop.paint(p,QRectF(0,0,width()/s,height()/s));
+        p.restore();
+        p.setPen(QPen(amstrad::calloutInk(), 1)); p.setBrush(Qt::NoBrush);
+        p.drawRoundedRect(tag, 11, 11);
+        const QPointF g(tag.left() + 16, tag.center().y() + .5);
+        p.setBrush(Qt::NoBrush);
+        p.setPen(QPen(amstrad::calloutInk(), 1.6, Qt::SolidLine, Qt::RoundCap));
+        p.drawArc(QRectF(g.x() - 5, g.y() - 5, 10, 10), 125 * 16, 290 * 16);
+        p.drawLine(QPointF(g.x(), g.y() - 6.5), QPointF(g.x(), g.y() - 1));
+        p.setPen(amstrad::calloutInk());
+        amstrad::drawPopupText(p,QRectF(tag.left() + 27, tag.top(), textW + 4, tag.height()), Qt::AlignVCenter | Qt::AlignLeft, word,amstrad::calloutInk());
+        if (hasFocus()) { p.setBrush(Qt::NoBrush); p.setPen(QPen(QColor(91, 81, 63), 1, Qt::DashLine)); p.drawEllipse(QPointF(buttonCenter()) / s, cableView ? 15*factor : 52, cableView ? 15*factor : 52); }
+    }
+
+    void mouseMoveEvent(QMouseEvent *e) override
+    { hideTimer.stop(); hovered = hit(e->pos()); setCursor(hovered ? Qt::PointingHandCursor : Qt::ArrowCursor); update(); e->accept(); }
+    void mousePressEvent(QMouseEvent *e) override
+    { pressed = !switchPending && e->button() == Qt::LeftButton && hit(e->pos()); hideTimer.stop(); update(); e->accept(); }
+    void mouseReleaseEvent(QMouseEvent *e) override
+    {
+        const bool activate = pressed && e->button() == Qt::LeftButton && hit(e->pos());
+        pressed = false; update(); e->accept();
+        if (activate) activateSwitch();
+    }
+    void leaveEvent(QEvent *) override { viewButton->hide(); pressed = false; hovered = false; update(); dismissLater(); }
+    void contextMenuEvent(QContextMenuEvent *e) override {
+        showViewMenu(e->globalPos()); e->accept();
+    }
+    void showViewMenu(const QPoint &position) {
+        hideTimer.stop(); menuOpen = true;
+        QMenu menu(this);
+        amstrad::stylePopupMenu(&menu,4);
+        auto *close = menu.addAction(tr("Button close-up")); close->setCheckable(true); close->setChecked(!cableView);
+        auto *bay = menu.addAction(tr("Rear cable bay")); bay->setCheckable(true); bay->setChecked(cableView);
+        bay->setEnabled(!bayAtlas.isNull());
+        auto *chosen = menu.exec(position);
+        if (chosen == close || chosen == bay) setCableView(chosen == bay);
+        menuOpen = false; reveal();
+        viewButton->setVisible(underMouse());
+        if (!underMouse()) dismissLater();
+    }
+    void keyPressEvent(QKeyEvent *e) override
+    {
+        if ((e->key() == Qt::Key_Space || e->key() == Qt::Key_Return) && !e->isAutoRepeat()) {
+            activateSwitch();
+            e->accept();
+        } else if (e->key() == Qt::Key_Escape) { if (powered) hide(); e->accept(); }
+        else QWidget::keyPressEvent(e);
+    }
+
+private:
+    qreal paintScale() const { return cableView ? amstrad::sceneLayout(parentWidget()->size()).scale : width() / Units; }
+    qreal photoFactor(qreal s) const { return cableView ? (width()/s - 12) / PhotoW : 1; }
+    // Feather only the outer plastic into the same frosted surface as the
+    // frame. Keep the switch and its recessed ring at their original sharpness.
+    static QImage softenedPhoto(QImage image, qreal corner, qreal feather = 17)
+    {
+        image = image.convertToFormat(QImage::Format_ARGB32);
+        const qreal w = image.width();
+        for (int y = 0; y < image.height(); ++y) {
+            auto *line = reinterpret_cast<QRgb *>(image.scanLine(y));
+            for (int x = 0; x < image.width(); ++x) {
+                const qreal px = (x + .5) * PhotoW / w;
+                const qreal py = (y + .5) * PhotoW / w;
+                const qreal qx = std::abs(px - PhotoW/2) - (PhotoW/2 - corner);
+                const qreal qy = std::abs(py - image.height()*PhotoW/w/2) - (image.height()*PhotoW/w/2 - corner);
+                const qreal outside = std::hypot(std::max(qx, qreal(0)), std::max(qy, qreal(0)));
+                const qreal distance = corner - outside - std::min(std::max(qx, qy), qreal(0));
+                const qreal t = std::clamp(distance / feather, qreal(0), qreal(1));
+                const int alpha = qRound(255 * t * t * (3 - 2*t));
+                line[x] = (line[x] & 0x00ffffff) | (quint32(alpha) << 24);
+            }
+        }
+        return image;
+    }
+    void activateSwitch() {
+        if (switchPending || !toggle) return;
+        // Keep the latched target image from mouse-up until the core acknowledges
+        // the transition. The old off state must not flash during a cold boot.
+        requestedPower = !powered;
+        switchPending = true;
+        update();
+        toggle();
+    }
+    // Design units: photograph, inset frame and original caption pill.
+    static constexpr qreal Units = 226, PhotoX = 6, PhotoY = 6, PhotoW = 214, CaptionDrop = 6;
+    qreal photoHeight() const { return cableView ? 107 : 204; }
+    qreal frameRadius() const { return cableView ? 12 : 36; }
+    QPointF rearTop() const { const qreal s = amstrad::sceneLayout(parentWidget()->size()).scale; return spot() + QPointF(2*s, -32*s); }
+    QPointF rearBottom() const { const qreal s = amstrad::sceneLayout(parentWidget()->size()).scale; return spot() + QPointF(-2*s, 32*s); }
+    bool hit(const QPointF &point) const
+    { return QLineF(point, buttonCenter()).length() <= photoRect().width() * (cableView ? .075 : .27); }
+    AmstradPowerLeads *leads = nullptr;
+    QToolButton *viewButton = nullptr;
+    QPainterPath travelArea;
+    QImage atlas;
+    QImage bayAtlas;
+    QImage closePhoto[2];
+    QImage bayPhoto[2];
+    QString settingsFile;
+    bool cableView = false;
+    bool menuOpen = false;
+    QTimer hideTimer;
+    QTimer backdropTimer;
+    amstrad::PopupBackdrop backdrop;
+    QVariantAnimation animation;
+    qreal opacity = 1;
+    bool pressed = false;
+    bool hovered = false;
+    bool switchPending = false;
+    bool requestedPower = false;
+};
+#endif
