new file mode 100644
--- /dev/null
+++ b/src/qt/qt_amstraddiskbox.hpp
@@ -0,0 +1,155 @@
+// The box of floppy disks beside the cabinet: the four Amstrad system discs,
+// the user's recently used images and their write-protect tabs. Kept in the
+// VM's amstrad.ini. GPL-2.0-or-later, like 86Box.
+#ifndef QT_AMSTRADDISKBOX_HPP
+#define QT_AMSTRADDISKBOX_HPP
+#include "qt_amstradscene.hpp"
+#include <QDir>
+#include <QFileInfo>
+#include <QSettings>
+#include <QStringList>
+
+namespace amstrad {
+
+class DiskBox {
+public:
+    // Discs 1-4 came with every machine; disc 5, the hard disc utilities, only
+    // with hard disc models. Without one it is just another of the user's disks.
+    static constexpr int SystemDiscs = 5, Kept = 12;
+    // Relative image paths resolve against the VM folder, like the emulator's.
+    explicit DiskBox(const QString &vmFolder, bool hardDisk = false)
+        : discs(hardDisk ? SystemDiscs : SystemDiscs - 1), base(vmFolder), settings(QDir(vmFolder).filePath("amstrad.ini"), QSettings::IniFormat) {}
+
+    // An image path as the box keeps it: no wp:// marker, absolute, tidy.
+    QString plain(QString path) const
+    {
+        if (path.startsWith("wp://", Qt::CaseInsensitive)) path.remove(0, 5);
+        if (path.isEmpty() || path.contains("://")) return path;
+        return QDir::cleanPath(QFileInfo(path).isRelative() ? base.absoluteFilePath(path) : path);
+    }
+    int systemDiscs() const { return discs; }
+    static bool same(const QString &a, const QString &b)
+    {
+#ifdef Q_OS_WINDOWS
+        return !a.compare(b, Qt::CaseInsensitive);
+#else
+        return a == b;
+#endif
+    }
+
+    // System disc n (0-3): the image the user pointed at, otherwise the best
+    // match by name among the folders in use. Empty when there is none.
+    QString systemDisc(int n) const
+    {
+        if (n >= discs) return {};
+        const QString chosen = settings.value(QString("disks/system%1").arg(n + 1)).toString();
+        if (chosen == QLatin1String("none")) return {};  // unlinked by the user: do not guess again
+        if (!chosen.isEmpty() && QFileInfo(chosen).isFile()) return chosen;
+        static const DriveFace colour[SystemDiscs] = { DiskRed, DiskBlue, DiskGreen, DiskYellow, DiskPurple };
+        QStringList folders { base.filePath("media"), settings.value("media/open_dir").toString() };
+        for (const QString &disk : stored("disks/recent")) folders << QFileInfo(disk).absolutePath();
+        QString best; int bestScore = -1;
+        QStringList seen;
+        for (const QString &folder : folders) {
+            if (folder.isEmpty() || seen.contains(folder, Qt::CaseInsensitive)) continue;
+            seen << folder;
+            for (const QFileInfo &file : QDir(folder).entryInfoList(QDir::Files, QDir::Name)) {
+                if (diskColour(file.fileName()) != colour[n]) continue;
+                // A 360K image named as part of the PC1512 set beats a look-alike.
+                // The VM's own working copies come before anything else.
+                const int score = (seen.size() == 1 ? 8 : 0) + (file.size() == 368640 ? 4 : 0)
+                    + (file.fileName().contains("1512") || file.fileName().contains("amstrad", Qt::CaseInsensitive) ? 2 : 0)
+                    + (file.suffix().compare("img", Qt::CaseInsensitive) ? 0 : 1);
+                if (score > bestScore) { bestScore = score; best = QDir::cleanPath(file.absoluteFilePath()); }
+            }
+        }
+        return best;
+    }
+    void setSystemDisc(int n, const QString &path) { settings.setValue(QString("disks/system%1").arg(n + 1), plain(path)); }
+    // Forget which image is disc n; it stays unlinked until one is chosen.
+    void unlinkSystemDisc(int n) { settings.setValue(QString("disks/system%1").arg(n + 1), QStringLiteral("none")); }
+    int systemIndex(const QString &path) const
+    {
+        const QString p = plain(path);
+        for (int n = 0; n < discs && !p.isEmpty(); ++n)
+            if (same(p, systemDisc(n))) return n;
+        return -1;
+    }
+
+    // The user's own disks, most recently used first; images that have gone
+    // are left out but not forgotten (they may be on a removable drive).
+    QStringList recent() const
+    {
+        QString system[SystemDiscs];
+        for (int n = 0; n < SystemDiscs; ++n) system[n] = systemDisc(n);
+        QStringList result;
+        for (const QString &disk : stored("disks/recent")) {
+            bool skip = !QFileInfo(disk).isFile();
+            for (const QString &s : system) skip |= same(disk, s);
+            if (!skip) result << disk;
+        }
+        return result;
+    }
+    // A new box starts with what the drives' own histories hold: oldest first.
+    bool started() const { return settings.contains("disks/recent"); }
+    void start(const QStringList &oldestFirst)
+    {
+        settings.setValue("disks/recent", QStringList());
+        for (const QString &path : oldestFirst) remember(path, path.startsWith("wp://", Qt::CaseInsensitive));
+    }
+    // Put a disk at the front of the box. The tab follows how it was mounted.
+    void remember(const QString &path, bool writeProtected)
+    {
+        const QString p = plain(path);
+        if (p.isEmpty() || p.contains("://")) return;
+        QStringList list = without(stored("disks/recent"), p);
+        list.prepend(p);
+        while (list.size() > Kept) list.removeLast();
+        settings.setValue("disks/recent", list);
+        setProtected(p, writeProtected);
+    }
+    // As remember(), for a disk found already in a drive: it keeps its place.
+    void note(const QString &path, bool writeProtected)
+    {
+        const QString p = plain(path);
+        if (p.isEmpty() || p.contains("://")) return;
+        if (without(stored("disks/recent"), p).size() == stored("disks/recent").size()) remember(p, writeProtected);
+        else setProtected(p, writeProtected);
+    }
+    void forget(const QString &path)
+    {
+        settings.setValue("disks/recent", without(stored("disks/recent"), plain(path)));
+        setProtected(path, false);
+    }
+
+    bool isProtected(const QString &path) const
+    { const QString p = plain(path); return without(stored("disks/protected"), p).size() != stored("disks/protected").size(); }
+    void setProtected(const QString &path, bool on)
+    {
+        QStringList list = without(stored("disks/protected"), plain(path));
+        if (on) list.prepend(plain(path));
+        settings.setValue("disks/protected", list);
+    }
+    // Whether an image picked with "Open" goes in with the tab on. On unless
+    // changed: a refused write is obvious, a silently altered original is not.
+    bool openProtected() const { return settings.value("disks/open_protected", true).toBool(); }
+    void setOpenProtected(bool on) { settings.setValue("disks/open_protected", on); }
+
+    // What to write on a disk's label.
+    static QString labelFor(const QString &path) { return QFileInfo(path).completeBaseName(); }
+
+private:
+    QStringList stored(const QString &key) const { return settings.value(key).toStringList(); }
+    static QStringList without(QStringList list, const QString &path)
+    {
+        for (int i = list.size() - 1; i >= 0; --i)
+            if (same(list[i], path)) list.removeAt(i);
+        return list;
+    }
+    int       discs;
+    QDir      base;
+    QSettings settings;
+};
+
+}
+#endif
diff --git a/src/qt/qt_amstradhints.hpp b/src/qt/qt_amstradhints.hpp
