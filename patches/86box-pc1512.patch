+extern "C" int qt_automation_mouse_capture_test(void)
+{
+    if (!main_window || !main_window->testAttribute(Qt::WA_DontShowOnScreen))
+        return 0;
+    bool passed = true;
+    QMetaObject::invokeMethod(main_window, [&] {
+        auto *stack = main_window->findChild<RendererStack *>();
+        auto *sw = stack ? stack->softwareRenderer() : nullptr;
+        if (!sw || !sw->hasCabinet() || dopause || mouse_capture) {
+            passed = false;
+            return;
+        }
+        const QSize previous = main_window->size();
+        auto check = [&](const QPoint &press, const QPoint &release, bool expected) {
+            // Send through the real software-renderer event delegate, including
+            // the stack's parent offset caused by the toolbar/menu/status bar.
+            // Cabinet clicks now open popups. Dismiss them without selecting a
+            // disk/configuration so the capture test can inspect the release.
+            QTimer::singleShot(0, main_window, [] {
+                while (auto *popup = QApplication::activePopupWidget()) popup->close();
+            });
+            QMouseEvent down(QEvent::MouseButtonPress, press, Qt::LeftButton, Qt::LeftButton, Qt::NoModifier);
+            QCoreApplication::sendEvent(sw, &down);
+            const bool capturedOnPress = mouse_capture;
+            QMouseEvent up(QEvent::MouseButtonRelease, release, Qt::LeftButton, Qt::NoButton, Qt::NoModifier);
+            QCoreApplication::sendEvent(sw, &up);
+            const bool captured = mouse_capture;
+            plat_mouse_capture(0);
+            if (capturedOnPress || captured != expected) {
+                fprintf(stderr, "Mouse capture FAIL: %dx%d press=%d,%d release=%d,%d expected=%d actual=%d down=%d\n",
+                        sw->width(), sw->height(), press.x(), press.y(), release.x(), release.y(),
+                        expected, captured, capturedOnPress);
+                passed = false;
+            }
+        };
+        auto checkLayout = [&] {
+            const auto l = amstrad::sceneLayout(sw->size());
+            const QPoint center = l.video.center().toPoint();
+            check(center, center, true);
+            const QRect inside = l.video.adjusted(2, 2, -2, -2).toRect();
+            for (const auto &point : {inside.topLeft(), inside.topRight(), inside.bottomLeft(), inside.bottomRight()})
+                check(point, point, true);
+            // Every picture edge, bezel/glass, case, drive bays and margins.
+            for (const auto &point : {
+                     QPoint(qFloor(l.video.left()) - 1, center.y()),
+                     QPoint(qCeil(l.video.right()) + 1, center.y()),
+                     QPoint(center.x(), qFloor(l.video.top()) - 1),
+                     QPoint(center.x(), qCeil(l.video.bottom()) + 1),
+                     l.aperture.topLeft().toPoint(),
+                     QPoint(sw->width() / 2, sw->height() * 9 / 10),
+                     QPoint(1, 1), QPoint(sw->width() - 2, sw->height() - 2)}) {
+                check(point, point, false);
+                check(point, center, false);
+                check(center, point, false);
+            }
+            // An outside click or drag must not poison the next screen click.
+            check(center, center, true);
+        };
+        auto settle = [] {
+            QEventLoop loop;
+            QTimer::singleShot(150, &loop, &QEventLoop::quit);
+            loop.exec();
+        };
+        for (const auto &size : {QSize(950, 1030), QSize(1500, 850), QSize(650, 1050)}) {
+            main_window->resize(size);
+            settle();
+            checkLayout();
+        }
+        QMetaObject::invokeMethod(main_window, "on_actionFullscreen_triggered", Qt::DirectConnection);
+        settle();
+        checkLayout();
+        QMetaObject::invokeMethod(main_window, "on_actionFullscreen_triggered", Qt::DirectConnection);
+        main_window->resize(previous);
+        settle();
+        fprintf(stderr, "Mouse capture test: %s (windowed, wide, tall, fullscreen; DPR %.2f)\n",
+                passed ? "PASS" : "FAIL", sw->devicePixelRatioF());
+        fflush(stderr);
+    }, Qt::BlockingQueuedConnection);
+    return passed;
+}
