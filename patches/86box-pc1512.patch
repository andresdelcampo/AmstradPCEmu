+// Everything a drive's panel needs from the emulator. The actions run after
+// the panel has closed, so they may open dialogs; none may refer to it.
+struct DrivePanel {
+    int drive = 0;                 // 0 is A:
+    bool hardDisk = false;         // a hard disc machine: system disc 5 joins the set
+    QString vmFolder, artFolder;
+    QString mounted[2];            // image in A: and in B:, empty when none
+    bool mountedProtected = false; // this drive's
+    QPixmap closed, open;          // the bay now, and with the lever up
+    std::function<void(const QString &,bool)> insert; // image, write-protected
+    std::function<void(bool)> browse;                 // pick an image file, then insert
+    std::function<void()> create, eject;
+    std::function<void(int)> locate;                  // pick the image of system disc n
+};
+inline void addDrivePanel(QMenu *menu,const DrivePanel &panel,qreal ratio)
+{
+    static const char *const systemNames[DiskBox::SystemDiscs] = {
+        QT_TRANSLATE_NOOP("QObject","1 · MS-DOS"), QT_TRANSLATE_NOOP("QObject","2 · GEM Startup"),
+        QT_TRANSLATE_NOOP("QObject","3 · GEM Desktop"), QT_TRANSLATE_NOOP("QObject","4 · DOS Plus"),
+        QT_TRANSLATE_NOOP("QObject","5 · HD Utilities") };
+    DiskBox box(panel.vmFolder,panel.hardDisk);
+    // Five across when the hard disc utilities join the set.
+    const int columns = std::max(int(DiskTile::Columns),box.systemDiscs());
+    const int width = DiskTile::Width*columns+6*(columns-1);
+    const DiskArt &art = DiskArt::load(panel.artFolder);
+    const QString vm = panel.vmFolder, letter(QChar('A'+panel.drive));
+    QString mounted[2];
+    for (int d = 0; d < 2; ++d) {
+        mounted[d] = box.plain(panel.mounted[d]);
+        if (d == panel.drive && !mounted[d].isEmpty() && box.systemIndex(mounted[d]) < 0)
+            box.note(mounted[d],panel.mountedProtected);
+    }
+    auto inDrive = [&](const QString &path) {
+        for (int d = 0; d < 2; ++d)
+            if (!path.isEmpty() && DiskBox::same(path,mounted[d])) return d;
+        return -1;
+    };
+
+    // The drive and its disk.
+    const QString &current = mounted[panel.drive];
+    const int currentSystem = box.systemIndex(current);
+    auto *card = new DriveCard(panel.closed,current.isEmpty() ? QPixmap() : panel.open,
+        QObject::tr("Drive %1:  5¼\" 360K").arg(letter),
+        current.isEmpty() ? QObject::tr("Empty. Choose a disk below.")
+            : currentSystem >= 0 ? QObject::tr("System disc %1").arg(QObject::tr(systemNames[currentSystem])) : DiskBox::labelFor(current),
+        current.isEmpty() ? QString() : currentSystem >= 0 ? QObject::tr("Write-protected") : QString(),
+        current.isEmpty() ? std::function<void()>() : panel.eject);
+    if (!current.isEmpty()) {
+        card->face.picture = DiskFace::scaled(currentSystem >= 0 ? art.bare[currentSystem] : art.black,DriveCard::Disk,ratio);
+        if (currentSystem < 0) {
+            card->face.label = DiskBox::labelFor(current);
+            // Changing the tab means taking the disk out and putting it back.
+            card->setTab(panel.mountedProtected,[insert = panel.insert,current](bool on) { insert(current,on); });
+        }
+    }
+    card->setMinimumWidth(width);
+    auto *header = new QWidgetAction(menu); header->setDefaultWidget(card); menu->addAction(header);
+
+    auto addRow = [&](const QString &title,const QString &subtitle) {
+        auto *a = new QWidgetAction(menu);
+        a->setDefaultWidget(new MenuCaption(title,subtitle,true,width)); a->setEnabled(false); menu->addAction(a);
+        auto *grid = addGrid(menu); grid->setSpacing(6); grid->setColumnStretch(columns,1);
+        return grid;
+    };
+    auto place = [columns](QGridLayout *grid,DiskTile *tile) {
+        const int i = grid->count(); grid->addWidget(tile,i/columns,i%columns); return tile;
+    };
+
+    // The Amstrad set, in its sleeves. Always protected: the foil tabs stay on.
+    auto *system = addRow(QObject::tr("System discs"),QObject::tr("Always write-protected"));
+    for (int n = 0; n < box.systemDiscs(); ++n) {
+        const QString path = box.systemDisc(n), name = QObject::tr(systemNames[n]);
+        const int where = inDrive(path);
+        const std::function<void()> locate = [locate = panel.locate,n] { locate(n); };
+        const std::function<void()> insert = [insert = panel.insert,path] { insert(path,true); };
+        auto *tile = place(system,new DiskTile(art.sleeved[n],{},
+            where >= 0 ? QObject::tr("In drive %1:").arg(QChar('A'+where)) : path.isEmpty() ? QObject::tr("%1: find…").arg(name) : name,
+            path.isEmpty() ? QObject::tr("No image found for this disc. Click to choose it.")
+                           : QDir::toNativeSeparators(path)+QStringLiteral("\n")+QObject::tr("Right-click to forget this image, then choose another."),
+            path.isEmpty() ? locate : insert,ratio));
+        if (!path.isEmpty()) tile->setSecondary([vm,n] { DiskBox(vm,true).unlinkSystemDisc(n); });
+        tile->setFaded(path.isEmpty() || where >= 0);
+        tile->setEnabled(where < 0);
+    }
+
+    // The user's own, newest first. Right-click takes one out of the box.
+    QStringList recent;
+    for (const QString &path : box.recent())
+        if (inDrive(path) < 0 && recent.size() < 2*columns) recent << path;
+    if (!recent.isEmpty()) {
+        auto *own = addRow(QObject::tr("Your disks"),QObject::tr("Click a notch to fit or peel off its write-protect tab"));
+        for (const QString &path : recent) {
+            auto *tile = place(own,new DiskTile(art.black,DiskBox::labelFor(path),{},
+                QDir::toNativeSeparators(path)+QStringLiteral("\n")+QObject::tr("Right-click to take it out of the box."),
+                [insert = panel.insert,path,vm] { insert(path,DiskBox(vm).isProtected(path)); },ratio));
+            tile->setTab(box.isProtected(path),[vm,path](bool on) { DiskBox(vm).setProtected(path,on); });
+            tile->setSecondary([vm,path] { DiskBox(vm).forget(path); });
+        }
+    }
+
+    // Anything else: pick an image file, or make a blank disk.
+    auto *other = addRow(QObject::tr("Another disk"),QObject::tr("Open an image file, or start a blank disk"));
+    auto *open = place(other,new DiskTile(art.black,QObject::tr("‹ Open… ›"),{},QObject::tr("Choose a disk image and insert it."),
+        [browse = panel.browse,vm] { browse(DiskBox(vm).openProtected()); },ratio,true));
+    open->setTab(box.openProtected(),[vm](bool on) { DiskBox(vm).setOpenProtected(on); });
+    place(other,new DiskTile(art.black,QObject::tr("‹ New… ›"),{},QObject::tr("Create a blank disk image and insert it."),panel.create,ratio,true));
+}
+}
