+// Reuse the supplied GEM Paint chrome, replacing both canvas and document
+// title. Coordinates refer to that unmodified 639x400 reference capture.
+inline QImage gemPaintHouse(const QImage &frame, const QImage &house, const uint8_t font[][8])
+{
+    if (frame.isNull() || house.isNull()) return house;
+    QImage screen = frame.convertToFormat(QImage::Format_RGB32);
+    if (screen.size() != QSize(639,400)) return house;
+    {
+        QPainter p(&screen);
+        p.setRenderHint(QPainter::SmoothPixmapTransform, false);
+        p.fillRect(QRect(112,44,383,320), Qt::white);
+        // The capture has doubled scanlines. Compensate for its pixel aspect
+        // before it is displayed on the cabinet's 4:3 tube.
+        p.drawImage(QRect(112,84,383,240), house);
+        p.fillRect(QRect(25,24,580,18), Qt::white);
+    }
+    const QByteArray title("C:\\GEM\\IMG\\HOUSE.IMG");
+    const int left = (screen.width() - title.size() * 8) / 2;
+    for (int i = 0; i < title.size(); ++i)
+        for (int y = 0; y < 8; ++y)
+            for (int x = 0; x < 8; ++x)
+                if (font[static_cast<unsigned char>(title[i])][y] & (0x80 >> x))
+                    for (int dy = 0; dy < 2; ++dy)
+                        screen.setPixel(left + i * 8 + x, 25 + y * 2 + dy, qRgb(0,0,0));
+    return screen;
+}
+
+inline QImage cgaPaletteImage(const QImage &source)
+{
+    static const QRgb colours[] = {
+        qRgb(0,0,0), qRgb(0,0,170), qRgb(0,170,0), qRgb(0,170,170),
+        qRgb(170,0,0), qRgb(170,0,170), qRgb(170,85,0), qRgb(170,170,170),
+        qRgb(85,85,85), qRgb(85,85,255), qRgb(85,255,85), qRgb(85,255,255),
+        qRgb(255,85,85), qRgb(255,85,255), qRgb(255,255,85), qRgb(255,255,255)
+    };
+    QImage result = source.convertToFormat(QImage::Format_RGB32);
+    for (int y = 0; y < result.height(); ++y) {
+        auto *row = reinterpret_cast<QRgb *>(result.scanLine(y));
+        for (int x = 0; x < result.width(); ++x) {
+            const QRgb original = row[x];
+            int distance = 3 * 255 * 255 + 1;
+            for (const QRgb colour : colours) {
+                const int r = qRed(original)-qRed(colour), g = qGreen(original)-qGreen(colour), b = qBlue(original)-qBlue(colour);
+                const int candidate = r*r + g*g + b*b;
+                if (candidate < distance) { distance = candidate; row[x] = colour; }
+            }
+        }
+    }
+    return result;
+}
+
+// A 320x200 CGA sample, using the emulator's actual 8x8 character ROM.
+// Only black, bright cyan, bright magenta and white are emitted.
+inline QImage monitorSample(const uint8_t font[][8])
+{
+    QImage sample(320, 200, QImage::Format_RGB32);
+    sample.fill(Qt::black);
+    auto text = [&](int col, int row, const QByteArray &string, QRgb colour) {
+        for (int i = 0; i < string.size(); ++i)
+            for (int y = 0; y < 8; ++y)
+                for (int x = 0; x < 8; ++x)
+                    if (font[static_cast<unsigned char>(string[i])][y] & (0x80 >> x))
+                        for (int dy = 0; dy < 2; ++dy)
+                            for (int dx = 0; dx < 2; ++dx)
+                                sample.setPixel((col + i) * 16 + x * 2 + dx, row * 16 + y * 2 + dy, colour);
+    };
+    const QRgb cyan = qRgb(85,255,255), magenta = qRgb(255,85,255), white = qRgb(255,255,255);
+    text(1, 1, "AMSTRAD PC1512", white);
+    text(1, 3, "CGA COLOUR DISPLAY", cyan);
+    text(1, 5, "320x200 / 4 COLOURS", white);
+    for (int i = 0; i < 3; ++i) {
+        const QRgb colour = i == 0 ? cyan : i == 1 ? magenta : white;
+        // Solid swatches use rectangles, independent of ROM glyph shapes.
+        QPainter p(&sample);
+        p.fillRect(QRect(24 + i * 96, 112, 80, 40), QColor::fromRgb(colour));
+    }
+    text(1, 11, "A>", white);
+    return sample;
+}
+
+// Preserve the complete cabinet photograph and its glass. Only light emitted
+// by the CGA sample is added, with falloff and scan lines. Content geometry
+// stays flat: the existing photograph supplies the physical glass shape.
+inline QImage monitorPhotograph(QImage cabinet, const QImage &sample, bool mono)
+{
+    const QImage display = cgaPaletteImage(sample);
+    cabinet = cabinet.convertToFormat(QImage::Format_ARGB32);
+    const auto l = layout(cabinet.size());
+    const QRect video = l.video.toAlignedRect().intersected(cabinet.rect());
+    for (int y = video.top(); y <= video.bottom(); ++y) {
+        auto *out = reinterpret_cast<QRgb *>(cabinet.scanLine(y));
+        const double ny = 2.0 * (y - l.video.top()) / l.video.height() - 1;
+        for (int x = video.left(); x <= video.right(); ++x) {
+            const double nx = 2.0 * (x - l.video.left()) / l.video.width() - 1;
+            const int px = std::clamp(int((nx + 1) * .5 * display.width()), 0, display.width() - 1);
+            const int py = std::clamp(int((ny + 1) * .5 * display.height()), 0, display.height() - 1);
+            QRgb light = display.pixel(px, py);
+            if (mono) {
+                const int grey = (76 * qRed(light) + 150 * qGreen(light) + 29 * qBlue(light)) / 255;
+                light = qRgb(grey, grey, grey);
+            }
+            const double strength = .76 * (1 - .12 * (nx * nx + ny * ny)) * ((y & 1) ? .94 : 1);
+            const QRgb glass = out[x];
+            out[x] = qRgba(std::min(255, qRed(glass) + int(qRed(light) * strength)),
+                           std::min(255, qGreen(glass) + int(qGreen(light) * strength)),
+                           std::min(255, qBlue(glass) + int(qBlue(light) * strength)), qAlpha(glass));
+        }
+    }
+    // Include the whole moulded casing and pedestal, omitting the system unit.
+    const double scale = cabinet.width() / 1254.0;
+    return cabinet.copy(QRectF(100 * scale, 0, 1060 * scale, 940 * scale).toAlignedRect());
+}
