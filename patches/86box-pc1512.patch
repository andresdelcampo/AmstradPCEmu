+        // inside it so QCursor is not clamped away from the simulated pointer.
+        main_window->resize(650, 550); settle(150);
+        const QPoint badge = at(amstrad::masterMonitorBadge());
+        move(QPoint(1,1)); move(badge); settle(180); move(QPoint(1,1));
+        QTimer::singleShot(350, main_window, [&] {
+            require(!QApplication::activePopupWidget(), "brief pass over a part opened its menu"); close();
+        });
+        settle(400);
+        move(badge);
+        QTimer::singleShot(650, main_window, [&] { inspect("hover-monitor", 2); });
+        settle(700);
+        // Escape/closing must not reopen under a stationary pointer.
+        QTimer::singleShot(650, main_window, [&] {
+            require(!QApplication::activePopupWidget(), "stationary pointer reopened a dismissed popup"); close();
+        });
+        settle(700);
+        // Captured guest input must never arm a cabinet hover.
+        plat_mouse_capture(1); move(QPoint(1,1)); move(badge);
+        QTimer::singleShot(650, main_window, [&] {
+            require(!QApplication::activePopupWidget(), "captured mouse opened a cabinet menu"); close();
+        });
+        settle(700); plat_mouse_capture(0);
+        main_window->resize(previous); settle(150);
+        fprintf(stderr, "Cabinet menus: %s (left click, delayed hover, cancellation, dismissal, capture guard)\n", passed ? "PASS" : "FAIL");
+        fflush(stderr);
+    }, Qt::BlockingQueuedConnection);
+    return passed;
+}
