+void
+MainWindow::toggleAmstradPower()
+{
+    if (amstrad_power_busy || !amstradCabinet()) return;
+    extern void amstrad_power_click();
+    amstrad_power_click();
+    if (amstrad_power_on) {
+        // A distinct reason prevents Pause, dialogs or focus changes from resuming an off PC.
+        runctl_pause_wait(RUN_PAUSE_POWER);
+        keyboard_all_up();
+        plat_mouse_capture(0);
+        amstrad_power_on = false;
+        if (auto *sw = ui->stackedWidget->softwareRenderer()) sw->setCabinetPower(false);
+        ui->actionCtrl_Alt_Del->setEnabled(false);
+        ui->actionPause->setEnabled(false);
+        updatePowerOffAction();
+    } else {
+        // The core processes a hard power cycle at a safe point even while parked.
+        // Keep the dark cabinet until that completes; never resume the old RAM/CPU state.
+        amstrad_power_busy = true;
+        updatePowerOffAction();
+        config_changed = 2;
+        pc_reset_hard();
+    }
+}
+
+void
+MainWindow::finishAmstradPowerOn()
+{
+    if (!amstrad_power_busy) return;
+    amstrad_power_busy = false;
+    amstrad_power_on = true;
+    keyboard_all_up();
+    if (auto *sw = ui->stackedWidget->softwareRenderer()) sw->setCabinetPower(true);
+    ui->actionCtrl_Alt_Del->setEnabled(true);
+    ui->actionPause->setEnabled(true);
+    updatePowerOffAction();
+    runctl_resume(RUN_PAUSE_POWER);
+    runctl_resume(static_cast<run_pause_t>(RUN_PAUSE_USER_RESUMABLE));
+}
