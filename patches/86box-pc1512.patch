+/* Disk insert/eject sounds, shared by every drive profile. They are queued
+   by the GUI (media menu mount/eject) and mixed by the audio thread, so a
+   disk mounted from the configuration at start-up stays silent. */
+#define MEDIA_SOUND_EJECT  1
+#define MEDIA_SOUND_INSERT 2
+static audio_sample_t media_sound[2]; /* [0] eject, [1] insert */
+static atomic_int     media_request[FDD_NUM];
+static struct {
+    audio_sample_t *sample;
+    int             pos;
+    int             then_insert;
+} media_play[FDD_NUM];
+
+static void
+media_sounds_load(void)
+{
+    static const char *const files[2] = { "assets/sounds/fdd/amstrad/disk_eject.wav",
+                                          "assets/sounds/fdd/amstrad/disk_insert.wav" };
+    for (int i = 0; i < 2; i++) {
+        if (media_sound[i].buffer == NULL) {
+            media_sound[i].buffer = sound_load_wav(files[i], &media_sound[i].samples);
+            media_sound[i].volume = 1.0f;
+        }
+    }
+    for (int i = 0; i < FDD_NUM; i++) {
+        atomic_store(&media_request[i], 0);
+        media_play[i].sample = NULL;
+    }
+}
+
+/* GUI thread: request the eject and/or insert sound for a drive. A swap asks
+   for both and plays the eject first. Drives without a sound profile stay quiet. */
+void
+fdd_audio_play_media(int drive, int eject, int insert)
+{
+    if ((drive < 0) || (drive >= FDD_NUM) || !fdd_sounds_enabled || !get_drive_samples(&drives[drive]))
+        return;
+    atomic_fetch_or(&media_request[drive], (eject ? MEDIA_SOUND_EJECT : 0) | (insert ? MEDIA_SOUND_INSERT : 0));
+}
+
+/* Audio thread: take any new request (it restarts the sound), then return the
+   sample now playing on the drive, or NULL when it is quiet. */
+static audio_sample_t *
+media_next(int drive)
+{
+    const int request = atomic_exchange(&media_request[drive], 0);
+    if (request) {
+        media_play[drive].pos         = 0;
+        media_play[drive].then_insert = (request & MEDIA_SOUND_EJECT) && (request & MEDIA_SOUND_INSERT);
+        media_play[drive].sample      = &media_sound[(request & MEDIA_SOUND_EJECT) ? 0 : 1];
+    }
+    audio_sample_t *sample = media_play[drive].sample;
+    if (sample && (!sample->buffer || media_play[drive].pos >= sample->samples)) {
+        sample = NULL;
+        if (media_play[drive].then_insert) {
+            media_play[drive].then_insert = 0;
+            media_play[drive].pos         = 0;
+            if (media_sound[1].buffer)
+                sample = &media_sound[1];
+        }
+        media_play[drive].sample = sample;
+    }
+    return sample;
+}
+
+/* Any thread: true until a requested insert sound is two thirds through, so
+   the front shows the latch closing on the disk at about the moment it clicks
+   home in the recording. Reads the audio thread's state unlocked; a stale
+   answer lasts one frame at most. */
+int
+fdd_audio_media_inserting(int drive)
+{
+    if ((drive < 0) || (drive >= FDD_NUM))
+        return 0;
+    if (atomic_load(&media_request[drive]) & MEDIA_SOUND_INSERT)
+        return 1;
+    const audio_sample_t *sample = media_play[drive].sample;
+    if (sample == &media_sound[1])
+        return media_play[drive].pos < sample->samples * 2 / 3;
+    return sample && media_play[drive].then_insert;
+}
+
+/* Any thread: true until a requested eject sound is a quarter through; until
+   then the front keeps showing the old disk, then the latch opens. */
+int
+fdd_audio_media_ejecting(int drive)
+{
+    if ((drive < 0) || (drive >= FDD_NUM))
+        return 0;
+    if (atomic_load(&media_request[drive]) & MEDIA_SOUND_EJECT)
+        return 1;
+    const audio_sample_t *sample = media_play[drive].sample;
+    return (sample == &media_sound[0]) && (media_play[drive].pos < sample->samples / 4);
+}
+
+static int
+media_active(void)
+{
+    for (int drive = 0; drive < FDD_NUM; drive++)
+        if (media_play[drive].sample || atomic_load(&media_request[drive]))
+            return 1;
+    return 0;
+}
+
+/* Adds the insert/eject sounds onto an already filled stereo buffer. */
+static void
+media_mix(int16_t *buffer, int frames)
+{
+    float *float_buffer = (float *) buffer;
+    for (int drive = 0; drive < FDD_NUM; drive++) {
+        for (int i = 0; i < frames; i++) {
+            audio_sample_t *sample = media_next(drive);
+            if (!sample)
+                break;
+            const int pos = media_play[drive].pos++;
+            if (sound_is_float) {
+                float_buffer[i * 2] += (float) sample->buffer[pos * 2] / 131072.0f * sample->volume;
+                float_buffer[i * 2 + 1] += (float) sample->buffer[pos * 2 + 1] / 131072.0f * sample->volume;
+            } else {
+                buffer[i * 2]     = (int16_t) (buffer[i * 2] + (int16_t) ((float) sample->buffer[pos * 2] / 4.0f * sample->volume));
+                buffer[i * 2 + 1] = (int16_t) (buffer[i * 2 + 1] + (int16_t) ((float) sample->buffer[pos * 2 + 1] / 4.0f * sample->volume));
+            }
+        }
+    }
+}
+
