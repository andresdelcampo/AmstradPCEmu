+// A card showing a disk whose write-protect tab can be clicked on and off
+// without closing the panel; the rest of the card is an ordinary button.
+class DiskButton : public MenuCard {
+public:
+    using MenuCard::MenuCard;
+    // changed(on) runs at once, while the panel is open.
+    void setTab(bool on,std::function<void(bool)> changed = {})
+    { face.tab = on; tabChanged = std::move(changed); setMouseTracking(bool(tabChanged)); if (tabChanged) setFocusPolicy(Qt::StrongFocus); describe(); }
+    // Right-click; runs after the panel has closed, like a click.
+    void setSecondary(std::function<void()> f) { secondary = std::move(f); }
+    DiskFace face;
+protected:
+    virtual QRectF diskRect() const = 0;
+    bool overNotch(const QPoint &pos) const { return tabChanged && isEnabled() && diskNotchZone(diskRect()).contains(pos); }
+    void describe()
+    {
+        if (!tabChanged) return;
+        const QString state = face.tab ? tr("Write-protected") : tr("Writable");
+        setToolTip(face.notchLit ? (face.tab ? tr("Write-protect tab fitted. Click to peel it off.")
+                                             : tr("Open notch: the disk can be written. Click to fit a write-protect tab."))
+                                 : body + QStringLiteral("\n") + state + tr(" (click the notch, or press P, to change)"));
+        setAccessibleDescription(body + QStringLiteral(". ") + state);
+    }
+    void flip() { face.tab = !face.tab; describe(); update(); if (tabChanged) tabChanged(face.tab); }
+    void mouseMoveEvent(QMouseEvent *e) override
+    {
+        const bool over = overNotch(e->pos());
+        if (over != face.notchLit) { face.notchLit = over; describe(); update(); }
+        MenuCard::mouseMoveEvent(e);
+    }
+    void leaveEvent(QEvent *e) override { face.notchLit = false; describe(); MenuCard::leaveEvent(e); }
+    void mousePressEvent(QMouseEvent *e) override
+    {
+        pressedNotch = e->button() == Qt::LeftButton && overNotch(e->pos());
+        if (e->button() == Qt::RightButton && secondary) {
+            const auto run = secondary;
+            while (QWidget *popup = QApplication::activePopupWidget()) popup->close();
+            QTimer::singleShot(0,qApp,run); e->accept(); return;
+        }
+        if (pressedNotch) { e->accept(); return; }
+        MenuCard::mousePressEvent(e);
+    }
+    void mouseReleaseEvent(QMouseEvent *e) override
+    {
+        if (pressedNotch) { pressedNotch = false; if (overNotch(e->pos())) flip(); e->accept(); return; }
+        MenuCard::mouseReleaseEvent(e);
+    }
+    void keyPressEvent(QKeyEvent *e) override
+    {
+        if (tabChanged && e->key() == Qt::Key_P) { flip(); e->accept(); }
+        else MenuCard::keyPressEvent(e);
+    }
+    std::function<void(bool)> tabChanged;
+    std::function<void()> secondary;
+    bool pressedNotch = false;
+};
