+// ---- The machine panel: the computer, then the drives fitted in it ----
+// The model nameplate as on the unit's fascia: red "PC" and pale numerals on
+// the grey strip, set in the cream casing. Drawn, because the lettering in
+// the cabinet artwork is too small to enlarge.
+inline void drawNameplate(QPainter &p, const QRectF &r, const QString &number)
+{
+    p.save(); p.setRenderHint(QPainter::Antialiasing); p.setPen(Qt::NoPen);
+    QLinearGradient casing(r.topLeft(),r.bottomLeft());
+    casing.setColorAt(0,QColor("#ece6d8")); casing.setColorAt(1,QColor("#cdc5b4"));
+    p.setBrush(casing); p.drawRoundedRect(r,7,7);
+    const QRectF strip = r.adjusted(6,6,-6,-6);
+    QLinearGradient grey(strip.topLeft(),strip.bottomLeft());
+    grey.setColorAt(0,QColor("#73747d")); grey.setColorAt(.12,QColor("#8b8c95")); grey.setColorAt(1,QColor("#7b7c85"));
+    p.setBrush(grey); p.drawRoundedRect(strip,2,2);
+    QFont f(QStringLiteral("Arial")); f.setPixelSize(qRound(strip.height()*.66)); f.setWeight(QFont::DemiBold);
+    QFont n = f; n.setWeight(QFont::Normal); n.setLetterSpacing(QFont::AbsoluteSpacing,.6);
+    const QString pc = QStringLiteral("PC");
+    const qreal gap = f.pixelSize()*.26, wp = QFontMetricsF(f).horizontalAdvance(pc), wn = QFontMetricsF(n).horizontalAdvance(number);
+    QRectF line = strip; line.setLeft(strip.center().x()-(wp+gap+wn)/2);
+    p.setFont(f); p.setPen(QColor("#c9392d")); p.drawText(line,Qt::AlignLeft|Qt::AlignVCenter,pc);
+    line.setLeft(line.left()+wp+gap);
+    p.setFont(n); p.setPen(QColor("#ececf0")); p.drawText(line,Qt::AlignLeft|Qt::AlignVCenter,number);
+    p.restore();
+}
+// A computer: its nameplate beside what sets it apart.
