--- /dev/null
+++ b/src/qt/qt_amstradhints.hpp
@@ -0,0 +1,492 @@
+// Where the cabinet's controls are. GPL-2.0-or-later, like 86Box.
+//
+// Nothing on the cabinet says that the drive bays and badges open controls.
+// A small, muted mark in the bottom-right corner of the scene answers that on
+// request: while the pointer rests on it, every live part is outlined and
+// named, the rear power close-up comes into view, and a card above the mark
+// credits the program and what it is built on. Nothing moves or asks for
+// attention otherwise.
+#ifndef QT_AMSTRADHINTS_HPP
+#define QT_AMSTRADHINTS_HPP
+
+#include "qt_amstradscene.hpp"
+#include "qt_amstradpower.hpp"
+#include <QFontMetricsF>
+#include <QMouseEvent>
+#include <QTimer>
+#include <QVariantAnimation>
+#include <QWidget>
+#include <functional>
+// 86Box's own version, where this is built as part of it (not in the tests).
+#if __has_include(<86box/version.h>)
+#    include <86box/version.h>
+#endif
+
+namespace amstrad {
+
+// The visible part inside each hotspot and the centre of its name tag, both
+// in master pixels. Tags sit just above their part, clear of the artwork.
+struct HintArea {
+    Hotspot hot;
+    QRectF  master;
+    qreal   radius;
+    QPointF tag;
+};
+constexpr int HintAreaCount = 4;
+
+inline const HintArea *hintAreas()
+{
+    static const HintArea all[HintAreaCount] = {
+        { HotLeftBay,      QRectF(185, 1022, 428, 118), 5, QPointF(399, 999) },
+        { HotRightBay,     QRectF(642, 1022, 428, 118), 5, QPointF(856, 999) },
+        { HotModelBadge,   QRectF(872, 1187, 206, 26),  3, QPointF(975, 1164) },
+        { HotMonitorBadge, QRectF(932, 751, 120, 38),   4, QPointF(992, 727) },
+    };
+    return all;
+}
+
+inline QRectF hintRect(const Layout &l, const HintArea &a)
+{
+    return QRectF(l.cabinet.left() + a.master.x() * l.scale, l.cabinet.top() + a.master.y() * l.scale,
+                  a.master.width() * l.scale, a.master.height() * l.scale);
+}
+
+// What each part is, by what is fitted. A single floppy drive is A: and sits
+// in the right bay; with two, A: is on the left and B: on the right.
+inline QString hintName(Hotspot hot, const Front &front)
+{
+    switch (hot) {
+        case HotLeftBay:
+            return front.left == BayFloppy ? QStringLiteral("DRIVE A")
+                 : front.left == BayHdd    ? QStringLiteral("HARD DISK") : QStringLiteral("DRIVE BAY");
+        case HotRightBay:     return front.rightDrive() ? QStringLiteral("DRIVE B") : QStringLiteral("DRIVE A");
+        case HotModelBadge:   return QStringLiteral("MACHINE");
+        case HotMonitorBadge: return QStringLiteral("MONITOR");
+        default:              return {};
+    }
+}
+
+// A few words on what opening the part is for.
+inline QString hintText(Hotspot hot, const Front &front)
+{
+    switch (hot) {
+        case HotLeftBay:
+            return front.left == BayFloppy ? QStringLiteral("Insert or eject a disk")
+                                           : QStringLiteral("Change what is fitted");
+        case HotRightBay:     return QStringLiteral("Insert or eject a disk");
+        case HotModelBadge:   return QStringLiteral("Choose the drives fitted");
+        case HotMonitorBadge: return front.pc1640 ? QStringLiteral("Choose the screen")
+                                                  : QStringLiteral("Colour or mono");
+        default:              return {};
+    }
+}
+
+// Every live part: the menus' hover box around it and a name tag in the
+// power close-up's annotation style. power is that close-up's place on
+// screen (null to leave it out); it already carries its own POWER caption.
+inline void paintHintAreas(QPainter &p, const Layout &l, const Front &front, qreal opacity,
+                           const QRectF &power = QRectF())
+{
+    if (opacity <= 0) return;
+    p.save();
+    p.setRenderHint(QPainter::Antialiasing, true);
+    p.setOpacity(opacity);
+    QFont font = p.font();
+    font.setPixelSize(std::max(9, qRound(12 * l.scale)));
+    font.setBold(true);
+    font.setLetterSpacing(QFont::AbsoluteSpacing, 1.4);
+    QFont plain = font;
+    plain.setBold(false);
+    plain.setLetterSpacing(QFont::AbsoluteSpacing, 0);
+    plain.setPixelSize(std::max(10, qRound(13 * l.scale)));
+    const QFontMetricsF metrics(font), plainMetrics(plain);
+    const qreal out = 5 * l.scale;
+
+    // The area itself: the menus' hover box (drawChoiceBox), a thin light
+    // border around a translucent lift, set just outside the part. A soft
+    // dark edge keeps the light border readable on the cream casing. Over
+    // the pale computer the box is stronger than in the menus (solid) so it
+    // stands out; beside it, on the dark backdrop, the menus' own strength.
+    auto frame = [&](const QRectF &r, bool solid) {
+        const QRectF box    = r.adjusted(-out, -out, out, out);
+        const qreal  radius = 9 * l.scale;
+        p.setBrush(Qt::NoBrush);
+        p.setPen(QPen(QColor(0, 0, 0, solid ? 78 : 34), 4 * l.scale));
+        p.drawRoundedRect(box.adjusted(-l.scale, -l.scale, l.scale, l.scale), radius + l.scale, radius + l.scale);
+        p.setPen(QPen(QColor(255, 255, 255, solid ? 255 : 225), std::max(1.0, (solid ? 1.6 : 1.3) * l.scale)));
+        p.setBrush(solid ? QColor(255, 255, 255, 84) : PopupTheme::hover());
+        p.drawRoundedRect(box, radius, radius);
+    };
+    // One tag: the part's name, then what it is for in plainer type. Centred
+    // on c, as far as the right-hand limit allows.
+    auto tag = [&](const QPointF &c, qreal limit, const QString &name, const QString &text) {
+        const qreal h     = std::max(metrics.height(), plainMetrics.height()) + 7 * l.scale;
+        const qreal nameW = name.isEmpty() ? 0 : metrics.horizontalAdvance(name) + 9 * l.scale;
+        const qreal w     = nameW + plainMetrics.horizontalAdvance(text) + h;
+        QRectF box(c.x() - w / 2, c.y() - h / 2, w, h);
+        if (box.right() > limit) box.moveRight(limit);
+        p.setPen(QPen(calloutInk(), 1));
+        p.setBrush(QColor(19, 19, 28, 215));
+        p.drawRoundedRect(box, h / 2, h / 2);
+        p.setFont(font);
+        p.setPen(calloutInk());
+        p.drawText(QRectF(box.left() + h / 2, box.top(), nameW + 2, h), Qt::AlignVCenter | Qt::AlignLeft, name);
+        p.setFont(plain);
+        p.setPen(QColor(240, 234, 222, 205));
+        p.drawText(QRectF(box.left() + h / 2 + nameW, box.top(), w, h), Qt::AlignVCenter | Qt::AlignLeft, text);
+    };
+
+    const HintArea *all = hintAreas();
+    for (int i = 0; i < HintAreaCount; ++i) {
+        const QRectF r = hintRect(l, all[i]);
+        frame(r, true);
+        tag(QPointF(l.cabinet.left() + all[i].tag.x() * l.scale, l.cabinet.top() + all[i].tag.y() * l.scale),
+            r.right() + 44 * l.scale, hintName(all[i].hot, front), hintText(all[i].hot, front));
+    }
+    if (!power.isEmpty()) {
+        frame(power, false);
+        tag(QPointF(power.center().x(), power.top() - out - 23 * l.scale), power.right() + out, QString(),
+            QStringLiteral("Switch on or off"));
+    }
+    p.restore();
+}
+
+// The side of the window's corner controls (exit, fullscreen, zoom and the
+// parts mark), in logical pixels: they grow with the window, as the cabinet
+// does. The artwork for them is drawn on a 34-unit grid and scaled to this.
+inline int cornerSide(qreal scale) { return std::max(33, qRound(51 * scale)); }
+
+// What this program is and whose work it stands on: the cabinet has no menu
+// bar, so no About box. A small card in the tags' style, just above the
+// corner mark and sized like it, by the window rather than by the view.
+inline void paintCredits(QPainter &p, const QSize &size, qreal opacity)
+{
+    if (opacity <= 0) return;
+    const qreal s    = restLayout(size).scale;
+    const int   side = cornerSide(s); // the corner mark, as placed by AmstradHints
+    const int   gap  = std::max(8, qRound(16 * s));
+    p.save();
+    p.setRenderHint(QPainter::Antialiasing, true);
+    p.setOpacity(opacity);
+    QFont title = p.font();
+    title.setPixelSize(std::max(8, qRound(10 * s)));
+    title.setBold(true);
+    title.setLetterSpacing(QFont::AbsoluteSpacing, 1.0);
+    QFont plain = p.font();
+    plain.setPixelSize(std::max(9, qRound(11 * s)));
+    const QFontMetricsF titleMetrics(title), plainMetrics(plain);
+
+    const QString name = QStringLiteral("AMSTRAD PC1512/1640 EMULATOR");
+    const QString lines[] = {
+        QStringLiteral("by Andrés del Campo Novales"),
+#ifdef EMU_VERSION_MAJ
+        QStringLiteral("Built on 86Box %1").arg(EMU_VERSION_MAJ),
+#else
+        QStringLiteral("Built on 86Box"),
+#endif
+        // The release the shader was ported from: the IBMulator pin in UPSTREAM.md.
+        QStringLiteral("CRT shader from IBMulator 0.20"),
+        QStringLiteral("Free software, GPL-3.0-or-later"),
+    };
+    // Quiet and compact: lines set closer than the font's own leading.
+    const qreal pad = 8 * s, lineH = plain.pixelSize() * 1.28, nameH = title.pixelSize() * 1.28 + 3 * s;
+    qreal w = titleMetrics.horizontalAdvance(name);
+    for (const QString &line : lines) w = std::max(w, plainMetrics.horizontalAdvance(line));
+    w += 2 * pad;
+    const qreal h = nameH + lineH * qreal(std::size(lines)) + 2 * pad;
+    const QRectF box(size.width() - gap - w, size.height() - gap - side - 6 * s - h, w, h);
+    QColor ink = calloutInk();
+    ink.setAlpha(90);
+    p.setPen(QPen(ink, 1));
+    p.setBrush(QColor(19, 19, 28, 215));
+    p.drawRoundedRect(box, 7 * s, 7 * s);
+    ink.setAlpha(215);
+    p.setFont(title);
+    p.setPen(ink);
+    p.drawText(QRectF(box.left() + pad, box.top() + pad, w, nameH), Qt::AlignTop | Qt::AlignLeft, name);
+    p.setFont(plain);
+    p.setPen(QColor(240, 234, 222, 165));
+    qreal y = box.top() + pad + nameH;
+    for (const QString &line : lines) {
+        p.drawText(QRectF(box.left() + pad, y, w, lineH), Qt::AlignVCenter | Qt::AlignLeft, line);
+        y += lineH;
+    }
+    p.restore();
+}
+
+}
+
+// Covers the renderer while the parts are being shown. Never takes input.
+class AmstradHintAreas : public QWidget {
+public:
+    explicit AmstradHintAreas(QWidget *parent) : QWidget(parent)
+    {
+        setAttribute(Qt::WA_TranslucentBackground);
+        setAttribute(Qt::WA_TransparentForMouseEvents);
+        setFocusPolicy(Qt::NoFocus);
+        hide();
+    }
+    qreal          opacity = 0;
+    amstrad::Front front;
+    QRectF         power; // the power close-up, in this widget's coordinates
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        amstrad::paintHintAreas(p, amstrad::sceneLayout(size()), front, opacity, power);
+        amstrad::paintCredits(p, size(), opacity);
+    }
+};
+
+// The corner mark. Resting the pointer on it shows the parts; they linger a
+// moment after it leaves, long enough for the eye to travel, then fade.
+class AmstradHints : public QWidget {
+public:
+    explicit AmstradHints(QWidget *parent) : QWidget(parent)
+    {
+        areas = new AmstradHintAreas(parent);
+        setObjectName("amstradHints");
+        setAttribute(Qt::WA_TranslucentBackground);
+        setMouseTracking(true);
+        setFocusPolicy(Qt::NoFocus);
+        setAccessibleName(tr("Show cabinet controls"));
+        setAccessibleDescription(tr("Rest the pointer here to see which parts of the cabinet open controls."));
+        // AMSTRAD_HINTS=0 removes the mark. Automated runs compare pictures:
+        // off there unless AMSTRAD_HINTS=1 asks for it.
+        const QString mode = qEnvironmentVariable("AMSTRAD_HINTS");
+        enabled = mode == "1" || (mode != "0" && qEnvironmentVariableIntValue("AMSTRAD_HEADLESS") != 1);
+        linger.setSingleShot(true);
+        linger.setInterval(600);
+        connect(&linger, &QTimer::timeout, this, [this] { fade(0, 380); });
+        connect(&animation, &QVariantAnimation::valueChanged, this, [this](const QVariant &v) {
+            areas->opacity = v.toReal();
+            areas->update();
+            if (areas->opacity <= 0 && !hovered) areas->hide();
+        });
+        // The guest takes and releases the mouse without telling this widget.
+        watch.setInterval(250);
+        connect(&watch, &QTimer::timeout, this, [this] { place(); });
+        watch.start();
+        hide();
+    }
+
+    // True while the guest has the mouse: the mark is then out of reach, so hidden.
+    std::function<bool()> blocked;
+    // The machine as fitted, for the left bay's name.
+    std::function<amstrad::Front()> front;
+    // Shown or dismissed; lets the renderer bring the power close-up along.
+    std::function<void(bool)> showing;
+    // Where that close-up is, in the parent's coordinates, once shown.
+    std::function<QRectF()> powerArea;
+
+    bool areasVisible() const { return areas->isVisible() && areas->opacity > 0; }
+    const AmstradHintAreas *overlay() const { return areas; }
+    // The parts moved (the view changed): redraw their outlines where they are now.
+    void refresh() { areas->update(); }
+
+    // Bottom-right corner of the scene, scaled with the cabinet.
+    void place()
+    {
+        if (!parentWidget()) return;
+        const auto  l    = amstrad::restLayout(parentWidget()->size());
+        const int   side = amstrad::cornerSide(l.scale);
+        const int   gap  = std::max(8, qRound(16 * l.scale));
+        setGeometry(parentWidget()->width() - side - gap, parentWidget()->height() - side - gap, side, side);
+        areas->setGeometry(parentWidget()->rect());
+        const bool available = enabled && !(blocked && blocked());
+        if (!available && hovered) leave();
+        if (available != isVisible()) setVisible(available);
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        const qreal  s = width() / 34.0;
+        const QRectF ring(5 * s, 5 * s, 24 * s, 24 * s);
+        QColor ink = amstrad::calloutInk();
+        ink.setAlpha(hovered ? 225 : 105);
+        if (hovered) {
+            p.setPen(Qt::NoPen);
+            p.setBrush(QColor(240, 234, 222, 26));
+            p.drawEllipse(ring.adjusted(-3 * s, -3 * s, 3 * s, 3 * s));
+        }
+        p.setBrush(Qt::NoBrush);
+        p.setPen(QPen(ink, 1.3 * s));
+        p.drawEllipse(ring);
+        QFont font = p.font();
+        font.setPixelSize(std::max(10, qRound(15 * s)));
+        font.setBold(true);
+        p.setFont(font);
+        p.setPen(ink);
+        p.drawText(ring.adjusted(.5 * s, 0, 0, 0), Qt::AlignCenter, QStringLiteral("?"));
+    }
+
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+    void enterEvent(QEnterEvent *) override
+#else
+    void enterEvent(QEvent *) override
+#endif
+    {
+        hovered = true;
+        linger.stop();
+        if (front) areas->front = front();
+        areas->setGeometry(parentWidget()->rect());
+        areas->show();
+        areas->stackUnder(this);
+        fade(1, 140);
+        if (showing) showing(true);
+        areas->power = powerArea ? powerArea() : QRectF();
+        update();
+    }
+    void leaveEvent(QEvent *) override { leave(); }
+    // Keep moves and clicks from reaching the cabinet beneath.
+    void mouseMoveEvent(QMouseEvent *e) override { e->accept(); }
+    void mousePressEvent(QMouseEvent *e) override { e->accept(); }
+    void mouseReleaseEvent(QMouseEvent *e) override { e->accept(); }
+
+private:
+    void leave()
+    {
+        if (!hovered) return;
+        hovered = false;
+        linger.start();
+        if (showing) showing(false);
+        update();
+    }
+    void fade(qreal to, int ms)
+    {
+        animation.stop();
+        animation.setDuration(ms);
+        animation.setStartValue(areas->opacity);
+        animation.setEndValue(to);
+        animation.start();
+    }
+
+    AmstradHintAreas *areas = nullptr;
+    bool              enabled = true, hovered = false;
+    QTimer            linger, watch;
+    QVariantAnimation animation;
+};
+
+// Matching corner controls for closing the app, changing window mode and
+// switching between the whole computer and the monitor close-up.
+class AmstradCornerButton : public QWidget {
+public:
+    enum Role { Exit, Fullscreen, Zoom }; // in this order from the right-hand corner
+    explicit AmstradCornerButton(QWidget *parent, Role role) : QWidget(parent), role(role)
+    {
+        setObjectName(role == Exit ? "amstradExit" : role == Zoom ? "amstradZoom" : "amstradFullscreen");
+        setAttribute(Qt::WA_TranslucentBackground);
+        setFocusPolicy(Qt::NoFocus);
+        if (role == Exit) {
+            setAccessibleName(tr("Exit emulator"));
+            setToolTip(tr("Exit emulator"));
+        }
+        watch.setInterval(250);
+        connect(&watch, &QTimer::timeout, this, [this] { place(); });
+        watch.start();
+        hide();
+    }
+
+    std::function<bool()> blocked;
+    std::function<bool()> fullscreen;
+    std::function<bool()> zoomed;
+    std::function<void()> activate;
+
+    void place()
+    {
+        if (!parentWidget()) return;
+        const auto l = amstrad::restLayout(parentWidget()->size());
+        const int side = amstrad::cornerSide(l.scale);
+        const int gap = std::max(8, qRound(16 * l.scale));
+        setGeometry(parentWidget()->width() - side - gap - int(role) * (side + side / 8), gap, side, side);
+        if (role != Exit) {
+            const bool on = role == Zoom ? zoomed && zoomed() : fullscreen && fullscreen();
+            const QString label = role == Zoom ? (on ? tr("Show the whole computer (Ctrl+F11)")
+                                                     : tr("Zoom in on the monitor (Ctrl+F11)"))
+                                               : on ? tr("Exit fullscreen") : tr("Enter fullscreen");
+            if (accessibleName() != label) {
+                setAccessibleName(label);
+                setToolTip(label);
+                update();
+            }
+        }
+        const bool available = !(blocked && blocked());
+        if (!available) { hovered = false; pressed = false; }
+        if (available != isVisible()) setVisible(available);
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        const qreal s = width() / 34.0;
+        const QRectF ring(5 * s, 5 * s, 24 * s, 24 * s);
+        QColor ink = amstrad::calloutInk();
+        ink.setAlpha(hovered ? 225 : 105);
+        if (hovered) {
+            p.setPen(Qt::NoPen);
+            p.setBrush(QColor(240, 234, 222, 26));
+            p.drawEllipse(ring.adjusted(-3 * s, -3 * s, 3 * s, 3 * s));
+        }
+        p.setBrush(Qt::NoBrush);
+        p.setPen(QPen(ink, 1.3 * s));
+        p.drawEllipse(ring);
+        if (role == Exit) {
+            p.drawLine(QPointF(13 * s, 13 * s), QPointF(21 * s, 21 * s));
+            p.drawLine(QPointF(21 * s, 13 * s), QPointF(13 * s, 21 * s));
+        } else if (role == Zoom) {
+            // A magnifying glass: plus to close in, minus to step back.
+            const QPointF lens(15.5 * s, 15.5 * s);
+            p.drawEllipse(lens, 5 * s, 5 * s);
+            p.drawLine(QPointF(19.3 * s, 19.3 * s), QPointF(23 * s, 23 * s));
+            p.drawLine(lens - QPointF(2.4 * s, 0), lens + QPointF(2.4 * s, 0));
+            if (!(zoomed && zoomed()))
+                p.drawLine(lens - QPointF(0, 2.4 * s), lens + QPointF(0, 2.4 * s));
+        } else if (fullscreen && fullscreen()) {
+            // Four inward-facing corners indicate a return to the window.
+            for (int x : {0, 1}) for (int y : {0, 1}) {
+                const qreal cx = (x ? 19 : 15) * s, cy = (y ? 19 : 15) * s;
+                p.drawLine(QPointF(cx, cy), QPointF(cx + (x ? -4 : 4) * s, cy));
+                p.drawLine(QPointF(cx, cy), QPointF(cx, cy + (y ? -4 : 4) * s));
+            }
+        } else {
+            // Four outward-facing corners indicate expansion to fullscreen.
+            for (int x : {0, 1}) for (int y : {0, 1}) {
+                const qreal cx = (x ? 22 : 12) * s, cy = (y ? 22 : 12) * s;
+                p.drawLine(QPointF(cx, cy), QPointF(cx + (x ? -4 : 4) * s, cy));
+                p.drawLine(QPointF(cx, cy), QPointF(cx, cy + (y ? -4 : 4) * s));
+            }
+        }
+    }
+
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+    void enterEvent(QEnterEvent *) override
+#else
+    void enterEvent(QEvent *) override
+#endif
+    { hovered = true; update(); }
+    void leaveEvent(QEvent *) override { hovered = false; pressed = false; update(); }
+    void mousePressEvent(QMouseEvent *e) override
+    {
+        pressed = e->button() == Qt::LeftButton;
+        e->accept();
+    }
+    void mouseReleaseEvent(QMouseEvent *e) override
+    {
+        const bool activate = pressed && e->button() == Qt::LeftButton && rect().contains(e->pos());
+        pressed = false;
+        e->accept();
+        if (activate && this->activate) this->activate();
+    }
+
+private:
+    bool hovered = false, pressed = false;
+    Role role;
+    QTimer watch;
+};
+#endif
