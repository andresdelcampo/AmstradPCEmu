+void
+MainWindow::showAmstradMenu(QPoint pos, QPoint globalPos)
+{
+    auto *sw = ui->stackedWidget->softwareRenderer();
+    if (!sw || !sw->hasCabinet())
+        return;
+    /* The cabinet layout is proportional, so logical pixels work as well as device ones. */
+    const auto hot   = amstrad::hotspot(amstrad::sceneLayout(ui->stackedWidget->size()), QPointF(pos));
+    const auto front = SoftwareRenderer::machineFront();
+    if (hot == amstrad::HotNone)
+        return;
+
+    /* Pictures are crops of the cabinet as each option would look, in master pixels. */
+    const qreal  ratio = devicePixelRatioF();
+    const QSize  box(amstrad::MenuCard::PictureBox, 103);
+    const QRectF lowerFront(150, 990, 956, 256); /* both bays and the model badge */
+    auto bayCrop = [](int bay) { return amstrad::masterBay(bay).adjusted(-6, -6, 6, -30); };
+    auto picture = [&](const amstrad::Front &f, const QRectF &rect, int leftFace = -1, int rightFace = -1) {
+        return amstrad::menuPicture(sw->frontPreview(f, rect, leftFace, rightFace), box, ratio);
+    };
+
+    amstrad::CabinetMenu menu(this);
+    menu.setSeparatorsCollapsible(true);
+
+    /* A floppy drive: its face with the current disk, then the Media actions
+       except the 86F export. */
+    auto addFloppy = [&](int drive) {
+        const fdd_drive_t &d    = drives[drive];
+        const QString      path = QString::fromUtf8(d.image_path);
+        const bool         empty = path.isEmpty();
+        const int          bay   = (front.left == amstrad::BayFloppy && drive == 0) ? 0 : 1;
+        const int          face  = empty ? amstrad::DriveOpen : amstrad::diskColour(path);
+        QString            text  = empty ? tr("No disk. Insert an image below.")
+                                         : QFileInfo(path).fileName();
+        if (!empty && (d.read_only || d.writeprot))
+            text += tr("  Â·  write-protected");
+        amstrad::addCard(&menu, picture(front, bayCrop(bay), bay == 0 ? face : -1, bay == 1 ? face : -1),
+                         tr("Drive %1:  5Â¼\" 360K").arg(QChar('A' + drive)), text);
+        auto *grid = amstrad::addGrid(&menu);
+        amstrad::addTile(grid, amstrad::diskPicture(tr("CHOOSE DISK"), QColor("#353b40"), ratio),
+            tr("Choose diskâ€¦"), tr("Insert a disk image into this drive."), false,
+            [this, drive] { mm->floppySelectImage(drive, false); });
+        amstrad::addTile(grid, amstrad::diskPicture(tr("READ ONLY"), QColor("#59786c"), ratio),
+            tr("Choose protected diskâ€¦"), tr("Use an image without writing to it."), false,
+            [this, drive] { mm->floppySelectImage(drive, true); });
+        amstrad::addTile(grid, amstrad::diskPicture(tr("BLANK DISK"), QColor("#8e704e"), ratio),
+            tr("New diskâ€¦"), tr("Create a blank disk image."), false,
+            [this, drive] { mm->floppyNewImage(drive); });
+        auto *eject = amstrad::addTile(grid,
+            picture(front, bayCrop(bay), bay == 0 ? amstrad::DriveOpen : -1, bay == 1 ? amstrad::DriveOpen : -1),
+            tr("Eject disk"), empty ? tr("The drive is already empty.") : QFileInfo(path).fileName(), false,
+            [this, drive] { mm->floppyEject(drive); });
+        eject->setEnabled(!empty);
+
+        // Reuse the actual history actions: filenames, availability and mount
+        // behavior stay owned by MediaMenu, including separate A:/B: histories.
+        auto *recent = new amstrad::CabinetMenu(&menu);
+        recent->setTitle(tr("Recent disks"));
+        amstrad::addCaption(recent, tr("Recent disks"), tr("Choose a labelled disk to insert it."));
+        auto *historyGrid = amstrad::addGrid(recent);
+        int count = 0;
+        for (QAction *a : mm->floppyHistoryActions(drive)) {
+            if (!a->isVisible() || !a->isEnabled()) continue;
+            QString label = a->text();
+            // The upstream menu adds a numbered mnemonic before each path.
+            if (label.size() > 3 && label[0] == '&' && label[1].isDigit() && label[2] == ' ')
+                label.remove(0, 3);
+            if (count++ < 4) {
+                amstrad::addTile(historyGrid, amstrad::diskPicture(QFileInfo(label).fileName(), QColor("#41494e"), ratio),
+                    QFileInfo(label).fileName(), label, false, [a] { a->trigger(); });
+            } else recent->addAction(a);
+        }
+        if (count) menu.addMenu(recent);
+        else delete recent;
+    };
+
+    /* The left bay fit, which is also the model: DD, SD (plain or sticker), HD20. */
+    auto addModelChoices = [&](QMenu *target) {
+        struct Choice {
+            amstrad::LeftBay bay;
+            const char      *title, *text;
+        };
+        static const Choice choices[amstrad::LeftBayCount] = {
+            { amstrad::BayFloppy, QT_TR_NOOP("PC1512 DD"), QT_TR_NOOP("Two 5Â¼\" floppy drives: A: and B:.") },
+            { amstrad::BayBlank, QT_TR_NOOP("PC1512 SD"), QT_TR_NOOP("One floppy drive, A:. Blank plate in the left bay.") },
+            { amstrad::BayBlankSticker, QT_TR_NOOP("PC1512 SD, factory sticker"), QT_TR_NOOP("As SD, with the second-drive warning label on the plate.") },
+            { amstrad::BayHdd, QT_TR_NOOP("PC1512 HD20"), QT_TR_NOOP("20 MB hard disk C: and one floppy drive, A:.") },
+        };
+        amstrad::addCaption(target, tr("Machine configuration"), tr("PC1512 Â· Choose a drive layout. Hardware changes restart the PC."));
+        auto *grid = amstrad::addGrid(target);
+        for (const Choice &c : choices) {
+            amstrad::Front preview = front;
+            preview.left           = c.bay;
+            const int bay          = c.bay;
+            amstrad::addTile(grid, picture(preview, lowerFront), tr(c.title), tr(c.text), front.left == c.bay,
+                             [this, bay] { setAmstradLeftBay(bay); });
+        }
+    };
+
+    auto addMonitorChoices = [&](QMenu *target) {
+        auto *row = amstrad::addMonitorSelector(target);
+        const auto assets = QFileInfo(qEnvironmentVariable("AMSTRAD_CABINET")).dir();
+        const QImage tiger(assets.filePath("monitor/gem-paint-tiger.png"));
+        const QImage house = amstrad::gemPaintHouse(tiger,
+            QImage(assets.filePath("monitor/gem-house-original.png")), fontdat);
+        for (const bool mono : { false, true }) {
+            QImage sample = mono ? tiger : house;
+            if (sample.isNull()) sample = amstrad::monitorSample(fontdat);
+            amstrad::Front preview = front;
+            preview.mono           = mono;
+            const QImage art = sw->frontPreview(preview, QRectF(0,0,1254,1254));
+            row->addWidget(new amstrad::MonitorChoice(amstrad::monitorPhotograph(art, sample, mono),
+                mono, front.mono == mono, [this, mono] { setAmstradMonochrome(mono); }));
+        }
+    };
+
+    switch (hot) {
+        case amstrad::HotLeftBay: {
+            if (front.left == amstrad::BayFloppy)
+                addFloppy(0);
+            else if (front.left == amstrad::BayHdd) {
+                QString name = tr("No image attached.");
+                for (int i = 0; i < HDD_NUM; ++i)
+                    if (hdd_is_valid(i) && hdd[i].bus_type == HDD_BUS_MFM) {
+                        name = QFileInfo(QString::fromUtf8(hdd[i].fn)).fileName();
+                        break;
+                    }
+                amstrad::addCard(&menu, picture(front, bayCrop(0)), tr("Hard disk C:  20 MB"), name);
+            } else
+                amstrad::addCard(&menu, picture(front, bayCrop(0)), tr("Left bay: blank plate"),
+                                 tr("No drive fitted. Choose a fitting below."));
+            menu.addSeparator();
+            auto *bayMenu = new amstrad::CabinetMenu(&menu);
+            bayMenu->setTitle(tr("Machine configurationâ€¦"));
+            menu.addMenu(bayMenu);
+            bayMenu->setSeparatorsCollapsible(true);
+            addModelChoices(bayMenu);
+            break;
+        }
+        case amstrad::HotRightBay:
+            addFloppy(front.rightDrive());
+            break;
+        case amstrad::HotModelBadge:
+            addModelChoices(&menu);
+            break;
+        case amstrad::HotMonitorBadge:
+            addMonitorChoices(&menu);
+            break;
+        default:
+            return;
+    }
+    menu.openAt(globalPos);
+}
