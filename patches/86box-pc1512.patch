+{
+    amstrad::viewZoom() = zoom;
+    publishLayout();
+    placeControls();
+    if (hints) hints->refresh();
+    /* Paint every animation tick. The GUI can transform the latest completed
+       worker frame while a full-resolution replacement is still rendering. */
+    update();
+    /* The worker redraws the whole window for each step. If it cannot keep
+       up, steps are skipped rather than queued: it reads the latest layout. */
+    queueZoomFrame();
