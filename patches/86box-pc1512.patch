+/* HD20: a 20 MB ST-225 class disk (615/4/17) on a Western Digital
+   WD1002A-WX1 XT controller, which supports that geometry (switch type 2). */
+static constexpr int hd20_tracks = 615, hd20_heads = 4, hd20_sectors = 17;
+static const char   *hd20_controller = "st506_xt_wd1002a_wx1";
+/* The 86Box recording closest to the HD20's drive: a 1987 20 MB, 3600 RPM
+   MFM Miniscribe 8425. It is the default; Settings can change it later. */
+static const char   *hd20_audio = "MINISCRIBE_8425_3600RPM";
