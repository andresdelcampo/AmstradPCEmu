+namespace amstrad {
+
+// Change popup appearance here, for native menus and custom cabinet popups.
+// F4: strong, untinted frost. Solid is a portable fallback / optional mode.
+struct PopupTheme {
+    static constexpr bool Frosted = true;
+    static constexpr qreal BlurRadius = 180; // logical pixels, matches F4
+    static constexpr qreal CaptureScale = .25; // blur backdrop only, never controls
+    static QColor solidBackground() { return QColor("#21354f"); }
+    static QColor text() { return QColor(255,255,255); }
+    static QColor secondaryText() { return QColor(224,224,224); }
+    static QColor border() { return QColor(255,255,255,80); }
+    static QColor hover() { return QColor(255,255,255,36); }
+    static QColor shadow() { return QColor(0,0,0,220); }
+};
+
+inline void drawPopupText(QPainter &p, const QRectF &rect, int flags,
+                          const QString &text, QColor colour = PopupTheme::text())
+{
+    p.setPen(PopupTheme::shadow());
+    p.drawText(rect.translated(1,1),flags,text);
+    p.setPen(colour);
+    p.drawText(rect,flags,text);
+}
+
+inline QImage blurPopupImage(const QImage &source, qreal radius)
+{
+    QGraphicsScene scene;
+    auto *item = scene.addPixmap(QPixmap::fromImage(source));
+    auto *effect = new QGraphicsBlurEffect;
+    effect->setBlurRadius(radius);
+    effect->setBlurHints(QGraphicsBlurEffect::QualityHint);
+    item->setGraphicsEffect(effect);
+    QImage result(source.size(),QImage::Format_ARGB32_Premultiplied);
+    result.fill(Qt::transparent);
+    QPainter painter(&result);
+    scene.render(&painter,QRectF(result.rect()),QRectF(source.rect()));
+    return result;
+}
+
+class PopupBackdrop {
+public:
+    void invalidate() { image = {}; }
+    bool ready() const { return !image.isNull(); }
+    bool matches(const QPoint &origin, const QSize &size, const QSize &sourceSize) const
+    { return ready() && origin == location && size == extent && sourceSize == capturedSourceSize; }
+
+    // Capture only the owning application's widget tree. No desktop capture,
+    // OS compositor APIs, saved screenshots or cross-platform native handles.
+    // Power's child popup excludes children to avoid capturing itself.
+    bool capture(QWidget *source, const QPoint &origin, const QSize &size, bool children = true)
+    {
+        invalidate();
+        if (!PopupTheme::Frosted || !source || size.isEmpty() || source->size().isEmpty()) return false;
+        const qreal scale = PopupTheme::CaptureScale;
+        QImage snapshot(QSize(std::max(1,int(std::ceil(source->width()*scale))),
+                              std::max(1,int(std::ceil(source->height()*scale)))), QImage::Format_RGB32);
+        snapshot.fill(PopupTheme::solidBackground());
+        {
+            QPainter painter(&snapshot);
+            painter.scale(scale,scale);
+            auto flags = QWidget::RenderFlags(QWidget::DrawWindowBackground);
+            if (children) flags |= QWidget::DrawChildren;
+            source->render(&painter,QPoint(),QRegion(),flags);
+        }
+        const int pad = int(std::ceil(PopupTheme::BlurRadius*2));
+        const QPointF sampleOrigin = QPointF(origin-source->mapToGlobal(QPoint())-QPoint(pad,pad))*scale;
+        const QSize sampleSize(int(std::ceil((size.width()+2*pad)*scale)),
+                               int(std::ceil((size.height()+2*pad)*scale)));
+        QImage sample(sampleSize,QImage::Format_RGB32);
+        // Extend edge pixels when a menu overhangs the app. This also prevents
+        // transparent blur-kernel edges from introducing a dark rim or tint.
+        for (int y=0; y<sample.height(); ++y) {
+            const auto *in = reinterpret_cast<const QRgb *>(snapshot.constScanLine(
+                std::clamp(int(std::floor(sampleOrigin.y()))+y,0,snapshot.height()-1)));
+            auto *out = reinterpret_cast<QRgb *>(sample.scanLine(y));
+            for (int x=0; x<sample.width(); ++x)
+                out[x] = in[std::clamp(int(std::floor(sampleOrigin.x()))+x,0,snapshot.width()-1)];
+        }
+        const QImage blurred = blurPopupImage(sample,PopupTheme::BlurRadius*scale);
+        image = blurred.copy(QRect(qRound(pad*scale),qRound(pad*scale),
+                                   std::max(1,int(std::ceil(size.width()*scale))),
+                                   std::max(1,int(std::ceil(size.height()*scale))))).convertToFormat(QImage::Format_RGB32);
+        location = origin; extent = size; capturedSourceSize = source->size();
+        return ready();
+    }
+
+    void paint(QPainter &painter, const QRectF &target) const
+    {
+        if (!ready()) { painter.fillRect(target,PopupTheme::solidBackground()); return; }
+        painter.save();
+        painter.setRenderHint(QPainter::SmoothPixmapTransform);
+        painter.drawImage(target,image);
+        painter.restore();
+    }
+private:
+    QImage image;
+    QPoint location;
+    QSize extent, capturedSourceSize;
+};
+
+inline QWidget *popupSource(QMenu *menu)
+{
+    for (QWidget *widget=menu->parentWidget(); widget; widget=widget->parentWidget())
+        if (widget->isWindow() && !qobject_cast<QMenu *>(widget)) return widget;
+    return nullptr;
+}
+
+class PopupMenuData : public QObject {
+public:
+    explicit PopupMenuData(QMenu *menu) : QObject(menu) { setObjectName("amstradPopupSurface"); }
+    PopupBackdrop backdrop;
+    bool capturing = false;
+};
+
+inline PopupMenuData *popupData(QMenu *menu)
+{
+    auto *data = dynamic_cast<PopupMenuData *>(menu->findChild<QObject *>("amstradPopupSurface",Qt::FindDirectChildrenOnly));
+    return data ? data : new PopupMenuData(menu);
+}
+
+inline void configurePopupMenu(QMenu *menu, int padding)
+{
+    menu->setProperty("amstradPopupPadding",padding);
+    QPalette palette = menu->palette();
+    palette.setColor(QPalette::Window,Qt::transparent);
+    palette.setColor(QPalette::Base,Qt::transparent);
+    palette.setColor(QPalette::Text,PopupTheme::text());
+    palette.setColor(QPalette::WindowText,PopupTheme::text());
+    palette.setColor(QPalette::ButtonText,PopupTheme::text());
+    palette.setColor(QPalette::HighlightedText,PopupTheme::text());
+    palette.setColor(QPalette::Highlight,PopupTheme::hover());
+    palette.setColor(QPalette::Disabled,QPalette::Text,QColor(185,185,185));
+    menu->setPalette(palette);
+    menu->setStyleSheet(QStringLiteral(
+        "QMenu { background:transparent; color:white; border:1px solid rgba(255,255,255,80); padding:%1px; }"
+        "QMenu::item { background:transparent; padding:8px 20px; }"
+        "QMenu::item:selected { background:transparent; }"
+        "QMenu::item:disabled { color:#b9b9b9; }").arg(padding));
+}
+
+// QMenu still owns action geometry, input, focus, keyboard navigation and
+// submenu placement. This filter replaces only painting, with sharp native
+// action glyphs over a cached frosted backdrop and a one-pixel text shadow.
+class PopupMenuFilter : public QObject {
+public:
+    explicit PopupMenuFilter(QObject *parent) : QObject(parent) {}
+protected:
+    bool eventFilter(QObject *object, QEvent *event) override
+    {
+        auto *menu = qobject_cast<QMenu *>(object);
+        if (!menu) return false;
+        if (event->type() == QEvent::Show) {
+            configurePopupMenu(menu,menu->property("amstradPopupPadding").isValid()
+                                    ? menu->property("amstradPopupPadding").toInt() : 10);
+            popupData(menu)->backdrop.invalidate();
+        } else if (event->type() == QEvent::Hide) {
+            popupData(menu)->backdrop.invalidate();
+        } else if (event->type() == QEvent::Paint) {
+            auto *data = popupData(menu);
+            if (data->capturing) return false;
+            QWidget *source = popupSource(menu);
+            const QPoint origin = menu->mapToGlobal(QPoint());
+            if (source && !data->backdrop.matches(origin,menu->size(),source->size())) {
+                data->capturing = true;
+                data->backdrop.capture(source,origin,menu->size());
+                data->capturing = false;
+            }
+            menu->setProperty("amstradFrostReady",data->backdrop.ready());
+            QPainter painter(menu);
+            data->backdrop.paint(painter,QRectF(menu->rect()));
+            painter.setPen(QPen(PopupTheme::border(),1));
+            painter.drawRect(QRectF(menu->rect()).adjusted(.5,.5,-.5,-.5));
+            paintActions(menu,painter);
+            return true;
+        }
+        return false;
+    }
+private:
+    static void paintActions(QMenu *menu,QPainter &painter)
+    {
+        int iconWidth = 0, shortcutWidth = 0;
+        bool checkable = false;
+        for (QAction *action : menu->actions()) {
+            if (!action->isVisible()) continue;
+            checkable |= action->isCheckable();
+            if (!action->icon().isNull()) iconWidth = menu->style()->pixelMetric(QStyle::PM_SmallIconSize,nullptr,menu);
+            shortcutWidth = std::max(shortcutWidth,QFontMetrics(menu->font()).horizontalAdvance(action->shortcut().toString(QKeySequence::NativeText)));
+        }
+        for (QAction *action : menu->actions()) {
+            if (!action->isVisible() || qobject_cast<QWidgetAction *>(action)) continue;
+            const QRect area = menu->actionGeometry(action);
+            if (area.isEmpty()) continue;
+            if (action->isSeparator()) {
+                if (!action->text().isEmpty()) {
+                    QFont font=menu->font(); font.setBold(true); painter.setFont(font);
+                    drawPopupText(painter,area.adjusted(8,0,-8,0),Qt::AlignLeft|Qt::AlignVCenter,action->text());
+                } else {
+                    painter.setPen(PopupTheme::border());
+                    painter.drawLine(area.left()+8,area.center().y(),area.right()-8,area.center().y());
+                }
+                continue;
+            }
+            if (menu->activeAction()==action && action->isEnabled()) painter.fillRect(area,PopupTheme::hover());
+            QStyleOptionMenuItem option;
+            option.initFrom(menu);
+            option.rect = QRect(QPoint(),area.size());
+            option.menuRect = menu->rect();
+            option.menuItemType = action->menu() ? QStyleOptionMenuItem::SubMenu : QStyleOptionMenuItem::Normal;
+            option.checkType = action->isCheckable() ? QStyleOptionMenuItem::NonExclusive : QStyleOptionMenuItem::NotCheckable;
+            if (action->isCheckable() && action->actionGroup() && action->actionGroup()->isExclusive())
+                option.checkType = QStyleOptionMenuItem::Exclusive;
+            option.checked = action->isChecked();
+            option.menuHasCheckableItems = checkable;
+            option.maxIconWidth = iconWidth;
+#if QT_VERSION >= QT_VERSION_CHECK(6,0,0)
+            option.reservedShortcutWidth = shortcutWidth;
+#else
+            option.tabWidth = shortcutWidth;
+#endif
+            option.text = action->text();
+            if (!action->shortcut().isEmpty() && !option.text.contains('\t'))
+                option.text += '\t' + action->shortcut().toString(QKeySequence::NativeText);
+            option.icon = action->icon();
+            option.font = action->font().resolve(menu->font());
+            option.fontMetrics = QFontMetrics(option.font);
+            option.state &= ~(QStyle::State_Selected | QStyle::State_Sunken);
+            if (!action->isEnabled()) option.state &= ~QStyle::State_Enabled;
+            const qreal ratio = menu->devicePixelRatioF();
+            QImage ink(QSize(qCeil(area.width()*ratio),qCeil(area.height()*ratio)),QImage::Format_ARGB32_Premultiplied);
+            ink.setDevicePixelRatio(ratio); ink.fill(Qt::transparent);
+            {
+                QPainter glyphs(&ink);
+                menu->style()->drawControl(QStyle::CE_MenuItem,&option,&glyphs,menu);
+            }
+            QImage shadow = ink.copy();
+            for (int y=0; y<shadow.height(); ++y) {
+                auto *row = reinterpret_cast<QRgb *>(shadow.scanLine(y));
+                for (int x=0; x<shadow.width(); ++x) row[x] = qRgba(0,0,0,qAlpha(row[x])*4/5);
+            }
+            painter.drawImage(area.topLeft()+QPoint(1,1),shadow);
+            painter.drawImage(area.topLeft(),ink);
+        }
+    }
+};
+
+inline void installPopupTheme()
+{
+    if (!qApp || qApp->property("amstradPopupThemeInstalled").toBool()) return;
+    qApp->setProperty("amstradPopupThemeInstalled",true);
+    qApp->installEventFilter(new PopupMenuFilter(qApp));
+}
+
+inline void stylePopupMenu(QMenu *menu,int padding=10)
+{
+    installPopupTheme();
+    configurePopupMenu(menu,padding);
+}
+
+}
+#endif
