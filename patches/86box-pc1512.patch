+// One choice for the computer and one for its left bay; the bay list is
+// named for the computer fitted. Each is applied on its own.
+struct MachinePanel {
+    Front front;                                    // as fitted now
+    std::function<QPixmap(const Front &)> unit;     // the system unit's front (unitPicture)
+    std::function<void(bool,int)> choose;           // PC1640?, left bay
+};
+inline void addMachinePanel(QMenu *menu, const MachinePanel &panel)
+{
+    auto tr = [](const char *text) { return QCoreApplication::translate("MainWindow",text); };
+    struct Bay { LeftBay bay; const char *suffix, *text; };
+    static const Bay bays[LeftBayCount] = {
+        { BayFloppy, QT_TRANSLATE_NOOP("MainWindow","DD"), QT_TRANSLATE_NOOP("MainWindow","Two 5¼\" floppy drives: A: and B:.") },
+        { BayBlank, QT_TRANSLATE_NOOP("MainWindow","SD"), QT_TRANSLATE_NOOP("MainWindow","One floppy drive, A:. Blank plate in the left bay.") },
+        { BayBlankSticker, QT_TRANSLATE_NOOP("MainWindow","SD, factory sticker"), QT_TRANSLATE_NOOP("MainWindow","As SD, with the second-drive warning label on the plate.") },
+        { BayHdd, QT_TRANSLATE_NOOP("MainWindow","HD20"), QT_TRANSLATE_NOOP("MainWindow","20 MB hard disk C: and one floppy drive, A:.") },
+    };
+    const Front &front = panel.front;
+    addCaption(menu, tr("Machine configuration"),
+               tr("Choose the computer, and the drives fitted in it. Hardware changes restart the PC."), 16);
+    auto *grid = addGrid(menu);
+    grid->setHorizontalSpacing(8); grid->setVerticalSpacing(0);
+    int row = 0;
+    grid->addWidget(new MenuCaption(tr("Computer"),{},true,ConfigChoice::Width,16),row++,0,1,2);
+    for (const bool pc1640 : { false, true })
+        grid->addWidget(new MachineChoice(pc1640 ? "1640" : "1512", pc1640 ? "PC1640" : "PC1512",
+            pc1640 ? tr("640K memory\nEGA graphics") : tr("512K memory\nCGA graphics"), front.pc1640 == pc1640,
+            [choose = panel.choose, pc1640, bay = int(front.left)] { choose(pc1640,bay); }),row,pc1640);
+    ++row;
+    const QString name = front.pc1640 ? QStringLiteral("PC1640 ") : QStringLiteral("PC1512 ");
+    grid->addWidget(new MenuCaption(tr("Drives"),{},true,ConfigChoice::Width,16),row++,0,1,2);
+    for (const Bay &b : bays) {
+        Front preview = front; preview.left = b.bay;
+        grid->addWidget(new ConfigChoice(panel.unit(preview), name+tr(b.suffix), tr(b.text), front.left == b.bay,
+            [choose = panel.choose, pc1640 = front.pc1640, bay = int(b.bay)] { choose(pc1640,bay); }),row++,0,1,2);
+    }
+}
+// ---- The disk box: floppies as pictures, shared by tiles and the drive card ----
+// Artwork is in the 924 x 895 frame of scripts/make-disk-assets.ps1.
+struct DiskArt {
+    QImage sleeved[DiskBox::SystemDiscs], bare[DiskBox::SystemDiscs], black;
+    // A plain jacket with a blank label, should a picture be missing.
+    static QImage plain(const QColor &jacket)
+    {
+        QImage image(640,620,QImage::Format_ARGB32_Premultiplied); image.fill(Qt::transparent);
+        QPainter p(&image); p.setRenderHint(QPainter::Antialiasing); p.scale(640/924.0,620/895.0); p.setPen(Qt::NoPen);
+        p.setBrush(jacket); p.drawRoundedRect(QRectF(46,35,825,825),5,5);
+        p.setBrush(QColor("#f1ead9")); p.drawRoundedRect(QRectF(92,64,630,222),9,9);
+        p.setBrush(QColor("#1d1917")); p.drawEllipse(QPointF(458.5,447.5),123,123); p.drawRoundedRect(QRectF(419,599,78,207),39,39);
+        return image;
+    }
+    static const DiskArt &load(const QString &folder)
+    {
+        static DiskArt art; static QString loaded;
+        if (loaded == folder && !art.black.isNull()) return art;
+        static const char *const ids[DiskBox::SystemDiscs] = { "msdos-1", "gem-startup-2", "gem-desktop-3", "dosplus-4", "hdutils-5" };
+        static const char *const jackets[DiskBox::SystemDiscs] = { "#c81e28", "#2a69bb", "#1b8f4b", "#ebcb28", "#72389b" };
+        auto read = [&](const QString &name, const char *jacket) {
+            const QImage image(QDir(folder).filePath(name));
+            return image.isNull() ? plain(QColor(jacket)) : image.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+        };
+        for (int n = 0; n < DiskBox::SystemDiscs; ++n) {
+            art.sleeved[n] = read(QString("disk-%1.png").arg(ids[n]), jackets[n]);
+            art.bare[n] = read(QString("disk-%1-bare.png").arg(ids[n]), jackets[n]);
+        }
+        art.black = read("disk-generic-black-bare.png", "#28282b");
+        loaded = folder; return art;
+    }
+};
+struct DiskFace {
+    QPixmap picture;
+    QString label;        // written on the blank label of a black disk
+    bool action = false;  // "Open" / "New": printed, not handwritten
+    bool tab = false;     // write-protect tab over the notch
+    bool notchLit = false;
+    static QPixmap scaled(const QImage &art, int width, qreal ratio)
+    {
+        QPixmap p = QPixmap::fromImage(art.scaledToWidth(qRound(width*ratio),Qt::SmoothTransformation));
+        p.setDevicePixelRatio(ratio); return p;
+    }
+};
+inline QRectF diskPart(const QRectF &t,qreal x,qreal y,qreal w,qreal h)
+{ return QRectF(t.x()+t.width()*x/924,t.y()+t.height()*y/895,t.width()*w/924,t.height()*h/895); }
+// The area that takes clicks for the tab: the notch is far too small itself.
+inline QRectF diskNotchZone(const QRectF &t)
+{
+    const QPointF c = diskPart(t,848,222,23,62).center();
+    const qreal r = std::max<qreal>(13,t.width()*.1);
+    return QRectF(c.x()-r,c.y()-r,2*r,2*r);
+}
+// Wrapped text, as large as fits; whole lines only when even the smallest overflows.
+inline void drawDiskLabel(QPainter &p,const QRectF &r,const QString &text,QFont f,const QColor &ink,int largest,int smallest)
+{
+    for (int px = largest; ; --px) {
+        f.setPixelSize(px);
+        QTextLayout layout(text,f);
+        QTextOption option(Qt::AlignHCenter); option.setWrapMode(QTextOption::WrapAtWordBoundaryOrAnywhere);
+        layout.setTextOption(option);
+        // Script faces carry tall line gaps; set the lines closer, as written by hand.
+        const qreal step = px*1.28;
+        qreal h = 0, whole = 0, lift = 0;
+        layout.beginLayout();
+        for (QTextLine line = layout.createLine(); line.isValid(); line = layout.createLine()) {
+            lift = std::max<qreal>(0,(line.height()-step)/2);
+            line.setLineWidth(r.width()); line.setPosition(QPointF(0,h-lift)); h += std::min(step,line.height());
+            if (h <= r.height()) whole = h;
+        }
+        layout.endLayout();
+        if (h > r.height() && px > smallest) continue;
+        const qreal used = whole > 0 ? whole : h, top = r.top()+std::max<qreal>(0,(r.height()-used)/2);
+        p.save(); p.setPen(ink);
+        p.setClipRect(QRectF(r.left(),h > r.height() ? top : r.top(),r.width(),h > r.height() ? used+1 : r.height()));
+        layout.draw(&p,QPointF(r.left(),top));
+        p.restore(); return;
+    }
+}
+inline void paintDisk(QPainter &p,const QRectF &t,const DiskFace &d)
+{
+    if (d.picture.isNull()) return;
+    p.drawPixmap(t,d.picture,QRectF(d.picture.rect()));
+    if (!d.label.isEmpty()) {
+        const QRectF label = diskPart(t,92,64,630,222);
+        const qreal pad = label.width()*.05;
+        const int base = std::max(8,qRound(t.width()/14));
+        if (d.action) {
+            QFont f("Arial"); f.setBold(true);
+            drawDiskLabel(p,label.adjusted(pad,0,-pad,0),d.label,f,QColor("#5b6068"),base+3,8);
+        } else {
+            QFont f("Segoe Print"); f.setBold(true);
+            if (!QFontInfo(f).exactMatch()) { f = QFont("Arial"); f.setItalic(true); }
+            drawDiskLabel(p,label.adjusted(pad,0,-pad,0),d.label,f,QColor("#1f2f6b"),base,7);
+        }
+    }
+    const QRectF tab = diskPart(t,813,220,60,66);
+    if (d.tab) {
+        // Foil folded over the edge, like the tabs on the system discs.
+        QLinearGradient foil(tab.topLeft(),tab.bottomRight());
+        foil.setColorAt(0,QColor("#f1e3a0")); foil.setColorAt(.55,QColor("#cfae52")); foil.setColorAt(1,QColor("#a8862e"));
+        p.setPen(QPen(QColor(70,52,10,190),.8)); p.setBrush(foil); p.drawRect(tab);
+        p.setPen(QPen(QColor(255,248,210,170),.8));
+        p.drawLine(QPointF(tab.left()+tab.width()*.15,tab.top()+tab.height()*.35),QPointF(tab.right()-tab.width()*.3,tab.top()+tab.height()*.12));
+    }
+    if (d.notchLit) {
+        p.setPen(QPen(PopupTheme::text(),1.5)); p.setBrush(QColor(255,255,255,d.tab ? 0 : 60));
+        p.drawRoundedRect(tab.adjusted(-3,-3,3,3),3,3);
+    }
+}
