+namespace amstrad {
+// Warm annotation ink, distinct from the photographed hardware.
+inline QColor calloutInk() { return QColor(240, 234, 222); }
+inline QColor calloutKey() { return QColor(19, 19, 28, 210); }
+inline QPen calloutDash(qreal width)
+{
+    QPen pen(calloutInk(), width, Qt::CustomDashLine, Qt::FlatCap, Qt::RoundJoin);
+    pen.setDashPattern({ 5, 4 });
+    return pen;
+}
+}
+
+// Dashed leader lines from the close-up's edges back to the spot on the
+// monitor's rear edge where the button sits. Never takes mouse input.
+class AmstradPowerLeads : public QWidget {
+public:
+    explicit AmstradPowerLeads(QWidget *parent) : QWidget(parent)
+    {
+        setAttribute(Qt::WA_TranslucentBackground);
+        setAttribute(Qt::WA_TransparentForMouseEvents);
+        setFocusPolicy(Qt::NoFocus);
+        hide();
+    }
+    // Parent coordinates. When the close-up overlaps the spot, nothing is drawn.
+    void span(const QPointF &rearTop, const QPointF &rearBottom,
+              const QPointF &top, const QPointF &bottom, qreal scale)
+    {
+        s = scale;
+        drawn = top.x() - rearTop.x() > 14 * s;
+        topLine = QPainterPath(rearTop);
+        topLine.lineTo(top);
+        bottomLine = QPainterPath(rearBottom);
+        bottomLine.lineTo(bottom);
+        const QRectF box = topLine.boundingRect().united(bottomLine.boundingRect())
+                               .adjusted(-8 * s, -8 * s, 8 * s, 8 * s);
+        const QRect g = box.toAlignedRect();
+        a = rearTop - g.topLeft(); b = rearBottom - g.topLeft();
+        topLine.translate(-g.topLeft()); bottomLine.translate(-g.topLeft());
+        setGeometry(g);
+        update();
+    }
+    qreal opacity = 1;
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        if (!drawn) return;
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing);
+        p.setOpacity(opacity);
+        for (const QPainterPath &line : { topLine, bottomLine }) {
+            p.setPen(QPen(amstrad::calloutKey(), 3.2 * s, Qt::SolidLine, Qt::FlatCap));
+            p.drawPath(line);
+            QPen dash = amstrad::calloutDash(1.4 * s);
+            // Finish in the middle of a dash, so the edge never looks detached.
+            dash.setDashOffset(2.5 - line.length() / dash.widthF());
+            p.setPen(dash);
+            p.drawPath(line);
+        }
+        p.setPen(QPen(amstrad::calloutInk(), 1.4 * s));
+        p.setBrush(amstrad::calloutKey());
+        p.drawEllipse(a, 4.5 * s, 4.5 * s);
+        p.drawEllipse(b, 4.5 * s, 4.5 * s);
+    }
+
+private:
+    QPointF a, b;
+    QPainterPath topLine, bottomLine;
+    qreal s = 1;
+    bool drawn = false;
+};
+
+class AmstradPowerPeek : public QWidget {
+public:
+    explicit AmstradPowerPeek(QWidget *parent, const QString &path, const QString &settingsPath)
+        : QWidget(parent), atlas(path), bayAtlas(QFileInfo(path).dir().filePath("rear-bay-atlas.png")), settingsFile(settingsPath)
+    {
+        cableView = QSettings(settingsFile, QSettings::IniFormat).value("power/view", "close").toString() == "bay";
+        setObjectName("amstradRearPower");
+        setAttribute(Qt::WA_TranslucentBackground);
+        setMouseTracking(true);
+        setFocusPolicy(Qt::StrongFocus);
+        setAccessibleName(tr("Rear monitor power button"));
+        setAccessibleDescription(tr("Round pushbutton. Press to switch the PC on or off."));
+        setToolTip(tr("Right-click to compare the button close-up and rear cable bay."));
+        leads = new AmstradPowerLeads(parent);
+        hideTimer.setSingleShot(true);
+        backdropTimer.setSingleShot(true);
+        connect(&backdropTimer, &QTimer::timeout, this, [this] {
+            if (!isVisible()) return;
+            backdrop.capture(parentWidget(),mapToGlobal(QPoint()),size(),false);
+            update();
+        });
+        connect(&hideTimer, &QTimer::timeout, this, [this] { if (powered) hide(); });
+        animation.setDuration(160);
+        connect(&animation, &QVariantAnimation::valueChanged, this, [this](const QVariant &v) {
+            opacity = v.toReal(); leads->opacity = opacity; leads->update(); update();
+        });
+        hide();
+    }
+
+    std::function<void()> toggle;
+    bool powered = true;
+
+    // Its on-screen footprint remains a reveal target while hidden. Keep this
+    // outside the monitor, clear of the colour/monochrome badge's menu target.
+    QRectF revealArea() const { return QRectF(geometry()); }
+
+    // Where the button sits, seen from the front: low on the monitor's right edge.
+    QPointF spot() const
+    {
+        const auto l = amstrad::sceneLayout(parentWidget()->size());
+        return QPointF(l.cabinet.left() + 1117 * l.scale, l.cabinet.top() + 735 * l.scale);
+    }
+
+    // Beside the cabinet, clear of the monitor, wherever the window leaves room.
+    void place()
+    {
+        const auto l = amstrad::sceneLayout(parentWidget()->size());
+        const qreal s = l.scale;
+        const QSize sz(qRound(Units * s), qRound((photoHeight() + 44 + CaptionDrop) * s));
+        const int x = qRound(l.cabinet.left() + 1190 * l.scale);
+        // Preserve the picture's position while giving its caption more air.
+        const int y = qRound(l.cabinet.top() + 650 * l.scale) - qRound((photoHeight() + 44) * s) / 2;
+        setGeometry(std::clamp(x, 0, std::max(0, parentWidget()->width() - sz.width())),
+                    std::clamp(y, 0, std::max(0, parentWidget()->height() - sz.height())), sz.width(), sz.height());
+        const QRectF frame(pos().x() + s, pos().y() + s, (Units - 2)*s, (photoHeight() + 10)*s);
