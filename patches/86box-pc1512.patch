+// A 320x200 CGA sample, using the emulator's actual 8x8 character ROM.
+// Only black, bright cyan, bright magenta and white are emitted.
+inline QImage monitorSample(const uint8_t font[][8])
+{
+    QImage sample(320, 200, QImage::Format_RGB32);
+    sample.fill(Qt::black);
+    auto text = [&](int col, int row, const QByteArray &string, QRgb colour) {
+        for (int i = 0; i < string.size(); ++i)
+            for (int y = 0; y < 8; ++y)
+                for (int x = 0; x < 8; ++x)
+                    if (font[static_cast<unsigned char>(string[i])][y] & (0x80 >> x))
+                        for (int dy = 0; dy < 2; ++dy)
+                            for (int dx = 0; dx < 2; ++dx)
+                                sample.setPixel((col + i) * 16 + x * 2 + dx, row * 16 + y * 2 + dy, colour);
+    };
+    const QRgb cyan = qRgb(85,255,255), magenta = qRgb(255,85,255), white = qRgb(255,255,255);
+    text(1, 1, "AMSTRAD PC1512", white);
+    text(1, 3, "CGA COLOUR DISPLAY", cyan);
+    text(1, 5, "320x200 / 4 COLOURS", white);
+    for (int i = 0; i < 3; ++i) {
+        const QRgb colour = i == 0 ? cyan : i == 1 ? magenta : white;
+        // Solid swatches use rectangles, independent of ROM glyph shapes.
+        QPainter p(&sample);
+        p.fillRect(QRect(24 + i * 96, 112, 80, 40), QColor::fromRgb(colour));
+    }
+    text(1, 11, "A>", white);
+    return sample;
+}
+
+// A character generator: 256 glyphs of `height` rows, eight dots wide.
+struct ScreenFont {
+    QByteArray rows;
+    int        height = 8;
+    bool    valid() const { return height > 0 && rows.size() >= 256 * height; }
+    uint8_t row(unsigned char c, int y) const { return uint8_t(rows[c * height + y]); }
+};
+
+inline ScreenFont screenFont8(const uint8_t font[][8])
+{
+    ScreenFont f;
+    f.rows = QByteArray(reinterpret_cast<const char *>(font), 256 * 8);
+    return f;
+}
+
+// The 8x14 font the PC1640 uses for 350-line text, inside its video ROM
+// (roms/machines/pc1640/40100). Located by its capital A; the first of the
+// ROM's four national tables is the English one. Invalid if not found.
+inline ScreenFont screenFont14(const QByteArray &rom)
+{
+    static const char a[14] = { 0x00, 0x00, 0x10, 0x38, 0x6c, char(0xc6), char(0xc6),
+                                char(0xfe), char(0xc6), char(0xc6), char(0xc6), 0x00, 0x00, 0x00 };
+    ScreenFont f;
+    f.height     = 14;
+    const int at = rom.indexOf(QByteArray(a, 14)) - 'A' * 14;
+    if (at >= 0 && at + 256 * 14 <= rom.size())
+        f.rows = rom.mid(at, 256 * 14);
+    return f;
+}
+
+// What each PC1640 monitor is for, drawn at its own resolution so the tube
+// shows its real line count: a 16-colour test card and the line count in the
+// screen's own character set (8 rows a character at 200 lines, 14 at 350).
+//   PC-CD:  640 x 200, the 16 fixed colours.
+//   PC-ECD: 640 x 350, 16 colours picked from the palette of 64.
+//   PC-MD:  720 x 350, one colour at two intensities: a plotted curve.
+inline QImage screenSample1640(Screen1640 screen, const ScreenFont &font8, const ScreenFont &font14)
+{
+    const bool cd = screen == ScreenCD, md = screen == ScreenMD;
+    const int  w = md ? 720 : 640, h = cd ? 200 : 350;
+    const ScreenFont &font = (cd || !font14.valid()) ? font8 : font14;
+    QImage sample(w, h, QImage::Format_RGB32);
+    sample.fill(Qt::black);
+    const QRgb normal = md ? qRgb(0xaf, 0xb3, 0xb0) : qRgb(170, 170, 170);
+    const QRgb bright = md ? qRgb(0xff, 0xfd, 0xed) : qRgb(255, 255, 255);
+    const QRect card(w * 7 / 100, h * 9 / 100, w * 86 / 100, h * 50 / 100);
+    if (md) {
+        // Axes, a dotted grid and two curves, as a plotting program draws them.
+        for (int gx = 0; gx <= 8; ++gx)
+            for (int y = card.top(); y <= card.bottom(); y += 4)
+                sample.setPixel(card.left() + gx * (card.width() - 1) / 8, y, normal);
+        for (int gy = 0; gy <= 4; ++gy)
+            for (int x = card.left(); x <= card.right(); x += 4)
+                sample.setPixel(x, card.top() + gy * (card.height() - 1) / 4, normal);
+        for (int curve = 0; curve < 2; ++curve)
+            for (int x = card.left(); x <= card.right(); ++x) {
+                const double t = double(x - card.left()) / card.width();
+                const double v = curve ? std::exp(-2.2 * t) * std::cos(t * 18.85) : .55 * std::sin(t * 6.283);
+                const int    y = card.center().y() - int(v * card.height() * .46);
+                for (int dy = -1; dy <= 1; ++dy)
+                    for (int dx = -1; dx <= 1; ++dx)
+                        sample.setPixel(std::clamp(x + dx, 0, w - 1), std::clamp(y + dy, 0, h - 1), curve ? bright : normal);
+            }
+    } else {
+        static const QRgb fixed[16] = {
+            qRgb(0,0,0), qRgb(0,0,170), qRgb(0,170,0), qRgb(0,170,170),
+            qRgb(170,0,0), qRgb(170,0,170), qRgb(170,85,0), qRgb(170,170,170),
+            qRgb(85,85,85), qRgb(85,85,255), qRgb(85,255,85), qRgb(85,255,255),
+            qRgb(255,85,85), qRgb(255,85,255), qRgb(255,255,85), qRgb(255,255,255)
+        };
+        // Every component is one of the ECD's four levels: dusk to daylight.
+        static const QRgb chosen[16] = {
+            qRgb(0,0,85), qRgb(0,0,170), qRgb(85,0,170), qRgb(85,0,85),
+            qRgb(170,0,85), qRgb(170,0,0), qRgb(255,0,0), qRgb(255,85,0),
+            qRgb(255,85,85), qRgb(255,170,0), qRgb(255,170,85), qRgb(255,255,0),
+            qRgb(255,255,85), qRgb(255,255,170), qRgb(170,255,255), qRgb(255,255,255)
+        };
+        QPainter p(&sample);
+        for (int i = 0; i < 16; ++i) {
+            const int left = card.left() + i * card.width() / 16, right = card.left() + (i + 1) * card.width() / 16;
+            p.fillRect(QRect(left, card.top(), right - left, card.height()), QColor::fromRgb(cd ? fixed[i] : chosen[i]));
+        }
+        p.setPen(QColor::fromRgb(normal));
+        p.drawRect(card.adjusted(-2, -2, 1, 1));
+    }
+    // The line count, each character dot ten across and six lines deep: the
+    // same height on the tube for either font, coarser on the 200-line screen.
+    const QByteArray count = cd ? "200" : "350";
+    const int sx = 10, sy = 6, cell = (md ? 9 : 8) * sx;
+    const int left = (w - count.size() * cell) / 2, top = h * 67 / 100;
+    for (int i = 0; i < count.size(); ++i)
+        for (int y = 0; y < font.height; ++y)
+            for (int x = 0; x < 8; ++x)
+                if (font.row(count[i], y) & (0x80 >> x))
+                    for (int dy = 0; dy < sy; ++dy)
+                        for (int dx = 0; dx < sx; ++dx) {
+                            const int px = left + i * cell + x * sx + dx, py = top + y * sy + dy;
+                            if (px >= 0 && px < w && py >= 0 && py < h) sample.setPixel(px, py, bright);
+                        }
+    return sample;
+}
+
+// A magnified detail of two characters as the tube draws them: one stripe
+// per scan line, so 200 lines read as eight coarse rows a character and 350
+// as fourteen fine ones. `side` is in device pixels.
+inline QImage screenLens(const ScreenFont &font, int cellDots, QRgb ink, int side)
+{
+    QImage lens(side, side, QImage::Format_ARGB32_Premultiplied);
+    lens.fill(Qt::transparent);
+    if (!font.valid()) return lens;
+    QPainter p(&lens);
+    p.setRenderHint(QPainter::Antialiasing);
+    const qreal rim = side * .035;
+    const QRectF glass(rim * 2, rim * 2, side - rim * 4, side - rim * 4);
+    p.setPen(Qt::NoPen);
+    p.setBrush(QColor(0, 0, 0, 70));
+    p.drawEllipse(glass.adjusted(-rim, -rim * .4, rim, rim * 1.6));
+    QPainterPath round; round.addEllipse(glass);
+    p.save();
+    p.setClipPath(round);
+    p.fillRect(lens.rect(), QColor(13, 14, 16));
+    const QByteArray text("Ag");
+    const qreal cellW = glass.width() * .34, cellH = cellW * 2.25;
+    const qreal dot = cellW / cellDots, pitch = cellH / font.height;
+    const qreal left = glass.center().x() - cellW * text.size() / 2 + dot * .5;
+    const qreal top = glass.center().y() - cellH / 2;
+    // A faint raster shows the unlit lines too.
+    p.setBrush(QColor(qRed(ink), qGreen(ink), qBlue(ink), 16));
+    for (int line = -font.height; line < font.height * 2; ++line)
+        p.drawRect(QRectF(glass.left(), top + line * pitch, glass.width(), pitch * .58));
+    p.setBrush(QColor::fromRgb(ink));
+    for (int i = 0; i < text.size(); ++i)
+        for (int y = 0; y < font.height; ++y)
+            for (int x = 0; x < 8; ++x)
+                if (font.row(text[i], y) & (0x80 >> x))
+                    p.drawRect(QRectF(left + i * cellW + x * dot, top + y * pitch, dot * 1.04, pitch * .58));
+    p.restore();
+    p.setBrush(Qt::NoBrush);
+    p.setPen(QPen(QColor(240, 234, 222), std::max<qreal>(1.2, rim * .7)));
+    p.drawEllipse(glass);
+    return lens;
+}
+
+// Preserve the complete cabinet photograph and its glass. Only light emitted
+// by the CGA sample is added, with falloff and scan lines. Content geometry
+// stays flat: the existing photograph supplies the physical glass shape.
+// exact keeps the sample's own colours (the PC1640's 64-colour palette).
+inline QImage monitorPhotograph(QImage cabinet, const QImage &sample, bool mono, bool exact = false)
+{
+    const QImage display = exact ? sample.convertToFormat(QImage::Format_RGB32) : cgaPaletteImage(sample);
+    cabinet = cabinet.convertToFormat(QImage::Format_ARGB32);
+    const auto l = layout(cabinet.size());
+    const QRect video = l.video.toAlignedRect().intersected(cabinet.rect());
+    for (int y = video.top(); y <= video.bottom(); ++y) {
+        auto *out = reinterpret_cast<QRgb *>(cabinet.scanLine(y));
+        const double ny = 2.0 * (y - l.video.top()) / l.video.height() - 1;
+        for (int x = video.left(); x <= video.right(); ++x) {
+            const double nx = 2.0 * (x - l.video.left()) / l.video.width() - 1;
+            const int px = std::clamp(int((nx + 1) * .5 * display.width()), 0, display.width() - 1);
+            const int py = std::clamp(int((ny + 1) * .5 * display.height()), 0, display.height() - 1);
+            QRgb light = display.pixel(px, py);
+            if (mono) {
+                const int grey = (76 * qRed(light) + 150 * qGreen(light) + 29 * qBlue(light)) / 255;
+                light = qRgb(grey, grey, grey);
+            }
+            const double strength = .76 * (1 - .12 * (nx * nx + ny * ny)) * ((y & 1) ? .94 : 1);
+            const QRgb glass = out[x];
+            out[x] = qRgba(std::min(255, qRed(glass) + int(qRed(light) * strength)),
+                           std::min(255, qGreen(glass) + int(qGreen(light) * strength)),
+                           std::min(255, qBlue(glass) + int(qBlue(light) * strength)), qAlpha(glass));
+        }
+    }
+    // Include the whole moulded casing and pedestal, omitting the system unit.
+    const double scale = cabinet.width() / 1254.0;
+    return cabinet.copy(QRectF(100 * scale, 0, 1060 * scale, 940 * scale).toAlignedRect());
+}
+
+class MonitorChoice : public QAbstractButton {
+public:
+    MonitorChoice(QImage photo, bool mono, bool current, std::function<void()> choose)
+        : MonitorChoice(std::move(photo), mono ? "PC-MM" : "PC-CM", mono ? tr("Monochrome") : tr("CGA colour"),
+                        mono ? tr("PC-MM monochrome monitor") : tr("PC-CM colour monitor"), current, std::move(choose)) {}
+    // lens: an optional magnified detail of the picture, laid over the casing.
+    MonitorChoice(QImage photo, QString name, QString detail, const QString &spoken, bool current,
+                  std::function<void()> choose, QImage lens = {}, int width = 300)
+        : photo(std::move(photo)), lens(std::move(lens)), name(std::move(name)), detail(std::move(detail)),
+          current(current), cardWidth(width)
+    {
+        setText(spoken);
+        setAccessibleName(text());
+        setAccessibleDescription(current ? tr("Currently fitted") : tr("Fit this monitor"));
+        setFocusPolicy(Qt::StrongFocus);
+        setCursor(Qt::PointingHandCursor);
+        connect(this, &QAbstractButton::clicked, this, [choose] {
+            while (auto *popup = QApplication::activePopupWidget()) popup->close();
+            QTimer::singleShot(0, qApp, choose);
+        });
+    }
+    QSize sizeHint() const override { return QSize(cardWidth, 76 + 252 * cardWidth / 300); }
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::SmoothPixmapTransform);
+        drawChoiceBox(p, QRectF(rect()), current, underMouse() || hasFocus(), hasFocus());
+        // Keep the hardware opaque above the shared frosted backdrop.
+        const QRect box(12, 12, width() - 24, height() - 76);
+        QSize size = photo.size(); size.scale(box.size(), Qt::KeepAspectRatio);
+        const QRect target(QPoint(box.center().x() - size.width()/2, box.bottom() - size.height()), size);
+        p.drawImage(target, photo);
+        if (!lens.isNull()) {
+            // Over the casing's lower right corner, clear of the picture's middle.
+            const qreal side = target.width() * .36;
+            p.drawImage(QRectF(target.right() - side * .86, target.top() + target.height() * .40, side, side), lens);
+        }
+        QFont f = font(); f.setBold(true); p.setFont(f); p.setPen(QColor("#ffffff"));
+        const int y = height() - 57;
+        drawPopupText(p,QRect(18,y,width()-36,22), Qt::AlignLeft | Qt::AlignVCenter, name);
+        f.setBold(false); p.setFont(f); p.setPen(QColor("#aaaaaa"));
+        drawPopupText(p,QRect(18,y+23,width()-36,20), Qt::AlignLeft | Qt::AlignVCenter,
+                   detail,PopupTheme::secondaryText());
+        if (current) drawChoiceTick(p, QPointF(width()-27, y+11));
+    }
+    void enterEvent(QEvent *) override { update(); }
+    void leaveEvent(QEvent *) override { update(); }
+    void focusInEvent(QFocusEvent *) override { update(); }
+    void focusOutEvent(QFocusEvent *) override { update(); }
+    void keyPressEvent(QKeyEvent *event) override
+    {
+        if (event->key() == Qt::Key_Return || event->key() == Qt::Key_Enter) { click(); event->accept(); }
+        else if (event->key() == Qt::Key_Left || event->key() == Qt::Key_Right) {
+            const auto buttons = parentWidget()->findChildren<QAbstractButton *>();
+            const int step = event->key() == Qt::Key_Left ? buttons.size() - 1 : 1;
+            if (!buttons.isEmpty()) buttons[(buttons.indexOf(this) + step) % buttons.size()]->setFocus();
+            event->accept();
+        } else QAbstractButton::keyPressEvent(event);
+    }
+private:
+    QImage photo, lens;
+    QString name, detail;
+    bool current;
+    int cardWidth;
+};
+
+inline QHBoxLayout *addMonitorSelector(QMenu *menu)
+{
+    stylePopupMenu(menu,12);
+    auto *panel = new QWidget;
+    auto *row = new QHBoxLayout(panel);
+    row->setContentsMargins(0,0,0,0); row->setSpacing(20);
+    auto *action = new QWidgetAction(menu); action->setDefaultWidget(panel); menu->addAction(action);
+    return row;
+}
+}
