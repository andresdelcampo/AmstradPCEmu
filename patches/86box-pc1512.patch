+// A machine configuration: the system unit itself, cut out of the cabinet
+// artwork, beside its name. Marked like the monitor selector: a box and a
+// tick for the current one, a fainter box under the pointer or focus.
+class ConfigChoice : public MenuCard {
+public:
+    static constexpr int PictureWidth = 348, PictureHeight = 110, Width = 652, Height = 132;
+    // The unit's front face in master pixels, below the lid and monitor foot.
+    static QRectF masterCrop() { return QRectF(100,922,1054,332); }
+    using MenuCard::MenuCard;
+    QSize sizeHint() const override { return QSize(Width,Height); }
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this); p.setRenderHint(QPainter::Antialiasing); p.setRenderHint(QPainter::SmoothPixmapTransform);
+        const bool lit = callback && (underMouse() || hasFocus());
+        drawChoiceBox(p,QRectF(rect()).adjusted(2,2,-2,-2),selected,lit,hasFocus());
+        const QRect box(16,(height()-PictureHeight)/2,PictureWidth,PictureHeight);
+        if (!picture.isNull()) {
+            QSizeF sz = QSizeF(picture.size())/picture.devicePixelRatio();
+            sz.scale(box.size(), Qt::KeepAspectRatio);
+            // Hardware stays opaque and sharp above the frost and the box.
+            const QPointF at(box.center().x()-sz.width()/2+.5, box.bottom()+1-sz.height());
+            p.drawPixmap(QRectF(at,sz),picture,picture.rect());
+        }
+        const int x = box.right()+24, tw = width()-x-20;
+        QFont f = font(); f.setBold(true); f.setPointSizeF(f.pointSizeF()*1.1); p.setFont(f);
+        // Centre the name and its wrapped description on the unit, at any font size.
+        const QFontMetrics bold(f), plain(font());
+        const int wrap = Qt::AlignLeft|Qt::AlignTop|Qt::TextWordWrap;
+        const int th = bold.height()+4, bh = std::min(plain.boundingRect(QRect(0,0,tw,999),wrap,body).height(), 3*plain.lineSpacing());
+        const int y = std::max(4, box.center().y()-(th+bh)/2);
+        const int mark = selected ? 24 : 0;
+        drawPopupText(p,QRect(x,y,tw-mark,th),Qt::AlignLeft|Qt::AlignVCenter,bold.elidedText(title,Qt::ElideRight,tw-mark));
+        p.setFont(font());
+        drawPopupText(p,QRect(x,y+th,tw,bh),wrap,body,PopupTheme::secondaryText());
+        if (selected) drawChoiceTick(p,QPointF(x+tw-9,y+th/2.0));
+    }
+};
+// Scale the cropped unit for a ConfigChoice and round off the sliver of lid
+// left outside the moulded top corners.
+inline QPixmap unitPicture(const QImage &image, qreal ratio)
+{
+    if (image.isNull()) return {};
+    QImage scaled = image.scaled(QSize(ConfigChoice::PictureWidth,ConfigChoice::PictureHeight)*ratio,
+                                 Qt::KeepAspectRatio, Qt::SmoothTransformation).convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    const qreal r = 14.0*scaled.width()/ConfigChoice::masterCrop().width();
+    QPainter p(&scaled); p.setRenderHint(QPainter::Antialiasing);
+    p.setCompositionMode(QPainter::CompositionMode_DestinationIn); p.setPen(Qt::NoPen); p.setBrush(Qt::black);
+    p.drawRoundedRect(QRectF(0,0,scaled.width(),scaled.height()+2*r),r,r); p.end();
+    QPixmap pixmap = QPixmap::fromImage(scaled); pixmap.setDevicePixelRatio(ratio); return pixmap;
+}
+inline void addCard(QMenu *menu,const QPixmap &picture,const QString &title,const QString &text,
+                    bool checked=false,std::function<void()> handler={})
+{
+    auto *a=new QWidgetAction(menu); a->setDefaultWidget(new MenuCard(picture,title,text,checked,std::move(handler))); menu->addAction(a);
+}
+// With rules, a hairline separates each column from the next (one machine
+// family per column in the configuration panel).
+inline QGridLayout *addGrid(QMenu *menu,bool rules=false)
+{
+    struct Ruled : QWidget {
+        void paintEvent(QPaintEvent *) override {
+            auto *g=static_cast<QGridLayout *>(layout()); QPainter p(this); p.setPen(PopupTheme::border());
+            for (int c=1; c<g->columnCount(); ++c) {
+                const int x=(g->cellRect(0,c-1).right()+g->cellRect(0,c).left())/2;
+                p.drawLine(x,8,x,height()-8);
+            }
+        }
+    };
+    auto *w=rules ? new Ruled : new QWidget; auto *g=new QGridLayout(w); g->setContentsMargins(0,0,0,0); g->setSpacing(8);
+    auto *a=new QWidgetAction(menu); a->setDefaultWidget(w); menu->addAction(a); return g;
+}
+inline MenuCard *addTile(QGridLayout *g,const QPixmap &picture,const QString &title,const QString &text,
+                        bool checked,std::function<void()> handler,int columns=2)
+{
+    auto *card=new MenuCard(picture,title,text,checked,std::move(handler),true);
+    const int i=g->count(); g->addWidget(card,i/columns,i%columns); return card;
+}
+// A heading; the subtitle goes beneath, or beside the title when inlined.
