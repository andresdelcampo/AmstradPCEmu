+    {
+        QPainter p(this);
+        const bool lit = callback && (underMouse() || hasFocus());
+        drawChoiceBox(p,QRectF(rect()).adjusted(2,2,-2,-2),selected,lit,hasFocus());
+        const QRectF plate(16,(height()-48)/2.0,156,48);
+        drawNameplate(p,plate,number);
+        const int x = qRound(plate.right())+18, tw = width()-x-(selected ? 38 : 12);
+        const QFontMetrics plain(font());
+        const int wrap = Qt::AlignLeft|Qt::AlignTop|Qt::TextWordWrap;
+        const int bh = plain.boundingRect(QRect(0,0,tw,999),wrap,body).height();
+        drawPopupText(p,QRect(x,(height()-bh)/2,tw,bh),wrap,body,PopupTheme::secondaryText());
+        if (selected) drawChoiceTick(p,QPointF(width()-27,height()/2.0));
