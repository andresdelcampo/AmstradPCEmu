+void
+MainWindow::showAmstradMenu(QPoint pos, QPoint globalPos)
+{
+    auto *sw = ui->stackedWidget->softwareRenderer();
+    if (!sw || !sw->hasCabinet())
+        return;
+    /* The cabinet layout is proportional, so logical pixels work as well as device ones. */
+    const auto hot   = amstrad::hotspot(amstrad::sceneLayout(ui->stackedWidget->size()), QPointF(pos));
+    const auto front = SoftwareRenderer::machineFront();
+    if (hot == amstrad::HotNone)
+        return;
+
+    /* Pictures are crops of the cabinet as each option would look, in master pixels. */
+    const qreal  ratio = devicePixelRatioF();
+    const QSize  box(amstrad::MenuCard::PictureBox, 103);
+    auto bayCrop = [](int bay) { return amstrad::masterBay(bay).adjusted(-6, -6, 6, -30); };
+    auto picture = [&](const amstrad::Front &f, const QRectF &rect, int leftFace = -1, int rightFace = -1) {
+        return amstrad::menuPicture(sw->frontPreview(f, rect, leftFace, rightFace), box, ratio);
+    };
+
+    amstrad::CabinetMenu menu(this);
+    menu.setSeparatorsCollapsible(true);
+
+    /* A floppy drive: the bay with its disk (click to eject), then the box of
+       disks to put in it. See addDrivePanel() in qt_amstradmenu.hpp. */
+    auto addFloppy = [&](int drive) {
+        const QString path = QString::fromUtf8(drives[drive].image_path);
+        const int     bay  = (front.left == amstrad::BayFloppy && drive == 0) ? 0 : 1;
+        const int     face = path.isEmpty() ? amstrad::DriveOpen : amstrad::diskColour(path, front.left == amstrad::BayHdd);
+        auto bayPicture    = [&](int f) { return picture(front, bayCrop(bay), bay == 0 ? f : -1, bay == 1 ? f : -1); };
+        amstrad::DrivePanel panel;
+        panel.drive     = drive;
+        panel.hardDisk  = front.left == amstrad::BayHdd;
+        panel.vmFolder  = QString::fromUtf8(usr_path);
+        panel.artFolder = QFileInfo(qEnvironmentVariable("AMSTRAD_CABINET")).dir().filePath("disks");
+        for (int d = 0; d < 2; ++d)
+            panel.mounted[d] = QString::fromUtf8(drives[d].image_path);
+        panel.mountedProtected = drives[drive].read_only || drives[drive].writeprot;
+        panel.closed           = bayPicture(face);
+        panel.open             = bayPicture(amstrad::DriveOpen);
+        panel.insert = [this, drive](const QString &image, bool wp) { mm->floppyMount(drive, image, wp); };
+        panel.browse = [this, drive](bool wp) { mm->floppySelectImage(drive, wp); };
+        panel.create = [this, drive] { mm->floppyNewImage(drive); };
+        panel.eject  = [this, drive] { mm->floppyEject(drive); };
+        panel.locate = [this, drive](int disc) {
+            const QString image = mm->floppyChooseImage();
+            if (image.isEmpty())
+                return;
+            amstrad::DiskBox(QString::fromUtf8(usr_path), true).setSystemDisc(disc, image);
+            mm->floppyMount(drive, image, true);
+        };
+        if (amstrad::DiskBox box(panel.vmFolder); !box.started()) {
+            QStringList history;
+            for (int d = 0; d < 2; ++d)
+                for (const QString &image : mm->floppyHistory(d))
+                    history.prepend(image);
+            box.start(history);
+        }
+        amstrad::addDrivePanel(&menu, panel, ratio);
+    };
+
+    /* The model: the machine (PC1512 or PC1640), then its left bay fit, which
+       gives the suffix: DD, SD (plain or sticker), HD20. Two separate choices. */
+    auto addModelChoices = [&](QMenu *target) {
+        amstrad::MachinePanel panel;
+        panel.front  = front;
+        panel.unit   = [sw, ratio](const amstrad::Front &preview) {
+            return amstrad::unitPicture(sw->frontPreview(preview, amstrad::ConfigChoice::masterCrop()), ratio);
+        };
+        panel.choose = [this](bool pc1640, int bay) { setAmstradModel(pc1640, bay); };
+        amstrad::addMachinePanel(target, panel);
+    };
+
+    auto addMonitorChoices = [&](QMenu *target) {
+        auto *row = amstrad::addMonitorSelector(target);
+        if (front.pc1640) {
+            /* Three monitors, each drawn at its own line count in the
+               machine's own character sets. */
+            QByteArray rom;
+            if (FILE *file = rom_fopen("roms/machines/pc1640/40100", const_cast<char *>("rb"))) {
+                rom.resize(32768);
+                rom.resize(static_cast<int>(fread(rom.data(), 1, rom.size(), file)));
+                fclose(file);
+            }
+            const auto font8 = amstrad::screenFont8(fontdat), font14 = amstrad::screenFont14(rom);
+            struct Choice {
+                amstrad::Screen1640 screen;
+                const char         *name, *detail, *spoken;
+            };
+            static const Choice choices[] = {
+                { amstrad::ScreenMD, "PC-MD", QT_TR_NOOP("Monochrome, 350 lines"), QT_TR_NOOP("PC-MD monochrome monitor") },
+                { amstrad::ScreenCD, "PC-CD", QT_TR_NOOP("Colour, 200 lines"), QT_TR_NOOP("PC-CD colour monitor") },
+                { amstrad::ScreenECD, "PC-ECD", QT_TR_NOOP("Enhanced colour, 350 lines"), QT_TR_NOOP("PC-ECD enhanced colour monitor") },
+            };
+            row->setSpacing(12);
+            for (const Choice &c : choices) {
+                amstrad::Front preview = front;
+                preview.screen         = c.screen;
+                const bool   md        = c.screen == amstrad::ScreenMD, cd = c.screen == amstrad::ScreenCD;
+                const QImage art       = sw->frontPreview(preview, QRectF(0, 0, 1254, 1254));
+                const int    screen    = c.screen;
+                row->addWidget(new amstrad::MonitorChoice(
+                    amstrad::monitorPhotograph(art, amstrad::screenSample1640(c.screen, font8, font14), false, true),
+                    c.name, tr(c.detail), tr(c.spoken), front.screen == c.screen,
+                    [this, screen] { setAmstradScreen1640(screen); },
+                    amstrad::screenLens((cd || !font14.valid()) ? font8 : font14, md ? 9 : 8,
+                                        md ? qRgb(0xff, 0xfd, 0xed) : qRgb(255, 255, 255), qRound(96 * ratio)),
+                    264));
+            }
+            return;
+        }
+        const auto assets = QFileInfo(qEnvironmentVariable("AMSTRAD_CABINET")).dir();
+        const QImage tiger(assets.filePath("monitor/gem-paint-tiger.png"));
+        const QImage house = amstrad::gemPaintHouse(tiger,
+            QImage(assets.filePath("monitor/gem-house-original.png")), fontdat);
+        for (const bool mono : { false, true }) {
+            QImage sample = mono ? tiger : house;
+            if (sample.isNull()) sample = amstrad::monitorSample(fontdat);
+            amstrad::Front preview = front;
+            preview.mono           = mono;
+            const QImage art = sw->frontPreview(preview, QRectF(0,0,1254,1254));
+            row->addWidget(new amstrad::MonitorChoice(amstrad::monitorPhotograph(art, sample, mono),
+                mono, front.mono == mono, [this, mono] { setAmstradMonochrome(mono); }));
+        }
+    };
+
+    switch (hot) {
+        case amstrad::HotLeftBay: {
+            if (front.left == amstrad::BayFloppy)
+                addFloppy(0);
+            else if (front.left == amstrad::BayHdd) {
+                QString name = tr("No image attached.");
+                for (int i = 0; i < HDD_NUM; ++i)
+                    if (hdd_is_valid(i) && hdd[i].bus_type == HDD_BUS_MFM) {
+                        name = QFileInfo(QString::fromUtf8(hdd[i].fn)).fileName();
+                        break;
+                    }
+                amstrad::addCard(&menu, picture(front, bayCrop(0)), tr("Hard disk C:  20 MB"), name);
+            } else
+                amstrad::addCard(&menu, picture(front, bayCrop(0)), tr("Left bay: blank plate"),
+                                 tr("No drive fitted. Choose a fitting below."));
+            menu.addSeparator();
+            auto *bayMenu = new amstrad::CabinetMenu(&menu);
+            bayMenu->setTitle(tr("Machine configurationâ€¦"));
+            menu.addMenu(bayMenu);
+            bayMenu->setSeparatorsCollapsible(true);
+            addModelChoices(bayMenu);
+            break;
+        }
+        case amstrad::HotRightBay:
+            addFloppy(front.rightDrive());
+            break;
+        case amstrad::HotModelBadge:
+            addModelChoices(&menu);
+            break;
+        case amstrad::HotMonitorBadge:
+            addMonitorChoices(&menu);
+            break;
+        default:
+            return;
+    }
+    menu.openAt(globalPos);
+}
+
+void
+MainWindow::setAmstradMonochrome(bool mono)
+{
+    /* The PC-MM shows the same video as shades on a paper-white tube:
+       86Box's white monitor conversion, applied like the Display setting. */
+    if ((video_grayscale != 0) == mono)
+        return;
+    startblit();
+    video_grayscale = mono ? 4 : 0;
+    video_copy      = (video_grayscale || invert_display) ? video_transform_copy : memcpy;
+    endblit();
+    config_save();
+    device_force_redraw();
+    refreshAmstradFront();
+}
+
+/* The PC1640's monitor is hardware: it sets the video adapter's switches,
+   read by the ROM at power-on. 86Box draws any mode on any of them, so the
+   choice and the switches are one setting here. */
+void
+MainWindow::setAmstradScreen1640(int screen)
+{
+    const auto front = SoftwareRenderer::machineFront();
+    if (!front.pc1640 || screen < 0 || screen >= amstrad::Screen1640Count || front.screen == screen)
+        return;
+    static const char *const names[amstrad::Screen1640Count] = {
+        QT_TR_NOOP("PC-MD monochrome monitor"), QT_TR_NOOP("PC-CD colour monitor"),
+        QT_TR_NOOP("PC-ECD enhanced colour monitor")
+    };
+    /* vid_1640_config: 0Bh with the paper-white tube, 7, 9. */
+    static const int types[amstrad::Screen1640Count] = { 0x5b, 7, 9 };
+    if (!testAttribute(Qt::WA_DontShowOnScreen) &&
+        QMessageBox::question(this, tr("Change monitor"),
+                              tr("Fitting the %1 restarts the PC. Unsaved work in it is lost.\n"
+                                 "Disks and drives stay as they are.\n\nContinue?").arg(tr(names[screen]))) != QMessageBox::Yes)
+        return;
+    runctl_pause_wait(RUN_PAUSE_SYNC);
+    config_set_int("Amstrad PC1640 (Video)", "monitor_type", types[screen]);
+    /* The PC1512's PC-MM tint is not one of these monitors. */
+    startblit();
+    video_grayscale = 0;
+    video_copy      = invert_display ? video_transform_copy : memcpy;
+    endblit();
+    config_changed = 2;
+    pc_reset_hard();
+    config_save();
+    device_force_redraw();
+    runctl_resume(RUN_PAUSE_SYNC);
+    refreshAmstradFront();
+}
+
+void
+MainWindow::setAmstradModel(bool pc1640, int bayIndex)
+{
+    const auto bay   = static_cast<amstrad::LeftBay>(bayIndex);
+    const auto front = SoftwareRenderer::machineFront();
+    auto blank = [](amstrad::LeftBay b) { return b == amstrad::BayBlank || b == amstrad::BayBlankSticker; };
+    if (blank(bay))
+        SoftwareRenderer::setBlankSticker(bay == amstrad::BayBlankSticker);
+    const bool machineChange = pc1640 != front.pc1640;
+    /* A sticker is only artwork: no hardware change. */
+    const bool bayChange = bay != front.left && !(blank(bay) && blank(front.left));
+    if (!machineChange && !bayChange) {
+        refreshAmstradFront();
+        return;
+    }
+
+    int machineId = machine;
+    if (machineChange) {
+        machineId = machine_get_machine_from_internal_name(pc1640 ? "pc1640" : "pc1512");
+        if (machineId < 0 || !machine_available(machineId)) {
+            QMessageBox::warning(this, pc1640 ? tr("Amstrad PC1640") : tr("Amstrad PC1512"),
+                pc1640 ? tr("The PC1640 firmware is missing.\n"
+                            "Place 40043.v3, 40044.v3 and 40100 under roms/machines/pc1640 and try again.")
+                       : tr("The PC1512 firmware is missing.\n"
+                            "Place 40043, 40044 and 40078 under roms/machines/pc1512 and try again."));
+            return;
+        }
+    }
+
+    const bool fitHdd = bayChange && bay == amstrad::BayHdd;
+    QString hd20Image;
+    int     hdcId = 0;
+    if (fitHdd) {
+        hdcId = hdc_get_from_internal_name(hd20_controller);
+        if (hdcId <= 0 || !hdc_available(hdcId)) {
+            QMessageBox::warning(this, tr("Hard disk"),
+                tr("The Western Digital WD1002A-WX1 controller ROM is missing.\n"
+                   "Place wd1002a_wx1-62-000094-032.bin under roms/hdd/st506 and try again."));
+            return;
+        }
+        hd20Image = QSettings(amstradSettingsFile(), QSettings::IniFormat)
+                        .value("front/hdd_image", QDir(QString::fromUtf8(usr_path)).filePath("hd20.img"))
+                        .toString();
+    }
+
+    static const char *const fitted[amstrad::LeftBayCount] = {
+        QT_TR_NOOP("a second floppy drive"), QT_TR_NOOP("a blank plate"),
+        QT_TR_NOOP("a blank plate"), QT_TR_NOOP("a 20 MB hard disk")
+    };
+    QString question;
+    if (machineChange)
+        question = (pc1640 ? tr("Replacing the PC1512 with a PC1640 (640K memory, EGA graphics) restarts the PC.")
+                           : tr("Replacing the PC1640 with a PC1512 (512K memory, CGA graphics) restarts the PC."))
+                   + tr(" Unsaved work in it is lost.\nDisks and drives stay as they are.");
+    if (bayChange) {
+        if (machineChange)
+            question += tr("\nThe left bay gets %1.").arg(tr(fitted[bay]));
+        else
+            question = tr("Fitting %1 in the left bay restarts the PC. Unsaved work in it is lost.").arg(tr(fitted[bay]));
+        if (front.left == amstrad::BayFloppy && drives[1].image_path[0])
+            question += tr("\nThe disk in drive B: is ejected; drive A: moves to the right bay.");
+        else if (front.left == amstrad::BayFloppy)
+            question += tr("\nDrive A: moves to the right bay.");
+    }
+    if (fitHdd && !QFileInfo::exists(hd20Image))
+        question += tr("\nA new, empty 20 MB disk is created: partition it with FDISK and FORMAT it from DOS.");
+    /* The headless regression (ui-model) has nobody to ask. */
+    if (!testAttribute(Qt::WA_DontShowOnScreen) &&
+        QMessageBox::question(this, machineChange ? tr("Change computer") : tr("Change drive bay"),
+                              question + tr("\n\nContinue?")) != QMessageBox::Yes)
+        return;
+
+    if (fitHdd && !QFileInfo::exists(hd20Image)) {
+        QFile image(hd20Image);
+        if (!image.open(QIODevice::WriteOnly | QIODevice::NewOnly) ||
+            !image.resize(qint64(hd20_tracks) * hd20_heads * hd20_sectors * 512)) {
+            QMessageBox::warning(this, tr("Hard disk"), tr("Cannot create %1: %2").arg(hd20Image, image.errorString()));
+            return;
+        }
+    }
+
+    if (bayChange && front.left == amstrad::BayFloppy && drives[1].image_path[0])
+        mm->floppyEject(1);
+
+    runctl_pause_wait(RUN_PAUSE_SYNC);
+    if (machineChange) {
+        /* Like Settings: the next hard reset builds the other machine. Both
+           are 8 MHz 8086s; each keeps its own NVR file and BIOS language. */
+        machine_amstrad_select(machineId, pc1640 ? 640 : 512);
+        if (pc1640 && video_grayscale) {
+            /* The PC-MM's tint stays with the PC1512. */
+            startblit();
+            video_grayscale = 0;
+            video_copy      = invert_display ? video_transform_copy : memcpy;
+            endblit();
+        }
+    }
+    /* The second floppy exists only in the DD; its sound profile is kept. */
+    if (bayChange)
+        fdd_set_type(&drives[1], bay == amstrad::BayFloppy ? fdd_get_from_internal_name(const_cast<char *>("525_2dd")) : 0);
+    if (bayChange && front.left == amstrad::BayHdd) {
+        /* Remember the disk for a later HD20, then remove it and its controller. */
+        for (int i = 0; i < HDD_NUM; ++i)
+            if (hdd_is_valid(i) && hdd[i].bus_type == HDD_BUS_MFM) {
+                QSettings(amstradSettingsFile(), QSettings::IniFormat).setValue("front/hdd_image", QString::fromUtf8(hdd[i].fn));
+                memset(&hdd[i], 0, sizeof(hdd[i]));
+            }
+        for (int c = 0; c < HDC_MAX; ++c) {
+            const device_t *dev = hdc_get_device(hdc_current[c]);
+            if (dev && dev->internal_name && QByteArray(dev->internal_name).startsWith("st506_xt"))
+                hdc_current[c] = 0;
+        }
+    }
+    if (fitHdd) {
+        int slot = 0;
+        while (slot < HDD_NUM - 1 && hdd_is_valid(slot))
+            ++slot;
