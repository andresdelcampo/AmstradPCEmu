+// Amstrad cabinet presentation, GPL-2.0-or-later, same terms as 86Box.
+// Geometry is measured in the unchanged 1254 x 1254 approved master image.
+#ifndef QT_AMSTRADSCENE_HPP
+#define QT_AMSTRADSCENE_HPP
+
+#include <QImage>
+#include <QPainter>
+#include <QPainterPath>
+#include <QRectF>
+#include <QRegion>
+#include <QString>
+#include <QFileInfo>
+#include <QRegularExpression>
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+
+namespace amstrad {
+
+// Sampled from the former charcoal backdrop beside the monitor. The cabinet
+// now has a transparent exterior, so this fills the entire rendering surface.
+inline QColor backgroundColor() { return QColor(19, 19, 28); }
+
+struct Layout {
+    QRectF cabinet;
+    QRectF aperture;
+    QRectF video;
+    qreal scale;
+};
+
+constexpr qreal SceneWidth = 1460;
+
+// The monitor close-up: its housing, bezel included, in master pixels, with
+// an even margin around it. The housing spans y = 14 to 830; the margin
+// below it shows the top of its neck on the system unit.
+inline QRectF masterMonitor() { return QRectF(114, -4, 1026, 852); }
+
+// The view shown: 0 is the whole computer, 1 the monitor close-up, and values
+// in between occur while the view travels from one to the other. Written by
+// the GUI thread; the scaling worker gets its copy with the published layout.
+inline std::atomic<qreal> &viewZoom()
+{
+    static std::atomic<qreal> zoom { 0 };
+    return zoom;
+}
+
+inline Layout layout(const QSize &size, bool powerSpace = false, qreal zoom = 0)
+{
+    const qreal width = powerSpace ? SceneWidth : 1254;
+    qreal scale = std::min(size.width() / width, size.height() / 1254.0);
+    QPointF origin((size.width() - width * scale) / 2,
+                   (size.height() - 1254 * scale) / 2);
+    if (zoom > 0) {
+        // The close-up fills the window with the monitor, centred, its lower
+        // edge on the window's: whatever room is left over lies above and
+        // beside it, never below, where the system unit would show. Scale and
+        // position are blended together, so every point travels in a line.
+        const QRectF  m     = masterMonitor();
+        const qreal   close = std::min(size.width() / m.width(), size.height() / m.height());
+        const QPointF closeOrigin(size.width() / 2.0 - m.center().x() * close,
+                                  size.height() - m.bottom() * close);
+        zoom   = std::min(zoom, qreal(1));
+        origin = origin + (closeOrigin - origin) * zoom;
+        scale  = scale + (close - scale) * zoom;
+    }
+    auto rect = [=](qreal x, qreal y, qreal w, qreal h) {
+        return QRectF(origin.x() + x * scale, origin.y() + y * scale, w * scale, h * scale);
+    };
+    // 4:3 display inset 5% vertically into the glass, as on the user's real
+    // PC-CM reference. CGA's 640x200 pixels are non-square.
+    return { rect(0, 0, 1254, 1254), rect(258, 159, 738, 540),
+             rect(303, 186, 648, 486), scale };
+}
+
+// Keep a right-hand margin for the rear switch, even in a narrow window.
+// Artwork preparation and cropped menu previews retain the master layout.
+// This is the view as shown now, close-up included.
+inline Layout sceneLayout(const QSize &size) { return layout(size, true, viewZoom().load()); }
+inline Layout sceneLayout(const QSize &size, qreal zoom) { return layout(size, true, zoom); }
+// The whole computer whatever the view: sizes the controls that belong to the
+// window rather than to the cabinet, so that they do not grow with a close-up.
+inline Layout restLayout(const QSize &size) { return layout(size, true); }
+
+inline QPainterPath aperture(const Layout &l)
+{
+    QPainterPath path;
+    path.addRoundedRect(l.aperture, 18 * l.scale, 18 * l.scale);
+    return path;
+}
+
+// Prepare once when the artwork is loaded. Keep its photographed glass texture
+// and edge shading, but compress the bright studio reflection into dark glass.
+// Both an unlit tube and black guest pixels then show exactly the same surface.
+inline QImage prepareCabinet(const QImage &art)
+{
+    if (art.isNull()) return art;
+    QImage result = art.convertToFormat(QImage::Format_ARGB32);
+    const auto l = layout(QSize(1254, 1254));
+    const auto glass = aperture(l);
+    const qreal sx = art.width() / 1254.0;
+    const qreal sy = art.height() / 1254.0;
+    for (int y = int(std::floor(l.aperture.top() * sy)); y < int(std::ceil(l.aperture.bottom() * sy)); ++y) {
+        auto *row = reinterpret_cast<QRgb *>(result.scanLine(y));
+        for (int x = int(std::floor(l.aperture.left() * sx)); x < int(std::ceil(l.aperture.right() * sx)); ++x) {
+            if (!glass.contains(QPointF((x + .5) / sx, (y + .5) / sy))) continue;
+            const QRgb pixel = row[x];
+            const qreal luminance = .2126 * qRed(pixel) + .7152 * qGreen(pixel) + .0722 * qBlue(pixel);
+            const qreal reflected = 48.0 * (1.0 - std::exp(-luminance / 100.0));
+            const qreal gain = luminance > 0 ? reflected / luminance : 0;
+            row[x] = qRgba(qRound(qRed(pixel) * gain), qRound(qGreen(pixel) * gain),
+                          qRound(qBlue(pixel) * gain), qAlpha(pixel));
+        }
+    }
+    return result;
+}
+
+inline void paintCabinet(QPainter &painter, const QImage &cabinet, const Layout &l)
+{
+    painter.setRenderHint(QPainter::SmoothPixmapTransform, true);
+    painter.drawImage(l.cabinet, cabinet);
+}
+
+inline void paintVideo(QPainter &painter, const QImage &frame, const QRect &source,
+                       const QImage &cabinet, const Layout &l, bool smooth)
+{
+    painter.save();
+    painter.setClipPath(aperture(l), Qt::IntersectClip);
+    // Restore the glass before every frame (including partial/double-buffered
+    // updates), so moving text cannot accumulate light or leave a black patch.
+    paintCabinet(painter, cabinet, l);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform, smooth);
+    // Phosphor emission adds light to the reflected glass. Black is transparent
+    // to the surface; reserve a little headroom for the ambient reflection.
+    // Core video is 0x00RRGGBB; Plus also ignores its unset alpha bytes.
+    painter.setCompositionMode(QPainter::CompositionMode_Plus);
+    painter.setOpacity(.90);
+    painter.drawImage(l.video, frame, QRectF(source));
+    painter.restore();
+}
+
+// Front-panel indicators: 48 x 48 straight-alpha patches measured in master
+// pixels (assets/front/leds/placement.json). Index 0 power, 1 left floppy
+// bay, 2 right floppy bay. The HDD LED (bit 3) is a separate fitting.
+enum Led { PowerLed, DriveALed, DriveBLed, LedCount };
+constexpr int HddLed = 3;
+
+// Machine configuration as seen from the front (assets/front/configurations.json).
+//   DD:   floppy A left, floppy B right    SD: blank left, floppy A right
+//   HD20: hard disk left, floppy A right
+// The monitor badge reads PC-CM (colour) or PC-MM (monochrome).
+enum LeftBay { BayFloppy, BayBlank, BayBlankSticker, BayHdd, LeftBayCount };
+
+// The PC1640's monitors. Unlike the PC1512's pair, the choice is hardware:
+// it sets the video adapter's switches and takes effect on a restart.
+enum Screen1640 { ScreenMD, ScreenCD, ScreenECD, Screen1640Count };
+
+struct Front {
+    LeftBay left = BayFloppy;
+    bool    mono = false;   // PC1512 only: PC-MM instead of PC-CM
+    bool    pc1640 = false; // the emulated machine: PC1512 (master artwork) or PC1640
+    Screen1640 screen = ScreenECD; // PC1640 only
+    bool operator==(const Front &o) const
+    { return left == o.left && mono == o.mono && pc1640 == o.pc1640 && screen == o.screen; }
+    bool operator!=(const Front &o) const { return !(*this == o); }
+    // Logical floppy drive (0 = A:, 1 = B:) shown in the right-hand bay.
+    int rightDrive() const { return left == BayFloppy ? 1 : 0; }
+};
+
+// Static configuration artwork; optional. Bays/badges are composed into the
+// cabinet once per configuration, the HDD LED is drawn like the others.
+struct Fittings {
+    QImage bay[LeftBayCount]; // [BayFloppy] stays null: the drive faces draw it
+    QImage model[3];          // DD, SD, HD20 suffix
+    QImage monitor[2];        // CM, MM first letter
+    QImage hddOff, hddOn;
+    QImage system1640;        // "1640" numerals over the master's "1512"; optional
+    QImage monitor1640[Screen1640Count]; // MD, CD, ECD lettering; optional
+    bool valid() const
+    {
+        for (int i = BayBlank; i < LeftBayCount; ++i)
+            if (bay[i].isNull()) return false;
+        for (const auto &image : model)
+            if (image.isNull()) return false;
+        return !monitor[0].isNull() && !monitor[1].isNull() && !hddOff.isNull() && !hddOn.isNull();
+    }
+};
+
+inline Fittings loadFittings(const QString &drivesDir, const QString &badgesDir, const QString &ledsDir)
+{
+    auto load = [](const QString &path) {
+        return QImage(path).convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    };
+    Fittings f;
+    f.bay[BayBlank]        = load(drivesDir + "/bay-left-blank.png");
+    f.bay[BayBlankSticker] = load(drivesDir + "/bay-left-blank-sticker.png");
+    f.bay[BayHdd]          = load(drivesDir + "/bay-left-hdd.png");
+    f.model[0]             = load(badgesDir + "/model-dd.png");
+    f.model[1]             = load(badgesDir + "/model-sd.png");
+    f.model[2]             = load(badgesDir + "/model-hd20.png");
+    f.monitor[0]           = load(badgesDir + "/monitor-cm.png");
+    f.monitor[1]           = load(badgesDir + "/monitor-mm.png");
+    f.hddOff               = load(ledsDir + "/hdd-off.png");
+    f.hddOn                = load(ledsDir + "/hdd-on.png");
+    f.system1640           = load(badgesDir + "/system-1640.png");
+    f.monitor1640[ScreenMD]  = load(badgesDir + "/monitor-md.png");
+    f.monitor1640[ScreenCD]  = load(badgesDir + "/monitor-cd.png");
+    f.monitor1640[ScreenECD] = load(badgesDir + "/monitor-ecd.png");
+    return f;
+}
+
+// Master-pixel rectangles of the configurable parts.
+inline QRectF masterBay(int bay) { return QRectF(bay ? 632 : 174, 1011, 450, 180); }
+inline QRectF masterModelBadge() { return QRectF(870, 1164, 216, 76); }
+inline QRectF masterMonitorBadge() { return QRectF(923, 743, 140, 60); }
+inline QRectF masterHddLed() { return QRectF(276, 1061, 48, 40); }
+
+// The cabinet with this configuration's bay module and badges fitted. The
+// master already shows DD and CM, so those need no patch.
+inline QImage composeCabinet(const QImage &base, const Fittings &f, const Front &front)
+{
+    if (base.isNull() || !f.valid()) return base;
+    QImage art = base.copy();
+    QPainter p(&art);
+    p.setRenderHint(QPainter::SmoothPixmapTransform, true);
+    const qreal sx = art.width() / 1254.0, sy = art.height() / 1254.0;
+    auto at = [=](const QRectF &r) { return QRectF(r.x() * sx, r.y() * sy, r.width() * sx, r.height() * sy); };
+    if (front.left != BayFloppy) {
+        p.drawImage(at(masterBay(0)), f.bay[front.left]);
+        p.drawImage(at(masterModelBadge()), f.model[front.left == BayHdd ? 2 : 1]);
+    }
+    // The number overlay is opaque over the numerals only, so it follows
+    // (and is independent of) the DD/SD/HD20 suffix patch.
+    if (front.pc1640 && !f.system1640.isNull())
+        p.drawImage(at(masterModelBadge()), f.system1640);
+    if (front.pc1640) {
+        if (!f.monitor1640[front.screen].isNull())
+            p.drawImage(at(masterMonitorBadge()), f.monitor1640[front.screen]);
+    } else if (front.mono)
+        p.drawImage(at(masterMonitorBadge()), f.monitor[1]);
+    return art;
+}
+
+// Right-click targets, from a point in the same coordinates as the layout.
+enum Hotspot { HotNone, HotLeftBay, HotRightBay, HotModelBadge, HotMonitorBadge };
+
+inline Hotspot hotspot(const Layout &l, const QPointF &point)
+{
+    const QPointF m((point.x() - l.cabinet.left()) / l.scale, (point.y() - l.cabinet.top()) / l.scale);
+    // The badge patches span the whole "PC 1512 DD" / "PC-CM" lettering. The
+    // bay patches reach below the drive housings into the badge strip.
+    if (masterModelBadge().contains(m)) return HotModelBadge;
+    if (masterMonitorBadge().contains(m)) return HotMonitorBadge;
+    if (masterBay(0).adjusted(0, 0, 0, -36).contains(m)) return HotLeftBay;
+    if (masterBay(1).adjusted(0, 0, 0, -36).contains(m)) return HotRightBay;
+    return HotNone;
+}
+
+struct Leds {
+    QImage off[LedCount];
+    QImage on[LedCount];
+    bool valid() const
+    {
+        for (int i = 0; i < LedCount; ++i)
+            if (off[i].isNull() || on[i].isNull()) return false;
+        return true;
+    }
+};
+
+inline Leds loadLeds(const QString &dir)
+{
+    static const char *const names[LedCount] = {"power", "drive-a", "drive-b"};
+    Leds leds;
+    for (int i = 0; i < LedCount; ++i) {
+        leds.off[i].load(dir + "/" + names[i] + "-off.png");
+        leds.on[i].load(dir + "/" + names[i] + "-on.png");
+        leds.off[i] = leds.off[i].convertToFormat(QImage::Format_ARGB32_Premultiplied);
+        leds.on[i]  = leds.on[i].convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    }
+    return leds;
+}
+
+inline QRectF ledRect(const Layout &l, int led)
+{
+    static const QPointF pos[LedCount] = {{208, 960}, {511, 1019}, {969, 1019}};
+    return QRectF(l.cabinet.left() + pos[led].x() * l.scale, l.cabinet.top() + pos[led].y() * l.scale,
+                  48 * l.scale, 48 * l.scale);
+}
+
+// Floppy drive faces: 450 x 180 straight-alpha patches measured in master
+// pixels (assets/front/drives/placement.json). Open = latch up, no disk;
+// closed = latch down with a coloured system-disk edge in the slot.
+enum DriveFace { DriveOpen, DiskBlack, DiskYellow, DiskGreen, DiskBlue, DiskRed, DiskPurple, DriveFaceCount };
+
+struct Drives {
+    QImage face[2][DriveFaceCount];
+    bool valid() const
+    {
+        for (const auto &drive : face)
+            for (const auto &image : drive)
+                if (image.isNull()) return false;
+        return true;
+    }
+};
+
+inline Drives loadDrives(const QString &dir)
+{
+    static const char *const names[DriveFaceCount] = {"open-empty", "closed-black", "closed-yellow",
+                                                      "closed-green", "closed-blue", "closed-red", "closed-purple"};
+    Drives drives;
+    for (int d = 0; d < 2; ++d) {
+        const QString prefix = QFileInfo::exists(dir + "/drive-open-empty.png")
+                                   ? dir + "/drive-"
+                                   : dir + (d ? "/drive-b-" : "/drive-a-");
+        const QImage mechanism = QImage(prefix + "closed-mechanism.png")
+                                     .convertToFormat(QImage::Format_ARGB32_Premultiplied);
+        for (int f = 0; f < DriveFaceCount; ++f) {
+            drives.face[d][f].load(prefix + names[f] + ".png");
+            drives.face[d][f] = drives.face[d][f].convertToFormat(QImage::Format_ARGB32_Premultiplied);
+            // New artwork shares one closed mechanism across disk-only
+            // colour layers. Older complete-face sets remain supported.
+            if (f != DriveOpen && !mechanism.isNull() && !drives.face[d][f].isNull()) {
+                QImage combined = mechanism.copy();
+                QPainter painter(&combined);
+                painter.drawImage(0, 0, drives.face[d][f]);
+                painter.end();
+                drives.face[d][f] = combined;
+            }
+        }
+    }
+    return drives;
+}
+
+inline QRectF driveRect(const Layout &l, int drive)
+{
+    static const QPointF pos[2] = {{174, 1011}, {632, 1011}};
+    return QRectF(l.cabinet.left() + pos[drive].x() * l.scale, l.cabinet.top() + pos[drive].y() * l.scale,
+                  450 * l.scale, 180 * l.scale);
+}
+
+// Guess which Amstrad system disk an image is from its file name alone; the
+// colours follow the original PC1512 set. Anything unrecognised is black.
+//   Disc 1 MS-DOS: red   Disc 2 GEM initialisation: blue
+//   Disc 3 GEM Desktop (GEM2) / Locomotive BASIC 2: green   Disc 4 DOS Plus: yellow
+//   Disc 5 hard disc utilities: purple. It came with hard disc machines only,
+//   so without one (hardDisk false) it is an ordinary black disk.
+inline DriveFace diskColour(const QString &path, bool hardDisk = true)
+{
+    QString name = path;
+    name.remove(QRegularExpression(QStringLiteral("^[a-z]+://"), QRegularExpression::CaseInsensitiveOption));
+    name = QFileInfo(name).completeBaseName();
+    auto has = [&](const char *pattern) {
+        return QRegularExpression(QString::fromLatin1(pattern), QRegularExpression::CaseInsensitiveOption)
+            .match(name).hasMatch();
+    };
+    // Product names first: they are explicit, unlike disc numbers.
+    if (has(R"(hd[\s_.-]*util|hard[\s_.-]*dis[ck])"))                    return hardDisk ? DiskPurple : DiskBlack;
+    if (has(R"(dos[\s_.-]*plus)"))                                      return DiskYellow;
+    if (has(R"(basic|locomotive|desk[\s_.-]*top|gem[\s_.-]*(2|3|ii|iii|desk)(?!\d))")) return DiskGreen;
+    if (has(R"(gem)"))                                                  return DiskBlue;
+    if (has(R"(ms[\s_.-]*dos|(^|[^a-z])dos([^a-z]|$))"))               return DiskRed;
+    // Fall back on "Disc N" / "Disk N" / "A1".."A4" set numbering.
+    const auto number = QRegularExpression(QStringLiteral(R"((?:dis[ck]|(?:^|[^a-z])a)[\s_.-]*([1-5])(?!\d))"),
+                                           QRegularExpression::CaseInsensitiveOption).match(name);
+    if (number.hasMatch()) {
+        static const DriveFace bySet[] = {DiskRed, DiskBlue, DiskGreen, DiskYellow, DiskPurple};
+        const DriveFace face = bySet[number.captured(1).toInt() - 1];
+        return face == DiskPurple && !hardDisk ? DiskBlack : face;
+    }
+    return DiskBlack;
+}
+
+// Front-panel state packed into one word, so a change is a single compare:
+// bits 0-3 LEDs (bit i = indicator i lit, 3 = HDD), bits 4-6 the left bay's
+// floppy face, 8-10 the right bay's. Faces are per bay, not per drive letter.
+inline unsigned panelState(unsigned leds, DriveFace left, DriveFace right)
+{
+    return leds | unsigned(left) << 4 | unsigned(right) << 8;
+}
+
+inline QRectF hddLedRect(const Layout &l)
+{
+    const QRectF m = masterHddLed();
+    return QRectF(l.cabinet.left() + m.x() * l.scale, l.cabinet.top() + m.y() * l.scale,
+                  m.width() * l.scale, m.height() * l.scale);
+}
+
+// Device-pixel region covering every indicator and drive face, padded for
+// smooth sampling. The floppy and HDD LED patches lie inside the bays.
+inline QRegion panelRegion(const Layout &l, bool drives)
+{
+    QRegion region;
+    for (int i = 0; i < LedCount; ++i)
+        region |= ledRect(l, i).toAlignedRect().adjusted(-1, -1, 1, 1);
+    region |= hddLedRect(l).toAlignedRect().adjusted(-1, -1, 1, 1);
+    if (drives)
+        for (int d = 0; d < 2; ++d)
+            region |= driveRect(l, d).toAlignedRect().adjusted(-1, -1, 1, 1);
+    return region;
+}
+
+// The patches have feathered edges, so the (configured) cabinet is restored
+// beneath them first; repeated blending would leave traces. Order: cabinet,
+// drives, LEDs. Only devices fitted in the left bay get its LED drawn.
+inline void paintPanel(QPainter &painter, const QImage &cabinet, const Leds *leds,
+                       const Drives *drives, const Fittings *fittings, const Front &front,
+                       const Layout &l, unsigned state)
+{
+    const bool leftFloppy = front.left == BayFloppy;
+    painter.save();
+    painter.setClipRegion(panelRegion(l, drives), Qt::IntersectClip);
+    paintCabinet(painter, cabinet, l);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform, true);
+    if (drives)
+        for (int d = leftFloppy ? 0 : 1; d < 2; ++d)
+            painter.drawImage(driveRect(l, d), drives->face[d][(state >> (4 + 4 * d)) & 7]);
+    if (leds)
+        for (int i = 0; i < LedCount; ++i)
+            if (i != DriveALed || leftFloppy)
+                painter.drawImage(ledRect(l, i), (state >> i) & 1 ? leds->on[i] : leds->off[i]);
+    if (fittings && front.left == BayHdd)
+        painter.drawImage(hddLedRect(l), (state >> HddLed) & 1 ? fittings->hddOn : fittings->hddOff);
+    painter.restore();
+}
+
+inline void testPattern(QImage &frame, const QRect &source)
+{
+    // Write through scanLine: the real producer buffer has a 2048-pixel pitch.
+    constexpr QRgb bars[] = {0x00ff0000, 0x0000ff00, 0x000000ff, 0x00ffffff,
+                             0x0000ffff, 0x00ff00ff, 0x00ffff00, 0x00404040};
+    for (int y = source.top(); y <= source.bottom(); ++y) {
+        auto *row = reinterpret_cast<QRgb *>(frame.scanLine(y));
+        for (int x = source.left(); x <= source.right(); ++x)
+            row[x] = bars[std::min(7, (x - source.x()) * 8 / source.width())];
+    }
+}
+}
+#endif
